        "2xl": {
          "enum": [
            "column",
            "columnReverse",
            "row",
            "rowReverse"
          ]
        }
      }
    },
    "flexWrap": {
      "type": "object",
      "description": "Wrapping of items, per breakpoint.",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "default": {
          "enum": [
            "wrap",
            "wrapReverse",
            "nowrap"
          ]
        },
        "sm": {
          "enum": [
            "wrap",
            "wrapReverse",
            "nowrap"
          ]
