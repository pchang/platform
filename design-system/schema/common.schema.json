        "sm": {
          "enum": [
            "horizontal",
            "vertical"
          ]
        },
        "md": {
          "enum": [
            "horizontal",
            "vertical"
          ]
        },
        "lg": {
          "enum": [
            "horizontal",
            "vertical"
          ]
        },
        "xl": {
          "enum": [
            "horizontal",
            "vertical"
          ]
        },
        "2xl": {
          "enum": [
            "horizontal",
            "vertical"
          ]
        }
      }
