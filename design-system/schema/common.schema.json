    "galleryMinWidths": {
      "type": "object",
      "description": "Minimum item width, per breakpoint. A curated set of sizes, not free values (rule 2).",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "default": {
          "enum": [
            "100%",
            "12rem",
            "16rem",
            "20rem",
            "24rem"
          ]
