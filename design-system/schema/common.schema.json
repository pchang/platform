    "flexItemFlex": {
      "type": "object",
      "description": "How much the item grows, per breakpoint.",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "default": {
          "enum": [
            "flexDefault",
            "flexNone",
            "flex_1",
            "flex_2",
            "flex_3",
            "flex_4"
          ]
        },
        "sm": {
          "enum": [
            "flexDefault",
            "flexNone",
            "flex_1",
            "flex_2",
            "flex_3",
            "flex_4"
          ]
        },
        "md": {
          "enum": [
            "flexDefault",
            "flexNone",
            "flex_1",
            "flex_2",
            "flex_3",
            "flex_4"
          ]
