          "enum": [
            "alignItemsFlexStart",
            "alignItemsFlexEnd",
            "alignItemsCenter",
            "alignItemsStretch",
            "alignItemsBaseline"
          ]
        }
      }
    },
    "flexJustifyContent": {
      "type": "object",
      "description": "Main-axis distribution, per breakpoint.",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "default": {
          "enum": [
            "justifyContentFlexStart",
            "justifyContentFlexEnd",
            "justifyContentCenter",
            "justifyContentSpaceBetween",
            "justifyContentSpaceAround",
            "justifyContentSpaceEvenly"
          ]
        },
        "sm": {
          "enum": [
            "justifyContentFlexStart",
            "justifyContentFlexEnd",
            "justifyContentCenter",
            "justifyContentSpaceBetween",
            "justifyContentSpaceAround",
            "justifyContentSpaceEvenly"
          ]
        },
        "md": {
          "enum": [
            "justifyContentFlexStart",
            "justifyContentFlexEnd",
            "justifyContentCenter",
            "justifyContentSpaceBetween",
            "justifyContentSpaceAround",
            "justifyContentSpaceEvenly"
          ]
        },
        "lg": {
          "enum": [
            "justifyContentFlexStart",
            "justifyContentFlexEnd",
            "justifyContentCenter",
            "justifyContentSpaceBetween",
