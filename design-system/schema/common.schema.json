{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Shared definitions for the design system catalog",
  "$defs": {
    "breakpoint": {
      "enum": [
        "default",
        "sm",
        "md",
        "lg",
        "xl",
        "2xl"
      ],
      "description": "PatternFly breakpoints (design system spec, section 4)."
    },
    "flexGap": {
      "type": "object",
      "description": "Gap between items, per breakpoint.",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "default": {
          "enum": [
            "gap",
            "gapNone",
            "gapXs",
            "gapSm",
            "gapMd",
            "gapLg",
            "gapXl",
            "gap2xl",
            "gap3xl",
            "gap4xl"
          ]
        },
        "sm": {
          "enum": [
            "gap",
            "gapNone",
            "gapXs",
            "gapSm",
            "gapMd",
            "gapLg",
            "gapXl",
            "gap2xl",
            "gap3xl",
            "gap4xl"
          ]
        },
        "md": {
          "enum": [
            "gap",
            "gapNone",
            "gapXs",
            "gapSm",
            "gapMd",
            "gapLg",
            "gapXl",
            "gap2xl",
            "gap3xl",
            "gap4xl"
          ]
        },
        "lg": {
          "enum": [
            "gap",
            "gapNone",
            "gapXs",
            "gapSm",
            "gapMd",
            "gapLg",
            "gapXl",
            "gap2xl",
            "gap3xl",
            "gap4xl"
          ]
        },
        "xl": {
          "enum": [
            "gap",
            "gapNone",
            "gapXs",
            "gapSm",
            "gapMd",
            "gapLg",
            "gapXl",
            "gap2xl",
            "gap3xl",
            "gap4xl"
          ]
        },
        "2xl": {
          "enum": [
            "gap",
            "gapNone",
            "gapXs",
            "gapSm",
            "gapMd",
            "gapLg",
            "gapXl",
            "gap2xl",
            "gap3xl",
            "gap4xl"
          ]
        }
      }
    },
    "flexDirection": {
      "type": "object",
      "description": "Direction of items, per breakpoint.",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "default": {
          "enum": [
            "column",
            "columnReverse",
            "row",
            "rowReverse"
          ]
        },
        "sm": {
          "enum": [
            "column",
            "columnReverse",
            "row",
            "rowReverse"
          ]
