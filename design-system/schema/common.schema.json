        "2xl": {
          "enum": [
            "wrap",
            "wrapReverse",
            "nowrap"
          ]
        }
      }
    },
    "flexAlignItems": {
      "type": "object",
      "description": "Cross-axis alignment, per breakpoint.",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "default": {
          "enum": [
            "alignItemsFlexStart",
            "alignItemsFlexEnd",
            "alignItemsCenter",
            "alignItemsStretch",
            "alignItemsBaseline"
