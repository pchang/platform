{
  "$schema": "./schema/tokens.schema.json",
  "version": "0.1",
  "source": "@patternfly/react-tokens 6.7.0. Names only: values, and light and dark modes, come from PatternFly.",
  "groups": [
    {
      "id": "text",
      "tokens": [
        {
          "name": "--pf-t--global--text--color--regular",
          "use": "Body and heading text"
        },
        {
          "name": "--pf-t--global--text--color--subtle",
          "use": "Secondary text, such as descriptions and metadata"
        },
        {
          "name": "--pf-t--global--text--color--disabled",
          "use": "Text of disabled controls"
        },
        {
          "name": "--pf-t--global--text--color--link--default",
          "use": "Links"
        },
        {
          "name": "--pf-t--global--text--color--status--success--default",
          "use": "Text that reports success"
        },
        {
          "name": "--pf-t--global--text--color--status--warning--default",
          "use": "Text that reports a warning"
        },
        {
          "name": "--pf-t--global--text--color--status--danger--default",
          "use": "Text that reports an error or danger"
        },
        {
          "name": "--pf-t--global--text--color--status--info--default",
          "use": "Text that reports information"
        }
      ]
    },
    {
      "id": "background",
      "tokens": [
        {
          "name": "--pf-t--global--background--color--primary--default",
          "use": "Main surfaces, such as cards and the main area"
        },
        {
          "name": "--pf-t--global--background--color--secondary--default",
          "use": "Page background behind surfaces"
        }
      ]
    },
    {
      "id": "border",
      "tokens": [
        {
          "name": "--pf-t--global--border--color--default",
          "use": "Default borders and dividers"
        },
        {
          "name": "--pf-t--global--border--radius--small",
          "use": "Small radius, such as labels and inputs"
        },
        {
          "name": "--pf-t--global--border--radius--medium",
          "use": "Medium radius, such as cards"
        }
      ]
    },
    {
      "id": "spacing",
      "tokens": [
        {
          "name": "--pf-t--global--spacer--xs",
          "use": "Extra-small space"
        },
        {
          "name": "--pf-t--global--spacer--sm",
          "use": "Small space"
        },
        {
          "name": "--pf-t--global--spacer--md",
          "use": "Medium space, the default gap"
        },
        {
          "name": "--pf-t--global--spacer--lg",
          "use": "Large space"
        },
        {
          "name": "--pf-t--global--spacer--xl",
          "use": "Extra-large space"
        }
      ]
    },
    {
      "id": "typography",
      "tokens": [
        {
          "name": "--pf-t--global--font--family--body",
          "use": "Body text"
        },
        {
          "name": "--pf-t--global--font--family--heading",
          "use": "Headings and the text logo"
        },
        {
          "name": "--pf-t--global--font--size--body--default",
          "use": "Body text size"
        },
        {
          "name": "--pf-t--global--font--size--sm",
          "use": "Small text"
        },
        {
          "name": "--pf-t--global--font--size--heading--h3",
          "use": "Text logo and third-level headings"
        },
        {
          "name": "--pf-t--global--font--weight--body--default",
          "use": "Body text weight"
        },
        {
          "name": "--pf-t--global--font--weight--heading--default",
          "use": "Heading and text logo weight"
        }
      ]
    }
  ]
}
