@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix p:       <https://w3id.org/lsh-platform/platform#> .
@prefix ls:      <https://w3id.org/lsh-platform/life-sciences#> .
@prefix lst:     <https://w3id.org/lsh-platform/life-sciences/term#> .
@prefix lsh:     <https://w3id.org/lsh-platform/life-sciences/shape#> .
@prefix ncit:    <http://purl.obolibrary.org/obo/NCIT_> .
<https://w3id.org/lsh-platform/platform> a owl:Ontology ;
  dcterms:title "LS&H platform vocabulary" ;
  rdfs:comment "Domain-free vocabulary for what SHACL does not describe: object types, state dimensions, methods, inputs, effects, business rules and roles (platform spec section 3.1)." ;
  owl:versionInfo "0.3.0" ;
  owl:versionIRI <https://w3id.org/lsh-platform/platform/0.3.0> ;
  dcterms:created "2026-11-08"^^xsd:date .

p:Domain a rdfs:Class ;
  rdfs:label "Domain" ;
  rdfs:comment "A business domain that groups object types." .

p:ObjectType a rdfs:Class ;
  rdfs:label "Object Type" ;
  rdfs:comment "A class whose instances are objects people and agents find and act on." ;
  rdfs:subClassOf rdfs:Class .

p:StateDimension a rdfs:Class ;
  rdfs:label "State Dimension" ;
  rdfs:comment "A property that places an object in one dimension of its state space. Its values come from a SKOS concept scheme." ;
  rdfs:subClassOf rdf:Property .

p:Relationship a rdfs:Class ;
  rdfs:label "Relationship" ;
  rdfs:comment "A typed link between objects." ;
  rdfs:subClassOf rdf:Property .

p:Method a rdfs:Class ;
  rdfs:label "Method" ;
  rdfs:comment "An operation an object type supports: what it needs, what must be true before it runs, and what it changes." .

p:Input a rdfs:Class ;
  rdfs:label "input" ;
  rdfs:comment "Something a method needs from the person or agent running it." .

p:Effect a rdfs:Class ;
  rdfs:label "effect" ;
  rdfs:comment "A change a method makes when it commits." .

p:StateChange a rdfs:Class ;
  rdfs:label "state change" ;
  rdfs:comment "An effect that moves an object, or objects related to it, to a new value in one state dimension." ;
  rdfs:subClassOf p:Effect .

p:Creation a rdfs:Class ;
  rdfs:label "creation" ;
  rdfs:comment "An effect that creates a new object, linked to the object the method ran on." ;
  rdfs:subClassOf p:Effect .

p:Link a rdfs:Class ;
  rdfs:label "link" ;
  rdfs:comment "An effect that links the object to an object given as an input." ;
  rdfs:subClassOf p:Effect .

p:DescribedEffect a rdfs:Class ;
  rdfs:label "described effect" ;
  rdfs:comment "An effect not yet declarative. Its description says what the gateway does." ;
  rdfs:subClassOf p:Effect .

p:BusinessRule a rdfs:Class ;
  rdfs:label "business rule" ;
  rdfs:comment "A rule of the business context. Rules are data: their parameters live here, and shapes or the gateway enforce them." .

p:Parameter a rdfs:Class ;
  rdfs:label "parameter" ;
  rdfs:comment "A value a business rule depends on, such as a number of days." .

p:Role a rdfs:Class ;
  rdfs:label "Role" ;
  rdfs:comment "A persona or agent role: the methods it may run and what it may not read." .

p:Commit a rdfs:Class ;
  rdfs:label "commit" ;
  rdfs:comment "One committed method run: who ran which method on which object, when, with which inputs, and every value it changed. A PROV-O activity." ;
  rdfs:subClassOf prov:Activity .

p:ValueChange a rdfs:Class ;
  rdfs:label "value change" ;
  rdfs:comment "One value a commit changed, from its old value to its new one." .

p:InputValue a rdfs:Class ;
  rdfs:label "input value" ;
  rdfs:comment "The value given for one input of a commit." .

p:Read a rdfs:Class ;
  rdfs:label "read" ;
  rdfs:comment "A read of an object that holds personal data, recorded in the audit trail. A PROV-O activity." ;
  rdfs:subClassOf prov:Activity .

p:Archetype a rdfs:Class ;
  rdfs:label "interaction archetype" ;
  rdfs:comment "How a person runs a method: one of a closed set, each with one pattern in the design system (platform spec 5.4)." .

p:Signature a rdfs:Class ;
  rdfs:label "signature" ;
  rdfs:comment "An electronic signature bound to a commit: who signed, when, and what the signature means (platform spec 3.4)." .

p:Person a rdfs:Class ;
  rdfs:label "person" ;
  rdfs:comment "Someone who runs methods, signs, reviews or approves. Identities come from the platform's identity provider." .

p:Analysis a rdfs:Class ;
  rdfs:label "analysis" ;
  rdfs:comment "Background work the platform computes, declared with its parameters. The platform implements each kind of analysis once, for every domain (platform spec 3.4, Background runs)." ;
  rdfs:subClassOf p:Effect .

p:DisproportionalityAnalysis a rdfs:Class ;
  rdfs:label "disproportionality analysis" ;
  rdfs:comment "Counts objects of a type by exposure and outcome. For the target exposure, creates an object for each outcome that is reported disproportionately often compared with every other exposure: at least the minimum count, a proportional reporting ratio of at least the minimum ratio, and a chi-squared statistic with Yates' correction of at least the minimum. An outcome that already has such an object for the target is not created again." ;
  rdfs:subClassOf p:Analysis .

p:Metric a rdfs:Class ;
  rdfs:label "Metric" ;
  rdfs:comment "A count of the objects of one type in given states, with the thresholds at which its health turns from on track to watch and at risk (platform spec 5.1, Home)." .

p:watches a rdf:Property ;
  rdfs:label "watches" ;
  rdfs:comment "A metric the role watches on Home." ;
  rdfs:domain p:Role ;
  rdfs:range p:Metric .

p:metricOf a rdf:Property ;
  rdfs:label "metric of" ;
  rdfs:comment "The object type a metric counts." ;
  rdfs:domain p:Metric ;
  rdfs:range p:ObjectType .

p:inState a rdf:Property ;
  rdfs:label "in state" ;
  rdfs:comment "A state value the counted objects have. Values of one dimension are alternatives; dimensions together must all hold." ;
  rdfs:domain p:Metric .

p:pastDue a rdf:Property ;
  rdfs:label "past due" ;
  rdfs:comment "A date property: only objects whose date is before today are counted." ;
  rdfs:domain p:Metric .

p:watchAt a rdf:Property ;
  rdfs:label "watch at" ;
  rdfs:comment "The count at which the metric's health turns to watch: at or above it, or at or below it when more is better." ;
  rdfs:domain p:Metric .

p:riskAt a rdf:Property ;
  rdfs:label "at risk at" ;
  rdfs:comment "The count at which the metric's health turns to at risk." ;
  rdfs:domain p:Metric .

p:moreIsBetter a rdf:Property ;
  rdfs:label "more is better" ;
  rdfs:comment "True when a higher count is healthier, so the thresholds are minimums." ;
  rdfs:domain p:Metric .

p:PlatformMethod a rdfs:Class ;
  rdfs:label "platform method" ;
  rdfs:comment "A method every object type has, declared once here rather than in each domain, such as Create and Edit (platform spec 5.3, Creating and editing objects)." .

p:Create a p:PlatformMethod ;
  rdfs:label "Create" ;
  rdfs:comment "Creates an object of a type, from the properties its title needs, the object it belongs to and its classifying states; every lifecycle starts at its first value." .

p:Edit a p:PlatformMethod ;
  rdfs:label "Edit" ;
  rdfs:comment "Changes an object's properties, one-valued links and classifying states. Never its lifecycle states, the object it belongs to, or an object a business rule freezes." .

p:mayCreate a rdf:Property ;
  rdfs:label "may create" ;
  rdfs:comment "An object type the role may create." ;
  rdfs:domain p:Role ;
  rdfs:range p:ObjectType .

p:mayEdit a rdf:Property ;
  rdfs:label "may edit" ;
  rdfs:comment "An object type whose objects the role may edit." ;
  rdfs:domain p:Role ;
  rdfs:range p:ObjectType .

p:onlyThroughMethods a rdf:Property ;
  rdfs:label "only through methods" ;
  rdfs:comment "True when a type's objects come into being only through the methods and models that create them, so they are never created or edited directly." ;
  rdfs:domain p:ObjectType .

p:chosenOnCreate a rdf:Property ;
  rdfs:label "chosen on create" ;
  rdfs:comment "True when a state dimension classifies its objects: chosen when an object is created and corrected by editing, never moved by a method. Every other dimension is a lifecycle that starts at its first value." ;
  rdfs:domain p:StateDimension .

p:Comparison a rdfs:Class ;
  rdfs:label "comparison" ;
  rdfs:comment "What a set method shows side by side: rows read from each object along a path, keyed by a state dimension, each cell the row object's title and its status (platform spec 5.4, Acting on a set)." .

p:onSet a rdf:Property ;
  rdfs:label "on a set" ;
  rdfs:comment "True when a method takes the selection as its one object: it runs once for the set and commits once, on the chosen object (platform spec 5.4, Acting on a set)." ;
  rdfs:domain p:Method .

p:commitLabel a rdf:Property ;
  rdfs:label "commit label" ;
  rdfs:comment "The word that names a method's commit button, such as Select. A set method that decides among its set follows it with the chosen object's identifier, such as Select SSC-3 (platform spec 5.4, Acting on a set). Without one, the button carries the method's name." ;
  rdfs:domain p:Method .

p:minObjects a rdf:Property ;
  rdfs:label "minimum objects" ;
  rdfs:comment "The fewest objects a set method takes." ;
  rdfs:domain p:Method .

p:maxObjects a rdf:Property ;
  rdfs:label "maximum objects" ;
  rdfs:comment "The most objects a set method takes." ;
  rdfs:domain p:Method .

p:sameAlong a rdf:Property ;
  rdfs:label "same along" ;
  rdfs:comment "A relationship every object of a set must share the same value along, such as the same parent." ;
  rdfs:domain p:Method .

p:amongSet a rdf:Property ;
  rdfs:label "among the set" ;
  rdfs:comment "True when an object input of a set method chooses one of the set; the method commits on the chosen one." ;
  rdfs:domain p:Input .

p:onOthers a rdf:Property ;
  rdfs:label "on the others" ;
  rdfs:comment "True when a state change of a set method applies to the set's other objects, not the chosen one." ;
  rdfs:domain p:StateChange .

p:alsoLinkedBy a rdf:Property ;
  rdfs:label "also linked by" ;
  rdfs:comment "A second relationship a created object is linked by, to the value the method's object has along p:alsoLinkedTo." ;
  rdfs:domain p:Creation .

p:alsoLinkedTo a rdf:Property ;
  rdfs:label "also linked to" ;
  rdfs:comment "The relationship of the method's object whose value a created object is also linked to." ;
  rdfs:domain p:Creation .

p:comparison a rdf:Property ;
  rdfs:label "comparison" ;
  rdfs:comment "The comparison a set method shows." ;
  rdfs:domain p:Method ;
  rdfs:range p:Comparison .

p:rowPath a rdf:Property ;
  rdfs:label "row path" ;
  rdfs:comment "A SPARQL property path from each compared object to its row objects." ;
  rdfs:domain p:Comparison .

p:rowKey a rdf:Property ;
  rdfs:label "row key" ;
  rdfs:comment "The state dimension of the row objects that names each row, in its values' order." ;
  rdfs:domain p:Comparison .

p:rowWhen a rdf:Property ;
  rdfs:label "row when" ;
  rdfs:comment "A state value a row object must have to be compared, such as current." ;
  rdfs:domain p:Comparison .

p:rowStatus a rdf:Property ;
  rdfs:label "row status" ;
  rdfs:comment "The state dimension of a row object shown as its cell's status; a value with an urgency is marked." ;
  rdfs:domain p:Comparison .

p:ModelRun a rdfs:Class ;
  rdfs:label "model run" ;
  rdfs:comment "Runs a model the gateway connects, named by p:model, on the method's object as it stands when the run starts, with the person's inputs. The model reads the object and what it links to, and returns objects to create, values to set and a message; the gateway validates and commits them as the run's result (platform spec 3.4, Model runs)." ;
  rdfs:subClassOf p:Analysis .

p:model a rdf:Property ;
  rdfs:label "model" ;
  rdfs:comment "The name of the connected model a model run runs." ;
  rdfs:domain p:ModelRun .

p:manyValues a rdf:Property ;
  rdfs:label "many values" ;
  rdfs:comment "True when a choice input takes any number of values from its scheme, sent separated by spaces (platform spec 3.1, Input)." ;
  rdfs:domain p:Input .

p:Drafting a rdfs:Class ;
  rdfs:label "drafting" ;
  rdfs:comment "An effect whose value a connected model drafts and a person accepts: the property the accepted text fills, the model's instructions, and the linked objects it may draw on (platform spec 3.4, Generated drafts)." ;
  rdfs:subClassOf p:Effect .

p:Draft a rdfs:Class ;
  rdfs:label "draft" ;
  rdfs:comment "Text a connected model wrote for a drafting effect, recorded with who asked, the model, fingerprints of its instructions and records, and whether a person accepted or discarded it. A PROV-O entity." ;
  rdfs:subClassOf prov:Entity .

p:Run a rdfs:Class ;
  rdfs:label "run" ;
  rdfs:comment "A background run of a method: started by a commit and finished by a worker, which commits the result on behalf of the person who started it. A PROV-O activity." ;
  rdfs:subClassOf prov:Activity .

p:Notification a rdfs:Class ;
  rdfs:label "notification" ;
  rdfs:comment "Something the platform tells one person, such as that a run they started has ended. Only its recipient sees it." .

p:inDomain a rdf:Property ;
  rdfs:label "in domain" ;
  rdfs:comment "The domain an object type belongs to." ;
  rdfs:domain p:ObjectType ;
  rdfs:range p:Domain .

p:dimensionOf a rdf:Property ;
  rdfs:label "dimension of" ;
  rdfs:comment "The object type a state dimension belongs to." ;
  rdfs:domain p:StateDimension ;
  rdfs:range p:ObjectType .

p:valuesFrom a rdf:Property ;
  rdfs:label "values from" ;
  rdfs:comment "The concept scheme whose concepts are the allowed values." ;
  rdfs:range skos:ConceptScheme .

p:appliesTo a rdf:Property ;
  rdfs:label "applies to" ;
  rdfs:comment "The object type a method runs on." ;
  rdfs:domain p:Method ;
  rdfs:range p:ObjectType .

p:input a rdf:Property ;
  rdfs:label "input" ;
  rdfs:comment "An input the method needs." ;
  rdfs:domain p:Method ;
  rdfs:range p:Input .

p:inputName a rdf:Property ;
  rdfs:label "input name" ;
  rdfs:comment "The input's name, used by agents and APIs." ;
  rdfs:domain p:Input ;
  rdfs:range xsd:string .

p:datatype a rdf:Property ;
  rdfs:label "datatype" ;
  rdfs:comment "The datatype of a literal input." ;
  rdfs:domain p:Input .

p:perObject a rdf:Property ;
  rdfs:label "per object" ;
  rdfs:comment "True when the input is about the object it is given for, such as a note or a reason, so a batch asks for it object by object. Otherwise one value holds for every object." ;
  rdfs:domain p:Input ;
  rdfs:range xsd:boolean .

p:objectOf a rdf:Property ;
  rdfs:label "object of" ;
  rdfs:comment "The object type an input must be an instance of." ;
  rdfs:domain p:Input ;
  rdfs:range p:ObjectType .

p:isActor a rdf:Property ;
  rdfs:label "is actor" ;
  rdfs:comment "True when the input is a person, such as a signer, reviewer or approver." ;
  rdfs:domain p:Input ;
  rdfs:range xsd:boolean .

p:choicesAlong a rdf:Property ;
  rdfs:label "choices along" ;
  rdfs:comment "The input must be one of the objects reached from the target along this relationship." ;
  rdfs:domain p:Input ;
  rdfs:range rdf:Property .

p:inputShape a rdf:Property ;
  rdfs:label "input shape" ;
  rdfs:comment "A SHACL shape the input value must conform to." ;
  rdfs:domain p:Input ;
  rdfs:range sh:NodeShape .

p:distinctFrom a rdf:Property ;
  rdfs:label "distinct from" ;
  rdfs:comment "The input must differ from the value of this property on the target." ;
  rdfs:domain p:Input ;
  rdfs:range rdf:Property .

p:precondition a rdf:Property ;
  rdfs:label "precondition" ;
  rdfs:comment "A SHACL shape the target must conform to before the method runs. A method may have several; its messages explain a block." ;
  rdfs:domain p:Method ;
  rdfs:range sh:NodeShape .

p:effect a rdf:Property ;
  rdfs:label "effect" ;
  rdfs:comment "A change the method makes on commit." ;
  rdfs:domain p:Method ;
  rdfs:range p:Effect .

p:dimension a rdf:Property ;
  rdfs:label "dimension" ;
  rdfs:comment "The state dimension a state change sets." ;
  rdfs:domain p:StateChange ;
  rdfs:range p:StateDimension .

p:value a rdf:Property ;
  rdfs:label "value" ;
  rdfs:comment "The value a state change sets." ;
  rdfs:domain p:StateChange ;
  rdfs:range skos:Concept .

p:valueFromInput a rdf:Property ;
  rdfs:label "value from input" ;
  rdfs:comment "The state change takes its value from this input." ;
  rdfs:domain p:StateChange ;
  rdfs:range p:Input .

p:along a rdf:Property ;
  rdfs:label "along" ;
  rdfs:comment "The state change applies to objects reached from the target along this relationship." ;
  rdfs:domain p:StateChange ;
  rdfs:range rdf:Property .

p:alongInverse a rdf:Property ;
  rdfs:label "along inverse" ;
  rdfs:comment "The state change applies to objects that link to the target with this relationship." ;
  rdfs:domain p:StateChange ;
  rdfs:range rdf:Property .

p:whenInput a rdf:Property ;
  rdfs:label "when input" ;
  rdfs:comment "The effect applies only when this input has the value in whenValue." ;
  rdfs:domain p:Effect ;
  rdfs:range p:Input .

p:whenValue a rdf:Property ;
  rdfs:label "when value" ;
  rdfs:comment "The input value that makes a conditional effect apply." ;
  rdfs:domain p:Effect ;
  rdfs:range skos:Concept .

p:createsType a rdf:Property ;
  rdfs:label "creates type" ;
  rdfs:comment "The object type a creation or an analysis makes." ;
  rdfs:domain p:Effect ;
  rdfs:range p:ObjectType .

p:linkedBy a rdf:Property ;
  rdfs:label "linked by" ;
  rdfs:comment "The relationship between the new object and the target, from the new object to the target." ;
  rdfs:domain p:Effect ;
  rdfs:range rdf:Property .

p:initialState a rdf:Property ;
  rdfs:label "initial state" ;
  rdfs:comment "A state value the new object starts in." ;
  rdfs:domain p:Effect ;
  rdfs:range skos:Concept .

p:initialFromInput a rdf:Property ;
  rdfs:label "initial from input" ;
  rdfs:comment "The new object takes a state value from this input." ;
  rdfs:domain p:Creation ;
  rdfs:range p:Input .

p:recordsActorAs a rdf:Property ;
  rdfs:label "records actor as" ;
  rdfs:comment "The person running the method is recorded on the new object with this property." ;
  rdfs:domain p:Creation ;
  rdfs:range rdf:Property .

p:setsDate a rdf:Property ;
  rdfs:label "sets date" ;
  rdfs:comment "A date property set on the new object: the commit date, or with fromDate and plusDays, a date counted from the target's date." ;
  rdfs:domain p:Creation ;
  rdfs:range rdf:Property .

p:fromDate a rdf:Property ;
  rdfs:label "from date" ;
  rdfs:comment "The target's date the new date is counted from." ;
  rdfs:domain p:Creation ;
  rdfs:range rdf:Property .

p:plusDays a rdf:Property ;
  rdfs:label "plus days" ;
  rdfs:comment "The parameter giving the number of days to add." ;
  rdfs:domain p:Creation ;
  rdfs:range p:Parameter .

p:toInput a rdf:Property ;
  rdfs:label "to input" ;
  rdfs:comment "The input a link effect links to." ;
  rdfs:domain p:Link ;
  rdfs:range p:Input .

p:description a rdf:Property ;
  rdfs:label "description" ;
  rdfs:comment "What an effect does, in words: for a described effect, until it is declarative; for an analysis, what the person is told it will do." ;
  rdfs:domain p:Effect ;
  rdfs:range xsd:string .

p:producesDraft a rdf:Property ;
  rdfs:label "produces draft" ;
  rdfs:comment "True when the method's output is a draft until a human accepts it." ;
  rdfs:domain p:Method ;
  rdfs:range xsd:boolean .

p:requiresSignature a rdf:Property ;
  rdfs:label "requires signature" ;
  rdfs:comment "True when committing the method needs an electronic signature bound to the record." ;
  rdfs:domain p:Method ;
  rdfs:range xsd:boolean .

p:governedBy a rdf:Property ;
  rdfs:label "governed by" ;
  rdfs:comment "A business rule the method is subject to." ;
  rdfs:domain p:Method ;
  rdfs:range p:BusinessRule .

p:ruleNumber a rdf:Property ;
  rdfs:label "rule number" ;
  rdfs:comment "The rule's number in its domain spec." ;
  rdfs:domain p:BusinessRule ;
  rdfs:range xsd:integer .

p:parameter a rdf:Property ;
  rdfs:label "parameter" ;
  rdfs:comment "A parameter of the rule." ;
  rdfs:domain p:BusinessRule ;
  rdfs:range p:Parameter .

p:enforcedBy a rdf:Property ;
  rdfs:label "enforced by" ;
  rdfs:comment "A SHACL shape that enforces the rule." ;
  rdfs:domain p:BusinessRule ;
  rdfs:range sh:Shape .

p:hides a rdf:Property ;
  rdfs:label "hides" ;
  rdfs:comment "A property the rule hides from everyone while hiddenWhen holds." ;
  rdfs:domain p:BusinessRule ;
  rdfs:range rdf:Property .

p:hiddenWhen a rdf:Property ;
  rdfs:label "hidden when" ;
  rdfs:comment "A shape: while the object conforms, the hidden property is not shown." ;
  rdfs:domain p:BusinessRule ;
  rdfs:range sh:NodeShape .

p:freezes a rdf:Property ;
  rdfs:label "freezes" ;
  rdfs:comment "A shape: objects that conform cannot be edited, only corrected by a new linked record." ;
  rdfs:domain p:BusinessRule ;
  rdfs:range sh:NodeShape .

p:identifiesPerson a rdf:Property ;
  rdfs:label "identifies a person" ;
  rdfs:comment "True when the property's value identifies a person directly, such as a name or a date of birth. A model answering a question is given \"withheld\" in its place." ;
  rdfs:domain rdf:Property ;
  rdfs:range xsd:boolean .

p:holdsPersonalData a rdf:Property ;
  rdfs:label "holds personal data" ;
  rdfs:comment "True when objects of this type hold personal health data. The gateway records every read of them." ;
  rdfs:domain p:ObjectType ;
  rdfs:range xsd:boolean .

p:actsAs a rdf:Property ;
  rdfs:label "acts as" ;
  rdfs:comment "A role the person may act in." ;
  rdfs:domain p:Person ;
  rdfs:range p:Role .

p:method a rdf:Property ;
  rdfs:label "method" ;
  rdfs:comment "The method a commit ran." ;
  rdfs:domain p:Commit ;
  rdfs:range p:Method .

p:actedAs a rdf:Property ;
  rdfs:label "acted as" ;
  rdfs:comment "The role the person acted in." ;
  rdfs:domain prov:Activity ;
  rdfs:range p:Role .

p:signedInAs a rdf:Property ;
  rdfs:label "signed in as" ;
  rdfs:comment "The signed-in account that made the request, when the deployment has sign-in: its email address. In a demo deployment it may differ from the person acted as." ;
  rdfs:domain prov:Activity ;
  rdfs:range xsd:string .

p:email a rdf:Property ;
  rdfs:label "email" ;
  rdfs:comment "The person's email address, which their sign-in matches." ;
  rdfs:domain p:Person ;
  rdfs:range xsd:string .

p:target a rdf:Property ;
  rdfs:label "target" ;
  rdfs:comment "The object a commit ran on, or a read read." ;
  rdfs:domain prov:Activity .

p:inputValue a rdf:Property ;
  rdfs:label "input value" ;
  rdfs:comment "A value given for an input." ;
  rdfs:domain p:Commit ;
  rdfs:range p:InputValue .

p:forInput a rdf:Property ;
  rdfs:label "for input" ;
  rdfs:comment "The input this value is for." ;
  rdfs:domain p:InputValue ;
  rdfs:range p:Input .

p:change a rdf:Property ;
  rdfs:label "change" ;
  rdfs:comment "A value the commit changed." ;
  rdfs:domain p:Commit ;
  rdfs:range p:ValueChange .

p:changedSubject a rdf:Property ;
  rdfs:label "changed subject" ;
  rdfs:comment "The object whose value changed." ;
  rdfs:domain p:ValueChange .

p:changedProperty a rdf:Property ;
  rdfs:label "changed property" ;
  rdfs:comment "The property that changed." ;
  rdfs:domain p:ValueChange ;
  rdfs:range rdf:Property .

p:oldValue a rdf:Property ;
  rdfs:label "old value" ;
  rdfs:comment "The value before the commit. Absent when the value was added." ;
  rdfs:domain p:ValueChange .

p:newValue a rdf:Property ;
  rdfs:label "new value" ;
  rdfs:comment "The value after the commit. Absent when the value was removed." ;
  rdfs:domain p:ValueChange .

p:pendingEffect a rdf:Property ;
  rdfs:label "pending effect" ;
  rdfs:comment "A described effect the gateway recorded as work still to do." ;
  rdfs:domain p:Commit ;
  rdfs:range p:DescribedEffect .

p:worksIn a rdf:Property ;
  rdfs:label "works in" ;
  rdfs:comment "A domain the role's work is in. Decides the role's navigation (platform spec 5.1)." ;
  rdfs:domain p:Role ;
  rdfs:range p:Domain .

p:worksAcross a rdf:Property ;
  rdfs:label "works across" ;
  rdfs:comment "A contained object type the role works through across many containers, so it is an entry type in the role's navigation (platform spec 5.1, Entry types)." ;
  rdfs:domain p:Role ;
  rdfs:range p:ObjectType .

p:onDemand a rdf:Property ;
  rdfs:label "on demand" ;
  rdfs:comment "True when the method is an action a person chooses to take, not work waiting. On-demand methods do not put an object on To do." ;
  rdfs:domain p:Method ;
  rdfs:range xsd:boolean .

p:urgency a rdf:Property ;
  rdfs:label "urgency" ;
  rdfs:comment "How urgent an object in this state is, from 2 (medium) upward. Orders To do; 3 or more makes an object urgent." ;
  rdfs:domain skos:Concept ;
  rdfs:range xsd:integer .

p:exit a rdf:Property ;
  rdfs:label "exit" ;
  rdfs:comment "True when a lifecycle value ends the object's journey off its main path, such as a refuted signal or a missed visit. The lifecycle's other values, in order, are the main path (platform spec sections 3.1 and 5.1)." ;
  rdfs:domain skos:Concept ;
  rdfs:range xsd:boolean .

p:exitFrom a rdf:Property ;
  rdfs:label "exit from" ;
  rdfs:comment "The stage of the main path an exit leaves from, where the domain is certain. Without it, an object's own history says where it left." ;
  rdfs:domain skos:Concept ;
  rdfs:range skos:Concept .

p:isDeadline a rdf:Property ;
  rdfs:label "is deadline" ;
  rdfs:comment "True when a date property is a deadline. Orders To do." ;
  rdfs:domain rdf:Property ;
  rdfs:range xsd:boolean .

p:pluralLabel a rdf:Property ;
  rdfs:label "plural label" ;
  rdfs:comment "The plural name of an object type, for navigation and lists." ;
  rdfs:domain p:ObjectType ;
  rdfs:range xsd:string .

p:inverseLabel a rdf:Property ;
  rdfs:label "inverse label" ;
  rdfs:comment "How a relationship reads from the object at its other end, as a verb phrase that completes \"this object ... these objects\": a study \"enrolls\" its patients, a product \"is named in\" its safety cases (platform spec 3.1)." ;
  rdfs:domain p:Relationship ;
  rdfs:range xsd:string .

p:partOf a rdf:Property ;
  rdfs:label "part of" ;
  rdfs:comment "True when the subject of the relationship is part of its object, such as a visit of the patient it is for. The object then contains the subject (platform spec 5.1, Within an object)." ;
  rdfs:domain p:Relationship ;
  rdfs:range xsd:boolean .

p:hasPart a rdf:Property ;
  rdfs:label "has part" ;
  rdfs:comment "True when the object of the relationship is part of its subject, such as an assay result of the experiment that produced it (platform spec 5.1, Within an object)." ;
  rdfs:domain p:Relationship ;
  rdfs:range xsd:boolean .

p:runsInBackground a rdf:Property ;
  rdfs:label "runs in background" ;
  rdfs:comment "True when the method starts work that finishes later, such as a computation." ;
  rdfs:domain p:Method ;
  rdfs:range xsd:boolean .

p:archetype a rdf:Property ;
  rdfs:label "archetype" ;
  rdfs:comment "Overrides the method's derived interaction archetype. Rare, and only when a rule gives the wrong one." ;
  rdfs:domain p:Method ;
  rdfs:range p:Archetype .

p:ruleOrder a rdf:Property ;
  rdfs:label "rule order" ;
  rdfs:comment "The order in which the archetype's rule is checked. The first rule that matches decides." ;
  rdfs:domain p:Archetype ;
  rdfs:range xsd:integer .

p:order a rdf:Property ;
  rdfs:label "order" ;
  rdfs:comment "Position among its siblings, from 1: an input among its method's inputs, a value within its scheme, a state dimension among its type's. The first state dimension is the type's lifecycle. Keeps forms, choices and summaries in the same order every time." ;
  rdfs:range xsd:integer .

p:signatureMeaning a rdf:Property ;
  rdfs:label "signature meaning" ;
  rdfs:comment "What signing this method means, such as approval or authorship. Shown to the signer and recorded with the signature." ;
  rdfs:domain p:Method ;
  rdfs:range xsd:string .

p:signature a rdf:Property ;
  rdfs:label "signature" ;
  rdfs:comment "The signature a commit carries." ;
  rdfs:domain p:Commit ;
  rdfs:range p:Signature .

p:signedBy a rdf:Property ;
  rdfs:label "signed by" ;
  rdfs:comment "The person who signed." ;
  rdfs:domain p:Signature ;
  rdfs:range p:Person .

p:signedAt a rdf:Property ;
  rdfs:label "signed at" ;
  rdfs:comment "When the person signed." ;
  rdfs:domain p:Signature ;
  rdfs:range xsd:dateTime .

p:meaning a rdf:Property ;
  rdfs:label "meaning" ;
  rdfs:comment "What the signature means, as shown to the signer." ;
  rdfs:domain p:Signature ;
  rdfs:range xsd:string .

p:isDevelopmentSignature a rdf:Property ;
  rdfs:label "is development signature" ;
  rdfs:comment "True for a signature given by typing a name in development mode. Not a valid electronic signature." ;
  rdfs:domain p:Signature ;
  rdfs:range xsd:boolean .

p:isAgent a rdf:Property ;
  rdfs:label "is agent" ;
  rdfs:comment "True when the principal is a software agent, not a person. Agents never sign." ;
  rdfs:domain p:Person ;
  rdfs:range xsd:boolean .

p:mayRun a rdf:Property ;
  rdfs:label "may run" ;
  rdfs:comment "A method the role may run." ;
  rdfs:domain p:Role ;
  rdfs:range p:Method .

p:counts a rdf:Property ;
  rdfs:label "counts" ;
  rdfs:comment "The object type an analysis counts." ;
  rdfs:domain p:Analysis ;
  rdfs:range p:ObjectType .

p:exposure a rdf:Property ;
  rdfs:label "exposure" ;
  rdfs:comment "The relationship from a counted object to its exposure. The method's target is the exposure analysed; every other exposure is the comparison." ;
  rdfs:domain p:Analysis ;
  rdfs:range rdf:Property .

p:outcome a rdf:Property ;
  rdfs:label "outcome" ;
  rdfs:comment "The property from a counted object to its outcomes, whose values come from a concept scheme." ;
  rdfs:domain p:Analysis ;
  rdfs:range rdf:Property .

p:excludes a rdf:Property ;
  rdfs:label "excludes" ;
  rdfs:comment "Counted objects with a value for this property are left out, such as duplicates of another object." ;
  rdfs:domain p:Analysis ;
  rdfs:range rdf:Property .

p:recordsOutcomeAs a rdf:Property ;
  rdfs:label "records outcome as" ;
  rdfs:comment "The property on each created object that records the outcome it was created for." ;
  rdfs:domain p:Analysis ;
  rdfs:range rdf:Property .

p:aggregatesBy a rdf:Property ;
  rdfs:label "aggregates by" ;
  rdfs:comment "The relationship from each created object to the counted objects behind it." ;
  rdfs:domain p:Analysis ;
  rdfs:range rdf:Property .

p:minimumCount a rdf:Property ;
  rdfs:label "minimum count" ;
  rdfs:comment "The parameter giving the fewest counted objects with the outcome for the target." ;
  rdfs:domain p:Analysis ;
  rdfs:range p:Parameter .

p:minimumRatio a rdf:Property ;
  rdfs:label "minimum ratio" ;
  rdfs:comment "The parameter giving the lowest proportional reporting ratio." ;
  rdfs:domain p:Analysis ;
  rdfs:range p:Parameter .

p:minimumChiSquare a rdf:Property ;
  rdfs:label "minimum chi-square" ;
  rdfs:comment "The parameter giving the lowest chi-squared statistic, with Yates' correction." ;
  rdfs:domain p:Analysis ;
  rdfs:range p:Parameter .

p:runStatus a rdf:Property ;
  rdfs:label "run status" ;
  rdfs:comment "Where a run is: queued, running, succeeded or failed." ;
  rdfs:domain p:Run ;
  rdfs:range skos:Concept .

p:startCommit a rdf:Property ;
  rdfs:label "start commit" ;
  rdfs:comment "The commit that started the run." ;
  rdfs:domain p:Run ;
  rdfs:range p:Commit .

p:resultCommit a rdf:Property ;
  rdfs:label "result commit" ;
  rdfs:comment "The commit holding the run's result." ;
  rdfs:domain p:Run ;
  rdfs:range p:Commit .

p:message a rdf:Property ;
  rdfs:label "message" ;
  rdfs:comment "What a run found or why it failed, or what a notification says, in words." ;
  rdfs:range xsd:string .

p:recipient a rdf:Property ;
  rdfs:label "recipient" ;
  rdfs:comment "The person a notification is for." ;
  rdfs:domain p:Notification ;
  rdfs:range p:Person .

p:about a rdf:Property ;
  rdfs:label "about" ;
  rdfs:comment "The run or other activity a notification is about." ;
  rdfs:domain p:Notification ;
  rdfs:range prov:Activity .

p:title a rdf:Property ;
  rdfs:label "title" ;
  rdfs:comment "A notification's title." ;
  rdfs:domain p:Notification ;
  rdfs:range xsd:string .

p:readAt a rdf:Property ;
  rdfs:label "read at" ;
  rdfs:comment "When the recipient read the notification. Absent while unread." ;
  rdfs:domain p:Notification ;
  rdfs:range xsd:dateTime .

p:needsModel a rdf:Property ;
  rdfs:label "needs model" ;
  rdfs:comment "True when a model must do the method's work, such as proposing compounds, but the method declares no drafting effect the platform can run. Refused until one is declared and connected." ;
  rdfs:domain p:Method ;
  rdfs:range xsd:boolean .

p:recordedAs a rdf:Property ;
  rdfs:label "recorded as" ;
  rdfs:comment "When a creation runs, the input's value is recorded on the new object with this property; for a state change, on the object itself." ;
  rdfs:domain p:Input ;
  rdfs:range rdf:Property .

p:titleTemplate a rdf:Property ;
  rdfs:label "title template" ;
  rdfs:comment "How the type's objects are titled for people (platform spec 3.1, Title). Alternatives are separated by ' | ', and the first whose values are all present is used. {prefix:property} is the property's value, a coded value's label, or a linked object's title; {prefix:property:id} is a linked object's identifier. Several values are joined with commas." ;
  rdfs:domain p:ObjectType ;
  rdfs:range xsd:string .

p:draftsProperty a rdf:Property ;
  rdfs:label "drafts property" ;
  rdfs:comment "The property the accepted text of a drafting effect fills." ;
  rdfs:domain p:Drafting ;
  rdfs:range rdf:Property .

p:instructions a rdf:Property ;
  rdfs:label "instructions" ;
  rdfs:comment "What a model is asked to do, and how: for a drafting effect, what to write; for a skill, the expert's way of doing the method's work. Versioned with the ontology or the context that declares it." ;
  rdfs:range xsd:string .

p:drawsOn a rdf:Property ;
  rdfs:label "draws on" ;
  rdfs:comment "A relationship from the object to linked objects the model may also be given, as far as the principal may read them." ;
  rdfs:domain p:Drafting ;
  rdfs:range rdf:Property .

p:draftStatus a rdf:Property ;
  rdfs:label "draft status" ;
  rdfs:comment "Whether a draft is undecided, accepted or discarded." ;
  rdfs:domain p:Draft ;
  rdfs:range skos:Concept .

p:draftOf a rdf:Property ;
  rdfs:label "draft of" ;
  rdfs:comment "The object a draft was written for." ;
  rdfs:domain p:Draft .

p:text a rdf:Property ;
  rdfs:label "text" ;
  rdfs:comment "The text a model wrote." ;
  rdfs:domain p:Draft ;
  rdfs:range xsd:string .

p:modelId a rdf:Property ;
  rdfs:label "model" ;
  rdfs:comment "The model that wrote the draft, as the provider reports it." ;
  rdfs:domain p:Draft ;
  rdfs:range xsd:string .

p:instructionsDigest a rdf:Property ;
  rdfs:label "instructions digest" ;
  rdfs:comment "SHA-256 of the instructions the model was given." ;
  rdfs:domain p:Draft ;
  rdfs:range xsd:string .

p:recordsDigest a rdf:Property ;
  rdfs:label "records digest" ;
  rdfs:comment "SHA-256 of the records the model was given." ;
  rdfs:domain p:Draft ;
  rdfs:range xsd:string .

p:given a rdf:Property ;
  rdfs:label "given" ;
  rdfs:comment "An object whose record the model was given." ;
  rdfs:domain p:Draft .

p:decidedBy a rdf:Property ;
  rdfs:label "decided by" ;
  rdfs:comment "The person who accepted or discarded the draft." ;
  rdfs:domain p:Draft ;
  rdfs:range p:Person .

p:decidedAt a rdf:Property ;
  rdfs:label "decided at" ;
  rdfs:comment "When the draft was accepted or discarded." ;
  rdfs:domain p:Draft ;
  rdfs:range xsd:dateTime .

p:fromDraft a rdf:Property ;
  rdfs:label "from draft" ;
  rdfs:comment "The draft a commit accepted." ;
  rdfs:domain p:Commit ;
  rdfs:range p:Draft .

p:editedDraft a rdf:Property ;
  rdfs:label "edited draft" ;
  rdfs:comment "True when the person changed the draft's text before accepting it." ;
  rdfs:domain p:Commit ;
  rdfs:range xsd:boolean .

p:onBehalfOf a rdf:Property ;
  rdfs:label "on behalf of" ;
  rdfs:comment "The person an agent acted for in this activity, such as the person who started a background run." ;
  rdfs:domain prov:Activity ;
  rdfs:range p:Person .

p:mayNotRead a rdf:Property ;
  rdfs:label "may not read" ;
  rdfs:comment "An object type or property the role may never read." ;
  rdfs:domain p:Role .

p:parameterValue a rdf:Property ;
  rdfs:label "parameter value" ;
  rdfs:comment "The value of a parameter." ;
  rdfs:domain p:Parameter .

p:BackgroundWorker a prov:SoftwareAgent ;
  rdfs:label "Background worker" ;
  rdfs:comment "The platform agent that does the work of background runs. It acts through the gateway on behalf of the person who started each run, and never signs." .

p:RunStatus a skos:ConceptScheme ;
  skos:prefLabel "Run status" ;
  skos:definition "Where a background run is." .

p:DraftStatus a skos:ConceptScheme ;
  skos:prefLabel "Draft status" ;
  skos:definition "Whether a person has decided on a draft." .

p:DraftStatus-undecided a skos:Concept ;
  skos:inScheme p:DraftStatus ;
  skos:prefLabel "undecided" ;
  skos:definition "Written, not yet accepted or discarded. It changes nothing." ;
  p:order 1 .

p:DraftStatus-accepted a skos:Concept ;
  skos:inScheme p:DraftStatus ;
  skos:prefLabel "accepted" ;
  skos:definition "A person accepted it, as written or edited." ;
  p:order 2 .

p:DraftStatus-discarded a skos:Concept ;
  skos:inScheme p:DraftStatus ;
  skos:prefLabel "discarded" ;
  skos:definition "A person discarded it." ;
  p:order 3 .

p:RunStatus-queued a skos:Concept ;
  skos:inScheme p:RunStatus ;
  skos:prefLabel "queued" ;
  skos:definition "Started, waiting for a worker." ;
  p:order 1 .

p:RunStatus-running a skos:Concept ;
  skos:inScheme p:RunStatus ;
  skos:prefLabel "running" ;
  skos:definition "A worker is doing the work." ;
  p:order 2 .

p:RunStatus-succeeded a skos:Concept ;
  skos:inScheme p:RunStatus ;
  skos:prefLabel "succeeded" ;
  skos:definition "Ended, with its result committed." ;
  p:order 3 .

p:RunStatus-failed a skos:Concept ;
  skos:inScheme p:RunStatus ;
  skos:prefLabel "failed" ;
  skos:definition "Ended without a result. The message says why." ;
  p:order 4 .

p:ReviewAndSign a p:Archetype ;
  rdfs:label "Review and sign" ;
  rdfs:comment "The method requires an electronic signature. The person reviews what will be signed, then signs with its meaning." ;
  p:ruleOrder 1 .

p:StartAndTrack a p:Archetype ;
  rdfs:label "Start and track" ;
  rdfs:comment "The method runs in the background. The person starts it, follows its progress and is notified when it ends." ;
  p:ruleOrder 2 .

p:CompareAndDecide a p:Archetype ;
  rdfs:label "Compare and decide" ;
  rdfs:comment "An input is another object of the same type. The person sees both side by side, then decides." ;
  p:ruleOrder 3 .

p:ReviewADraft a p:Archetype ;
  rdfs:label "Review a draft" ;
  rdfs:comment "The method produces a draft. The person reads it, marked as generated, then accepts, edits or discards it." ;
  p:ruleOrder 4 .

p:ChooseAnObject a p:Archetype ;
  rdfs:label "Choose an object" ;
  rdfs:comment "An input is an object of another type. The person picks it from the objects that qualify." ;
  p:ruleOrder 5 .

p:StepByStep a p:Archetype ;
  rdfs:label "Step by step" ;
  rdfs:comment "The method needs five or more inputs. The person gives them in steps." ;
  p:ruleOrder 6 .

p:FillIn a p:Archetype ;
  rdfs:label "Fill in" ;
  rdfs:comment "The method has inputs. The person fills in a short form." ;
  p:ruleOrder 7 .

p:Confirm a p:Archetype ;
  rdfs:label "Confirm" ;
  rdfs:comment "The method has no inputs. The person confirms the change." ;
  p:ruleOrder 8 .

# Skills (platform spec 3.3, Skills): an organization's know-how for a method. Context, not ontology.

p:Skill a rdfs:Class ;
  rdfs:label "Skill" ;
  rdfs:comment "How one organization does a method's work well: the method it serves, what it proposes, its version, owner and approval, its instructions, and its reference procedure, if any. It proposes and never commits (platform spec 3.3, Skills)." .

p:ReferenceProcedure a rdfs:Class ;
  rdfs:label "reference procedure" ;
  rdfs:comment "A plain, deterministic procedure the platform implements once for every domain, which a skill may declare for when no model is connected. Its parameters are declared on the skill." .

p:InputSource a rdfs:Class ;
  rdfs:label "input source" ;
  rdfs:comment "For a skill that reuses recorded inputs: the input it proposes and the property of an earlier result it reads the value from." .

p:Proposal a rdfs:Class ;
  rdfs:label "proposal" ;
  rdfs:comment "What a skill proposed for a method on an object or a set: values for inputs, a recommended object, the reasoning and the objects it rests on, recorded with who asked and how it ran. It changes nothing. A PROV-O entity." ;
  rdfs:subClassOf prov:Entity .

p:ProposedValue a rdfs:Class ;
  rdfs:label "proposed value" ;
  rdfs:comment "One input's value in a proposal, with the objects it rests on." .

p:serves a rdf:Property ;
  rdfs:label "serves" ;
  rdfs:comment "The method whose work the skill does." ;
  rdfs:domain p:Skill ;
  rdfs:range p:Method .

p:proposesInput a rdf:Property ;
  rdfs:label "proposes input" ;
  rdfs:comment "An input of the served method that the skill proposes a value for. Never an input that must be the person's own words." ;
  rdfs:domain p:Skill ;
  rdfs:range p:Input .

p:recommends a rdf:Property ;
  rdfs:label "recommends" ;
  rdfs:comment "True when the skill recommends one object of the set a set method chooses among." ;
  rdfs:domain p:Skill ;
  rdfs:range xsd:boolean .

p:skillVersion a rdf:Property ;
  rdfs:label "skill version" ;
  rdfs:comment "The skill's version. A proposal records the version that made it." ;
  rdfs:domain p:Skill ;
  rdfs:range xsd:string .

p:owner a rdf:Property ;
  rdfs:label "owner" ;
  rdfs:comment "The role accountable for the skill's content." ;
  rdfs:domain p:Skill ;
  rdfs:range p:Role .

p:approvedOn a rdf:Property ;
  rdfs:label "approved on" ;
  rdfs:comment "When this version of the skill was approved. A skill with no approval, or approved after today, does not run." ;
  rdfs:domain p:Skill ;
  rdfs:range xsd:date .

p:usableBy a rdf:Property ;
  rdfs:label "usable by" ;
  rdfs:comment "A role that may use the skill. Without any, every role that may run its method may." ;
  rdfs:domain p:Skill ;
  rdfs:range p:Role .

p:referenceProcedure a rdf:Property ;
  rdfs:label "reference procedure" ;
  rdfs:comment "The procedure the skill runs when no model is connected, or the model fails." ;
  rdfs:domain p:Skill ;
  rdfs:range p:ReferenceProcedure .

p:resultsAlong a rdf:Property ;
  rdfs:label "results along" ;
  rdfs:comment "For reusing recorded inputs: the relationship from an earlier result to the object it is a result of, such as a simulation to what it simulates." ;
  rdfs:domain p:Skill ;
  rdfs:range rdf:Property .

p:siblingsAlong a rdf:Property ;
  rdfs:label "siblings along" ;
  rdfs:comment "For reusing recorded inputs: the relationship to a parent whose other children's results are used when the object has none of its own." ;
  rdfs:domain p:Skill ;
  rdfs:range rdf:Property .

p:latestBy a rdf:Property ;
  rdfs:label "latest by" ;
  rdfs:comment "For reusing recorded inputs: the date of a result that decides which is the most recent." ;
  rdfs:domain p:Skill ;
  rdfs:range rdf:Property .

p:inputSource a rdf:Property ;
  rdfs:label "input source" ;
  rdfs:comment "Where a skill that reuses recorded inputs reads one input's value." ;
  rdfs:domain p:Skill ;
  rdfs:range p:InputSource .

p:givesInput a rdf:Property ;
  rdfs:label "gives input" ;
  rdfs:comment "The input an input source gives a value for." ;
  rdfs:domain p:InputSource ;
  rdfs:range p:Input .

p:readFrom a rdf:Property ;
  rdfs:label "read from" ;
  rdfs:comment "The property of an earlier result the value is read from." ;
  rdfs:domain p:InputSource ;
  rdfs:range rdf:Property .

p:proposedBy a rdf:Property ;
  rdfs:label "proposed by" ;
  rdfs:comment "The skill that made the proposal." ;
  rdfs:domain p:Proposal ;
  rdfs:range p:Skill .

p:proposalFor a rdf:Property ;
  rdfs:label "proposal for" ;
  rdfs:comment "An object the proposal was made for: the object, or each object of the set." ;
  rdfs:domain p:Proposal .

p:ranBy a rdf:Property ;
  rdfs:label "ran by" ;
  rdfs:comment "How the proposal was made: the model as the provider reports it, or the name of the reference procedure." ;
  rdfs:domain p:Proposal ;
  rdfs:range xsd:string .

p:fellBack a rdf:Property ;
  rdfs:label "fell back" ;
  rdfs:comment "Why the reference procedure was run instead of the connected model, when it was." ;
  rdfs:domain p:Proposal ;
  rdfs:range xsd:string .

p:reasoning a rdf:Property ;
  rdfs:label "reasoning" ;
  rdfs:comment "Why the skill proposes what it proposes, in a few sentences." ;
  rdfs:domain p:Proposal ;
  rdfs:range xsd:string .

p:restsOn a rdf:Property ;
  rdfs:label "rests on" ;
  rdfs:comment "An object a proposal or a proposed value rests on. Only objects read for this proposal." .

p:recommended a rdf:Property ;
  rdfs:label "recommended" ;
  rdfs:comment "The object of the set the proposal recommends." ;
  rdfs:domain p:Proposal .

p:proposedValue a rdf:Property ;
  rdfs:label "proposed value" ;
  rdfs:comment "One input's value in the proposal." ;
  rdfs:domain p:Proposal ;
  rdfs:range p:ProposedValue .

p:valueOf a rdf:Property ;
  rdfs:label "value of" ;
  rdfs:comment "The input a proposed value is for." ;
  rdfs:domain p:ProposedValue ;
  rdfs:range p:Input .

p:proposedAs a rdf:Property ;
  rdfs:label "proposed as" ;
  rdfs:comment "The value proposed for the input, as the input takes it." ;
  rdfs:domain p:ProposedValue .

p:fromProposal a rdf:Property ;
  rdfs:label "from proposal" ;
  rdfs:comment "The proposal a commit's inputs started from." ;
  rdfs:domain p:Commit ;
  rdfs:range p:Proposal .

p:keptInput a rdf:Property ;
  rdfs:label "kept input" ;
  rdfs:comment "A proposed input whose value the person committed as proposed." ;
  rdfs:domain p:Commit ;
  rdfs:range p:Input .

p:changedInput a rdf:Property ;
  rdfs:label "changed input" ;
  rdfs:comment "A proposed input whose value the person changed before committing." ;
  rdfs:domain p:Commit ;
  rdfs:range p:Input .

p:followedRecommendation a rdf:Property ;
  rdfs:label "followed recommendation" ;
  rdfs:comment "Whether the person chose the object the proposal recommended." ;
  rdfs:domain p:Commit ;
  rdfs:range xsd:boolean .

p:ReuseRecordedInputs a p:ReferenceProcedure ;
  rdfs:label "reuse recorded inputs" ;
  rdfs:comment "Proposes the values recorded on the most recent result of the object, along the skill's results relationship, or else of the other children of its parent; cites that result. It does not judge what has changed since." .

p:RankByComparison a p:ReferenceProcedure ;
  rdfs:label "rank by comparison" ;
  rdfs:comment "Recommends the object of the set whose comparison has the fewest cells that miss their target, then the fewest missing; recommends none on a tie. Cites the rows it counted." .

# ---------------------------------------------------------------------------------------------------------------------
# Structure evolution (platform spec 3.7): the structure describes itself as objects in the Structure domain, and every
# change to it is a change set. Domain-free: every domain's ontology is browsed and changed the same way.

p:Structure a p:Domain ;
  rdfs:label "Structure" ;
  rdfs:comment "The platform's own domain: the ontology and the context layer, as objects (platform spec 3.7)." .

# The kinds of structure, as object types. Their objects are the ontology's own resources, read where they are declared.

p:Domain a p:ObjectType ;
  p:pluralLabel "Domains" ;
  p:inDomain p:Structure ;
  p:titleTemplate "{rdfs:label}" .

p:ObjectType a p:ObjectType ;
  p:pluralLabel "Object Types" ;
  p:inDomain p:Structure ;
  p:titleTemplate "{rdfs:label}" .

p:StateDimension a p:ObjectType ;
  p:pluralLabel "State Dimensions" ;
  p:inDomain p:Structure ;
  p:titleTemplate "{rdfs:label} of {p:dimensionOf}" .

skos:ConceptScheme a p:ObjectType ;
  rdfs:label "Value Set" ;
  p:pluralLabel "Value Sets" ;
  rdfs:comment "The values a state dimension or a classification takes: a SKOS concept scheme." ;
  p:inDomain p:Structure ;
  p:titleTemplate "{skos:prefLabel}" .

skos:Concept a p:ObjectType ;
  rdfs:label "Value" ;
  p:pluralLabel "Values" ;
  rdfs:comment "One value of a value set: a SKOS concept." ;
  p:inDomain p:Structure ;
  p:titleTemplate "{skos:prefLabel}" .

p:Relationship a p:ObjectType ;
  p:pluralLabel "Relationships" ;
  p:inDomain p:Structure ;
  p:titleTemplate "{rdfs:label}" .

p:Method a p:ObjectType ;
  p:pluralLabel "Methods" ;
  p:inDomain p:Structure ;
  p:titleTemplate "{rdfs:label}" .

p:Role a p:ObjectType ;
  p:pluralLabel "Roles" ;
  p:inDomain p:Structure ;
  p:titleTemplate "{rdfs:label}" .

p:Metric a p:ObjectType ;
  p:pluralLabel "Metrics" ;
  p:inDomain p:Structure ;
  p:titleTemplate "{rdfs:label}" .

p:Skill a p:ObjectType ;
  p:pluralLabel "Skills" ;
  p:inDomain p:Structure ;
  p:titleTemplate "{rdfs:label}" .

p:ChangeSet a p:ObjectType, rdfs:Class ;
  rdfs:label "Change Set" ;
  p:pluralLabel "Change Sets" ;
  rdfs:comment "A change to the structure in use: named operations, previewed for their impact, approved by the owners of what they touch, applied as a new version and reversible (platform spec 3.7)." ;
  p:inDomain p:Structure ;
  p:titleTemplate "{p:changeSummary}" .

p:Operation a p:ObjectType, rdfs:Class ;
  rdfs:label "Operation" ;
  p:pluralLabel "Operations" ;
  rdfs:comment "One small change in a change set, with its parameters." ;
  p:inDomain p:Structure ;
  p:titleTemplate "{p:operationKind}: {p:onValue} as {p:newLabel} | {p:operationKind}: {p:onValue} for {p:replacement} | {p:operationKind}: {p:newLabel} in {p:onValueSet} | {p:operationKind}" .

# How each kind of structure is read and linked.

p:changeSetStatus a p:StateDimension, rdf:Property ;
  rdfs:label "Status" ;
  rdfs:comment "Where a change set is in its life." ;
  p:dimensionOf p:ChangeSet ;
  p:valuesFrom p:ChangeSetStatus ;
  p:order 1 .

p:startsEmpty a rdf:Property ;
  rdfs:label "starts empty" ;
  rdfs:comment "True when a state dimension holds no value until a method sets one, such as how a change set ended. Every other lifecycle starts at its first value." ;
  rdfs:domain p:StateDimension .

p:changeSetOutcome a p:StateDimension, rdf:Property ;
  rdfs:label "Outcome" ;
  rdfs:comment "How a change set ended, once it has: withdrawn, rejected or rolled back." ;
  p:startsEmpty true ;
  p:dimensionOf p:ChangeSet ;
  p:valuesFrom p:ChangeSetOutcome ;
  p:order 2 .

p:operationKind a p:StateDimension, rdf:Property ;
  rdfs:label "Kind" ;
  rdfs:comment "What an operation does." ;
  p:dimensionOf p:Operation ;
  p:valuesFrom p:OperationKind ;
  p:chosenOnCreate true ;
  p:order 1 .

p:valueStatus a p:StateDimension, rdf:Property ;
  rdfs:label "Status" ;
  rdfs:comment "Whether a value is current or deprecated. A value with no status is current." ;
  p:dimensionOf skos:Concept ;
  p:valuesFrom p:ValueStatus ;
  p:order 1 .

p:changeSummary a rdf:Property ;
  rdfs:label "what it changes" ;
  rdfs:comment "What the change set changes and why, in a sentence." ;
  rdfs:domain p:ChangeSet ;
  rdfs:range xsd:string .

p:patch a rdf:Property ;
  rdfs:label "Turtle patch" ;
  rdfs:comment "The statements an applied change set removed and added, as Turtle, for review into the repository's files." ;
  rdfs:domain p:ChangeSet ;
  rdfs:range xsd:string .

p:versionChange a rdf:Property ;
  rdfs:label "version" ;
  rdfs:comment "Each ontology version the change set moved, such as Life sciences terms 0.2.0 to 0.3.0." ;
  rdfs:domain p:ChangeSet ;
  rdfs:range xsd:string .

p:newLabel a rdf:Property ;
  rdfs:label "new label" ;
  rdfs:comment "The label an added or relabeled value reads as." ;
  rdfs:domain p:Operation ;
  rdfs:range xsd:string .

p:operationOf a p:Relationship, rdf:Property ;
  rdfs:label "is part of" ;
  p:inverseLabel "is made of" ;
  p:order 101 ;
  p:partOf true ;
  rdfs:comment "An operation is part of one change set." .

p:onValueSet a p:Relationship, rdf:Property ;
  rdfs:label "adds to" ;
  p:inverseLabel "is changed by" ;
  p:order 102 ;
  rdfs:comment "The value set an operation adds a value to." .

p:onValue a p:Relationship, rdf:Property ;
  rdfs:label "changes" ;
  p:inverseLabel "is changed by" ;
  p:order 103 ;
  rdfs:comment "The value an operation relabels or deprecates." .

p:replacement a p:Relationship, rdf:Property ;
  rdfs:label "replaces it with" ;
  p:inverseLabel "replaces values in" ;
  p:order 104 ;
  rdfs:comment "The value that replaces a deprecated value, which objects holding it move to." .

p:replacedBy a p:Relationship, rdf:Property ;
  rdfs:label "is replaced by" ;
  p:inverseLabel "replaces" ;
  p:order 105 ;
  rdfs:comment "The value a deprecated value points to (platform spec 3.1, Additive evolution)." .

p:createdValue a p:Relationship, rdf:Property ;
  rdfs:label "added" ;
  p:inverseLabel "was added by" ;
  p:order 106 ;
  rdfs:comment "The value an applied operation added." .

# The structure's own relationships, so its objects link as the structure does.
p:inDomain a p:Relationship ; p:inverseLabel "holds" ; p:order 110 .
p:dimensionOf a p:Relationship ; p:inverseLabel "has" ; p:order 111 ; p:partOf true .
p:valuesFrom a p:Relationship ; p:inverseLabel "gives the values of" ; p:order 112 .
skos:inScheme a p:Relationship ; rdfs:label "is in" ; p:inverseLabel "holds" ; p:order 113 ; p:partOf true ;
  rdfs:comment "A value is in its value set (SKOS)." .
p:appliesTo a p:Relationship ; p:inverseLabel "has the method" ; p:order 114 .
p:mayRun a p:Relationship ; p:inverseLabel "may be run by" ; p:order 115 .
p:watches a p:Relationship ; p:inverseLabel "is watched by" ; p:order 116 .
p:worksIn a p:Relationship ; p:inverseLabel "is the work of" ; p:order 117 .
p:metricOf a p:Relationship ; p:inverseLabel "is counted by" ; p:order 118 .
p:serves a p:Relationship ; p:inverseLabel "is served by" ; p:order 119 .
p:owner a p:Relationship ; p:inverseLabel "owns" ; p:order 120 .

p:ChangeSetStatus a skos:ConceptScheme ;
  skos:prefLabel "Change set status" ;
  skos:definition "Where a change set is in its life (platform spec 3.7)." .
p:ChangeSetStatus-draft a skos:Concept ; skos:inScheme p:ChangeSetStatus ; skos:prefLabel "draft" ; p:order 1 .
p:ChangeSetStatus-proposed a skos:Concept ; skos:inScheme p:ChangeSetStatus ; skos:prefLabel "proposed" ; p:order 2 .
p:ChangeSetStatus-approved a skos:Concept ; skos:inScheme p:ChangeSetStatus ; skos:prefLabel "approved" ; p:order 3 .
p:ChangeSetStatus-applied a skos:Concept ; skos:inScheme p:ChangeSetStatus ; skos:prefLabel "applied" ; p:order 4 .
p:ChangeSetStatus-ended a skos:Concept ; skos:inScheme p:ChangeSetStatus ; skos:prefLabel "ended" ; p:order 5 ;
  skos:definition "Withdrawn, rejected or rolled back: its outcome says which." .

p:ChangeSetOutcome a skos:ConceptScheme ;
  skos:prefLabel "Change set outcome" ;
  skos:definition "How a change set that is no longer open ended." .
p:ChangeSetOutcome-withdrawn a skos:Concept ; skos:inScheme p:ChangeSetOutcome ; skos:prefLabel "withdrawn" ; p:order 1 .
p:ChangeSetOutcome-rejected a skos:Concept ; skos:inScheme p:ChangeSetOutcome ; skos:prefLabel "rejected" ; p:order 2 .
p:ChangeSetOutcome-rolledBack a skos:Concept ; skos:inScheme p:ChangeSetOutcome ; skos:prefLabel "rolled back" ; p:order 3 .

p:OperationKind a skos:ConceptScheme ;
  skos:prefLabel "Operation kind" ;
  skos:definition "What an operation of a change set does. These are the first; others follow (platform spec 3.7)." .
p:OperationKind-addValue a skos:Concept ; skos:inScheme p:OperationKind ; skos:prefLabel "add value" ; p:order 1 ;
  skos:definition "Adds a value to a value set, and to every shape that allows each of its values." .
p:OperationKind-relabel a skos:Concept ; skos:inScheme p:OperationKind ; skos:prefLabel "relabel" ; p:order 2 ;
  skos:definition "Changes how a value reads. Its address and meaning stay." .
p:OperationKind-deprecate a skos:Concept ; skos:inScheme p:OperationKind ; skos:prefLabel "deprecate" ; p:order 3 ;
  skos:definition "Deprecates a value in favor of another of its value set, and moves every object holding it to the replacement." .

p:ValueStatus a skos:ConceptScheme ;
  skos:prefLabel "Value status" ;
  skos:definition "Whether a value is current or deprecated." .
p:ValueStatus-current a skos:Concept ; skos:inScheme p:ValueStatus ; skos:prefLabel "current" ; p:order 1 .
p:ValueStatus-deprecated a skos:Concept ; skos:inScheme p:ValueStatus ; skos:prefLabel "deprecated" ; p:order 2 .

# Shapes. Those of the ontology's own resources describe them (p:describes): how each kind is read and linked, never
# validated with every commit, since the files are checked when they are loaded and tested. Change sets are validated.

p:describes a rdf:Property ;
  rdfs:label "describes" ;
  rdfs:comment "The kind of structure a shape describes for reading and linking, without targeting it for validation (platform spec 3.7)." ;
  rdfs:domain sh:NodeShape .

p:Shape-Domain a sh:NodeShape ; p:describes p:Domain ; sh:property p:Shape-Domain-label .
p:Shape-Domain-label a sh:PropertyShape ; sh:path rdfs:label ; sh:name "name" .

p:Shape-ObjectType a sh:NodeShape ; p:describes p:ObjectType ;
  sh:property p:Shape-ObjectType-label, p:Shape-ObjectType-plural, p:Shape-ObjectType-comment, p:Shape-ObjectType-inDomain .
p:Shape-ObjectType-label a sh:PropertyShape ; sh:path rdfs:label ; sh:name "name" .
p:Shape-ObjectType-plural a sh:PropertyShape ; sh:path p:pluralLabel ; sh:name "plural name" .
p:Shape-ObjectType-comment a sh:PropertyShape ; sh:path rdfs:comment ; sh:name "description" .
p:Shape-ObjectType-inDomain a sh:PropertyShape ; sh:path p:inDomain ; sh:class p:Domain ; sh:maxCount 1 ; sh:name "in domain" .

p:Shape-StateDimension a sh:NodeShape ; p:describes p:StateDimension ;
  sh:property p:Shape-StateDimension-label, p:Shape-StateDimension-comment, p:Shape-StateDimension-dimensionOf, p:Shape-StateDimension-valuesFrom .
p:Shape-StateDimension-label a sh:PropertyShape ; sh:path rdfs:label ; sh:name "name" .
p:Shape-StateDimension-comment a sh:PropertyShape ; sh:path rdfs:comment ; sh:name "description" .
p:Shape-StateDimension-dimensionOf a sh:PropertyShape ; sh:path p:dimensionOf ; sh:class p:ObjectType ; sh:maxCount 1 ; sh:name "dimension of" .
p:Shape-StateDimension-valuesFrom a sh:PropertyShape ; sh:path p:valuesFrom ; sh:class skos:ConceptScheme ; sh:maxCount 1 ; sh:name "values from" .

p:Shape-ValueSet a sh:NodeShape ; p:describes skos:ConceptScheme ;
  sh:property p:Shape-ValueSet-label, p:Shape-ValueSet-definition .
p:Shape-ValueSet-label a sh:PropertyShape ; sh:path skos:prefLabel ; sh:name "name" .
p:Shape-ValueSet-definition a sh:PropertyShape ; sh:path skos:definition ; sh:name "definition" .

p:Shape-Value a sh:NodeShape ; p:describes skos:Concept ;
  sh:property p:Shape-Value-label, p:Shape-Value-definition, p:Shape-Value-status, p:Shape-Value-inScheme, p:Shape-Value-replacedBy .
p:Shape-Value-label a sh:PropertyShape ; sh:path skos:prefLabel ; sh:name "label" .
p:Shape-Value-definition a sh:PropertyShape ; sh:path skos:definition ; sh:name "definition" .
p:Shape-Value-status a sh:PropertyShape ; sh:path p:valueStatus ; sh:in ( p:ValueStatus-current p:ValueStatus-deprecated ) ; sh:maxCount 1 ; sh:name "Status" .
p:Shape-Value-inScheme a sh:PropertyShape ; sh:path skos:inScheme ; sh:class skos:ConceptScheme ; sh:name "is in" .
p:Shape-Value-replacedBy a sh:PropertyShape ; sh:path p:replacedBy ; sh:class skos:Concept ; sh:maxCount 1 ; sh:name "is replaced by" .

p:Shape-Relationship a sh:NodeShape ; p:describes p:Relationship ;
  sh:property p:Shape-Relationship-label, p:Shape-Relationship-inverse, p:Shape-Relationship-comment .
p:Shape-Relationship-label a sh:PropertyShape ; sh:path rdfs:label ; sh:name "reads as" .
p:Shape-Relationship-inverse a sh:PropertyShape ; sh:path p:inverseLabel ; sh:name "reads back as" .
p:Shape-Relationship-comment a sh:PropertyShape ; sh:path rdfs:comment ; sh:name "description" .

p:Shape-Method a sh:NodeShape ; p:describes p:Method ;
  sh:property p:Shape-Method-label, p:Shape-Method-comment, p:Shape-Method-appliesTo .
p:Shape-Method-label a sh:PropertyShape ; sh:path rdfs:label ; sh:name "name" .
p:Shape-Method-comment a sh:PropertyShape ; sh:path rdfs:comment ; sh:name "description" .
p:Shape-Method-appliesTo a sh:PropertyShape ; sh:path p:appliesTo ; sh:class p:ObjectType ; sh:maxCount 1 ; sh:name "applies to" .

p:Shape-Role a sh:NodeShape ; p:describes p:Role ;
  sh:property p:Shape-Role-label, p:Shape-Role-comment, p:Shape-Role-mayRun, p:Shape-Role-watches, p:Shape-Role-worksIn .
p:Shape-Role-label a sh:PropertyShape ; sh:path rdfs:label ; sh:name "name" .
p:Shape-Role-comment a sh:PropertyShape ; sh:path rdfs:comment ; sh:name "description" .
p:Shape-Role-mayRun a sh:PropertyShape ; sh:path p:mayRun ; sh:class p:Method ; sh:name "may run" .
p:Shape-Role-watches a sh:PropertyShape ; sh:path p:watches ; sh:class p:Metric ; sh:name "watches" .
p:Shape-Role-worksIn a sh:PropertyShape ; sh:path p:worksIn ; sh:class p:Domain ; sh:name "works in" .

p:Shape-Metric a sh:NodeShape ; p:describes p:Metric ;
  sh:property p:Shape-Metric-label, p:Shape-Metric-comment, p:Shape-Metric-metricOf .
p:Shape-Metric-label a sh:PropertyShape ; sh:path rdfs:label ; sh:name "name" .
p:Shape-Metric-comment a sh:PropertyShape ; sh:path rdfs:comment ; sh:name "description" .
p:Shape-Metric-metricOf a sh:PropertyShape ; sh:path p:metricOf ; sh:class p:ObjectType ; sh:maxCount 1 ; sh:name "counts" .

p:Shape-Skill a sh:NodeShape ; p:describes p:Skill ;
  sh:property p:Shape-Skill-label, p:Shape-Skill-comment, p:Shape-Skill-version, p:Shape-Skill-serves, p:Shape-Skill-owner .
p:Shape-Skill-label a sh:PropertyShape ; sh:path rdfs:label ; sh:name "name" .
p:Shape-Skill-comment a sh:PropertyShape ; sh:path rdfs:comment ; sh:name "description" .
p:Shape-Skill-version a sh:PropertyShape ; sh:path p:skillVersion ; sh:name "version" .
p:Shape-Skill-serves a sh:PropertyShape ; sh:path p:serves ; sh:class p:Method ; sh:maxCount 1 ; sh:name "serves" .
p:Shape-Skill-owner a sh:PropertyShape ; sh:path p:owner ; sh:class p:Role ; sh:maxCount 1 ; sh:name "owner" .

p:Shape-ChangeSet a sh:NodeShape ; sh:targetClass p:ChangeSet ;
  sh:property p:Shape-ChangeSet-status, p:Shape-ChangeSet-outcome, p:Shape-ChangeSet-summary, p:Shape-ChangeSet-version, p:Shape-ChangeSet-patch .
p:Shape-ChangeSet-status a sh:PropertyShape ; sh:path p:changeSetStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:name "Status" ;
  sh:in ( p:ChangeSetStatus-draft p:ChangeSetStatus-proposed p:ChangeSetStatus-approved p:ChangeSetStatus-applied p:ChangeSetStatus-ended ) .
p:Shape-ChangeSet-outcome a sh:PropertyShape ; sh:path p:changeSetOutcome ; sh:maxCount 1 ; sh:name "Outcome" ;
  sh:in ( p:ChangeSetOutcome-withdrawn p:ChangeSetOutcome-rejected p:ChangeSetOutcome-rolledBack ) .
p:Shape-ChangeSet-summary a sh:PropertyShape ; sh:path p:changeSummary ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:name "what it changes" .
p:Shape-ChangeSet-version a sh:PropertyShape ; sh:path p:versionChange ; sh:datatype xsd:string ; sh:name "version" .
p:Shape-ChangeSet-patch a sh:PropertyShape ; sh:path p:patch ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:name "Turtle patch" .

p:Shape-Operation a sh:NodeShape ; sh:targetClass p:Operation ;
  sh:property p:Shape-Operation-kind, p:Shape-Operation-of, p:Shape-Operation-onValueSet, p:Shape-Operation-onValue, p:Shape-Operation-newLabel, p:Shape-Operation-replacement, p:Shape-Operation-createdValue .
p:Shape-Operation-addNeeds-shape a sh:NodeShape ; sh:targetClass p:Operation ; sh:sparql p:Shape-Operation-addNeeds .
p:Shape-Operation-relabelNeeds-shape a sh:NodeShape ; sh:targetClass p:Operation ; sh:sparql p:Shape-Operation-relabelNeeds .
p:Shape-Operation-deprecateNeeds-shape a sh:NodeShape ; sh:targetClass p:Operation ; sh:sparql p:Shape-Operation-deprecateNeeds .
p:Shape-Operation-sameSet-shape a sh:NodeShape ; sh:targetClass p:Operation ; sh:sparql p:Shape-Operation-sameSet .
p:Shape-Operation-labelFree-shape a sh:NodeShape ; sh:targetClass p:Operation ; sh:sparql p:Shape-Operation-labelFree .
p:Shape-Operation-notStructure-shape a sh:NodeShape ; sh:targetClass p:Operation ; sh:sparql p:Shape-Operation-notStructure .

p:Shape-Operation-kind a sh:PropertyShape ; sh:path p:operationKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:name "Kind" ;
  sh:in ( p:OperationKind-addValue p:OperationKind-relabel p:OperationKind-deprecate ) .
p:Shape-Operation-of a sh:PropertyShape ; sh:path p:operationOf ; sh:class p:ChangeSet ; sh:minCount 1 ; sh:maxCount 1 ; sh:name "is part of" .
p:Shape-Operation-onValueSet a sh:PropertyShape ; sh:path p:onValueSet ; sh:class skos:ConceptScheme ; sh:maxCount 1 ; sh:name "adds to" .
p:Shape-Operation-onValue a sh:PropertyShape ; sh:path p:onValue ; sh:class skos:Concept ; sh:maxCount 1 ; sh:name "changes" .
p:Shape-Operation-newLabel a sh:PropertyShape ; sh:path p:newLabel ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:name "new label" .
p:Shape-Operation-replacement a sh:PropertyShape ; sh:path p:replacement ; sh:class skos:Concept ; sh:maxCount 1 ; sh:name "replaces it with" .
p:Shape-Operation-createdValue a sh:PropertyShape ; sh:path p:createdValue ; sh:nodeKind sh:IRI ; sh:maxCount 1 ; sh:name "added" .

p:Shape-Operation-addNeeds a sh:SPARQLConstraint ;
  sh:message "Adding a value needs the value set to add it to and its label" ;
  sh:prefixes p:prefixes ;
  sh:select """SELECT $this WHERE { $this p:operationKind p:OperationKind-addValue .
    FILTER (NOT EXISTS { $this p:onValueSet ?s } || NOT EXISTS { $this p:newLabel ?l }) }""" .
p:Shape-Operation-relabelNeeds a sh:SPARQLConstraint ;
  sh:message "Relabeling needs the value and its new label" ;
  sh:prefixes p:prefixes ;
  sh:select """SELECT $this WHERE { $this p:operationKind p:OperationKind-relabel .
    FILTER (NOT EXISTS { $this p:onValue ?v } || NOT EXISTS { $this p:newLabel ?l }) }""" .
p:Shape-Operation-deprecateNeeds a sh:SPARQLConstraint ;
  sh:message "Deprecating needs the value and the value that replaces it, another current value of the same value set" ;
  sh:prefixes p:prefixes ;
  sh:select """SELECT $this WHERE { $this p:operationKind p:OperationKind-deprecate .
    FILTER (NOT EXISTS { $this p:onValue ?v ; p:replacement ?r . ?v skos:inScheme ?s . ?r skos:inScheme ?s FILTER(?r != ?v)
      FILTER NOT EXISTS { ?r p:valueStatus p:ValueStatus-deprecated } }) }""" .
p:Shape-Operation-sameSet a sh:SPARQLConstraint ;
  sh:message "Deprecating or relabeling acts on a current value" ;
  sh:prefixes p:prefixes ;
  sh:select """SELECT $this WHERE { $this p:onValue ?v . ?v p:valueStatus p:ValueStatus-deprecated .
    $this p:operationOf/p:changeSetStatus ?s FILTER(?s IN (p:ChangeSetStatus-draft, p:ChangeSetStatus-proposed, p:ChangeSetStatus-approved)) }""" .
p:Shape-Operation-labelFree a sh:SPARQLConstraint ;
  sh:message "Another value of that value set already reads so" ;
  sh:prefixes p:prefixes ;
  sh:select """SELECT $this WHERE { $this p:newLabel ?l . { $this p:onValueSet ?s } UNION { $this p:onValue/skos:inScheme ?s }
    ?other skos:inScheme ?s ; skos:prefLabel ?o FILTER(LCASE(STR(?o)) = LCASE(STR(?l)))
    FILTER NOT EXISTS { $this p:createdValue ?other } FILTER NOT EXISTS { $this p:onValue ?other }
    $this p:operationOf/p:changeSetStatus ?st FILTER(?st IN (p:ChangeSetStatus-draft, p:ChangeSetStatus-proposed, p:ChangeSetStatus-approved)) }""" .
p:Shape-Operation-notStructure a sh:SPARQLConstraint ;
  sh:message "The platform's own value sets, such as a change set's status, change only with a release" ;
  sh:prefixes p:prefixes ;
  sh:select """SELECT $this WHERE { { $this p:onValueSet ?s } UNION { $this p:onValue/skos:inScheme ?s }
    FILTER(STRSTARTS(STR(?s), "https://w3id.org/lsh-platform/platform#")) }""" .

p:prefixes a owl:Ontology ;
  sh:declare p:prefixes-p, p:prefixes-skos .
p:prefixes-p a sh:PrefixDeclaration ; sh:prefix "p" ; sh:namespace "https://w3id.org/lsh-platform/platform#"^^xsd:anyURI .
p:prefixes-skos a sh:PrefixDeclaration ; sh:prefix "skos" ; sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI .

# The lifecycle of a change set, as methods (platform spec 3.7). Apply and Roll back carry structure effects.

p:ApplyStructureChange a rdfs:Class ;
  rdfs:label "apply structure change" ;
  rdfs:comment "An effect that carries out a change set's operations and their migration on the working copy, so the whole graph is validated against the changed structure (platform spec 3.4, Structure changes)." ;
  rdfs:subClassOf p:Effect .

p:RollBackStructureChange a rdfs:Class ;
  rdfs:label "roll back structure change" ;
  rdfs:comment "An effect that applies the inverse of the commit that applied a change set, as a new change." ;
  rdfs:subClassOf p:Effect .

p:approvedByOwners a rdf:Property ;
  rdfs:label "approved by owners" ;
  rdfs:comment "True when only an owner of every part a change set touches may run the method, and never the person who drafted it alone (platform spec 3.7)." ;
  rdfs:domain p:Method .

p:readsNoPersonalData a rdf:Property ;
  rdfs:label "reads no personal data" ;
  rdfs:comment "True when the role may read no type that holds personal data." ;
  rdfs:domain p:Role .

p:Shape-ChangeSet-isDraft a sh:NodeShape ; rdfs:label "The change set is a draft" ;
  sh:property p:Shape-ChangeSet-isDraft-status ; sh:sparql p:Shape-ChangeSet-hasOperations .
p:Shape-ChangeSet-isDraft-status a sh:PropertyShape ; sh:path p:changeSetStatus ; sh:hasValue p:ChangeSetStatus-draft ; sh:message "The change set is not a draft" .
p:Shape-ChangeSet-hasOperations a sh:SPARQLConstraint ;
  sh:message "The change set has no operations yet" ;
  sh:prefixes p:prefixes ;
  sh:select "SELECT $this WHERE { FILTER NOT EXISTS { ?op p:operationOf $this } }" .
p:Shape-ChangeSet-isProposed a sh:NodeShape ; rdfs:label "The change set is proposed" ; sh:property p:Shape-ChangeSet-isProposed-status .
p:Shape-ChangeSet-isProposed-status a sh:PropertyShape ; sh:path p:changeSetStatus ; sh:hasValue p:ChangeSetStatus-proposed ; sh:message "The change set is not waiting for approval" .
p:Shape-ChangeSet-isOpen a sh:NodeShape ; rdfs:label "The change set is open" ; sh:property p:Shape-ChangeSet-isOpen-status .
p:Shape-ChangeSet-isOpen-status a sh:PropertyShape ; sh:path p:changeSetStatus ; sh:in ( p:ChangeSetStatus-draft p:ChangeSetStatus-proposed ) ; sh:message "Only a draft or proposed change set can be withdrawn" .
p:Shape-ChangeSet-isApproved a sh:NodeShape ; rdfs:label "The change set is approved" ; sh:property p:Shape-ChangeSet-isApproved-status .
p:Shape-ChangeSet-isApproved-status a sh:PropertyShape ; sh:path p:changeSetStatus ; sh:hasValue p:ChangeSetStatus-approved ; sh:message "The change set is not approved" .
p:Shape-ChangeSet-isApplied a sh:NodeShape ; rdfs:label "The change set is applied" ; sh:property p:Shape-ChangeSet-isApplied-status .
p:Shape-ChangeSet-isApplied-status a sh:PropertyShape ; sh:path p:changeSetStatus ; sh:hasValue p:ChangeSetStatus-applied ; sh:message "The change set is not applied" .

p:ProposeChangeSet-effect1 a p:StateChange ; p:dimension p:changeSetStatus ; p:value p:ChangeSetStatus-proposed .
p:ApproveChangeSet-effect1 a p:StateChange ; p:dimension p:changeSetStatus ; p:value p:ChangeSetStatus-approved .
p:RejectChangeSet-effect1 a p:StateChange ; p:dimension p:changeSetStatus ; p:value p:ChangeSetStatus-ended .
p:RejectChangeSet-effect2 a p:StateChange ; p:dimension p:changeSetOutcome ; p:value p:ChangeSetOutcome-rejected .
p:WithdrawChangeSet-effect1 a p:StateChange ; p:dimension p:changeSetStatus ; p:value p:ChangeSetStatus-ended .
p:WithdrawChangeSet-effect2 a p:StateChange ; p:dimension p:changeSetOutcome ; p:value p:ChangeSetOutcome-withdrawn .
p:ApplyChangeSet-effect1 a p:ApplyStructureChange .
p:ApplyChangeSet-effect2 a p:StateChange ; p:dimension p:changeSetStatus ; p:value p:ChangeSetStatus-applied .
p:RollBackChangeSet-effect1 a p:RollBackStructureChange .
p:RollBackChangeSet-effect2 a p:StateChange ; p:dimension p:changeSetStatus ; p:value p:ChangeSetStatus-ended .
p:RollBackChangeSet-effect3 a p:StateChange ; p:dimension p:changeSetOutcome ; p:value p:ChangeSetOutcome-rolledBack .

p:ProposeChangeSet a p:Method ;
  rdfs:label "Propose" ;
  rdfs:comment "Sends a draft change set to the owners of what it touches, for approval." ;
  p:appliesTo p:ChangeSet ;
  p:precondition p:Shape-ChangeSet-isDraft ;
  p:effect p:ProposeChangeSet-effect1 .

p:ApproveChangeSet a p:Method ;
  rdfs:label "Approve" ;
  rdfs:comment "Approves a proposed change set, as an owner of every part it touches." ;
  p:appliesTo p:ChangeSet ;
  p:approvedByOwners true ;
  p:precondition p:Shape-ChangeSet-isProposed ;
  p:effect p:ApproveChangeSet-effect1 .

p:RejectChangeSet a p:Method ;
  rdfs:label "Reject" ;
  rdfs:comment "Rejects a proposed change set, as an owner of what it touches." ;
  p:appliesTo p:ChangeSet ;
  p:approvedByOwners true ;
  p:onDemand true ;
  p:precondition p:Shape-ChangeSet-isProposed ;
  p:effect p:RejectChangeSet-effect1, p:RejectChangeSet-effect2 .

p:WithdrawChangeSet a p:Method ;
  rdfs:label "Withdraw" ;
  rdfs:comment "Withdraws a draft or proposed change set. Nothing in the structure changes." ;
  p:appliesTo p:ChangeSet ;
  p:onDemand true ;
  p:precondition p:Shape-ChangeSet-isOpen ;
  p:effect p:WithdrawChangeSet-effect1, p:WithdrawChangeSet-effect2 .

p:ApplyChangeSet a p:Method ;
  rdfs:label "Apply" ;
  rdfs:comment "Applies an approved change set: its operations and their migration, in one transaction, as a new version of the ontology." ;
  p:appliesTo p:ChangeSet ;
  p:precondition p:Shape-ChangeSet-isApproved ;
  p:effect p:ApplyChangeSet-effect1, p:ApplyChangeSet-effect2 .

p:RollBackChangeSet a p:Method ;
  rdfs:label "Roll back" ;
  rdfs:comment "Applies the inverse of an applied change set, as a new change. Refused when the inverse would break something." ;
  p:appliesTo p:ChangeSet ;
  p:onDemand true ;
  p:precondition p:Shape-ChangeSet-isApplied ;
  p:effect p:RollBackChangeSet-effect1, p:RollBackChangeSet-effect2, p:RollBackChangeSet-effect3 .

# The Structure Steward: the platform's own canonical role (platform spec 3.7). Each domain gives it its metrics.

p:StructureSteward a p:Role ;
  rdfs:label "Structure Steward" ;
  rdfs:comment "Tends the structure: drafts, proposes, applies and rolls back change sets, and approves those for parts nobody else owns." ;
  p:worksIn p:Structure ;
  p:mayCreate p:ChangeSet, p:Operation ;
  p:mayEdit p:ChangeSet, p:Operation ;
  p:mayRun p:ProposeChangeSet, p:ApproveChangeSet, p:RejectChangeSet, p:WithdrawChangeSet, p:ApplyChangeSet, p:RollBackChangeSet ;
  p:readsNoPersonalData true .

# Operations are added to a draft change set by methods, each a Choose an object with the operation's parameters.

p:Operation p:onlyThroughMethods true .

p:AddValue-valueSet a p:Input ; p:inputName "valueSet" ; rdfs:label "Value set" ; p:order 1 ; p:objectOf skos:ConceptScheme ; p:recordedAs p:onValueSet .
p:AddValue-label a p:Input ; p:inputName "label" ; rdfs:label "Label" ; p:order 2 ; p:datatype xsd:string ; p:recordedAs p:newLabel .
p:AddValue-effect1 a p:Creation ; p:createsType p:Operation ; p:linkedBy p:operationOf ; p:initialState p:OperationKind-addValue .

p:AddValue a p:Method ;
  rdfs:label "Add a value" ;
  rdfs:comment "Adds an operation to the change set: a new value for a value set, such as a new status." ;
  p:appliesTo p:ChangeSet ;
  p:onDemand true ;
  p:input p:AddValue-valueSet, p:AddValue-label ;
  p:precondition p:Shape-ChangeSet-isOpenDraft ;
  p:effect p:AddValue-effect1 .

p:RelabelValue-value a p:Input ; p:inputName "value" ; rdfs:label "Value" ; p:order 1 ; p:objectOf skos:Concept ; p:recordedAs p:onValue ;
  p:inputShape p:Shape-IsCurrentValue .
p:RelabelValue-label a p:Input ; p:inputName "label" ; rdfs:label "New label" ; p:order 2 ; p:datatype xsd:string ; p:recordedAs p:newLabel .
p:RelabelValue-effect1 a p:Creation ; p:createsType p:Operation ; p:linkedBy p:operationOf ; p:initialState p:OperationKind-relabel .

p:RelabelValue a p:Method ;
  rdfs:label "Relabel a value" ;
  rdfs:comment "Adds an operation to the change set: a value reads differently. Its address and meaning stay." ;
  p:appliesTo p:ChangeSet ;
  p:onDemand true ;
  p:input p:RelabelValue-value, p:RelabelValue-label ;
  p:precondition p:Shape-ChangeSet-isOpenDraft ;
  p:effect p:RelabelValue-effect1 .

p:DeprecateValue-value a p:Input ; p:inputName "value" ; rdfs:label "Value" ; p:order 1 ; p:objectOf skos:Concept ; p:recordedAs p:onValue ;
  p:inputShape p:Shape-IsCurrentValue .
p:DeprecateValue-replacement a p:Input ; p:inputName "replacement" ; rdfs:label "Replace it with" ; p:order 2 ; p:objectOf skos:Concept ; p:recordedAs p:replacement ;
  p:inputShape p:Shape-IsCurrentValue .
p:DeprecateValue-effect1 a p:Creation ; p:createsType p:Operation ; p:linkedBy p:operationOf ; p:initialState p:OperationKind-deprecate .

p:DeprecateValue a p:Method ;
  rdfs:label "Deprecate a value" ;
  rdfs:comment "Adds an operation to the change set: a value is deprecated in favor of another of its value set, and objects holding it move to the replacement." ;
  p:appliesTo p:ChangeSet ;
  p:onDemand true ;
  p:input p:DeprecateValue-value, p:DeprecateValue-replacement ;
  p:precondition p:Shape-ChangeSet-isOpenDraft ;
  p:effect p:DeprecateValue-effect1 .

p:Shape-ChangeSet-isOpenDraft a sh:NodeShape ; rdfs:label "The change set is a draft" ; sh:property p:Shape-ChangeSet-isDraft-status .

p:Shape-IsCurrentValue a sh:NodeShape ;
  rdfs:label "A current value of a domain's value set" ;
  sh:sparql p:Shape-IsCurrentValue-query .
p:Shape-IsCurrentValue-query a sh:SPARQLConstraint ;
  sh:message "The value is deprecated, or belongs to the platform's own value sets" ;
  sh:prefixes p:prefixes ;
  sh:select """SELECT $this WHERE { { $this p:valueStatus p:ValueStatus-deprecated }
    UNION { $this skos:inScheme ?s FILTER(STRSTARTS(STR(?s), "https://w3id.org/lsh-platform/platform#")) } }""" .

p:StructureSteward p:mayRun p:AddValue, p:RelabelValue, p:DeprecateValue .

# Starting points (platform spec 3.3, Skills): a skill may serve creating a type, naming the ways a person may begin.

p:StartingPoint a rdfs:Class ;
  rdfs:label "starting point" ;
  rdfs:comment "One way a person may begin creating an object of a type, named by a skill, with the beginning the platform uses for it." .

p:Beginning a rdfs:Class ;
  rdfs:label "beginning" ;
  rdfs:comment "How the platform begins a new object, implemented once for every domain: the create form, a template or a document." .

p:forType a rdf:Property ;
  rdfs:label "for type" ;
  rdfs:comment "The type a skill that serves Create is for." ;
  rdfs:domain p:Skill ;
  rdfs:range p:ObjectType .

p:startingPoint a rdf:Property ;
  rdfs:label "starting point" ;
  rdfs:comment "A way to begin that the skill names, in the order given by p:order." ;
  rdfs:domain p:Skill ;
  rdfs:range p:StartingPoint .

p:begins a rdf:Property ;
  rdfs:label "begins with" ;
  rdfs:comment "The beginning a starting point uses." ;
  rdfs:domain p:StartingPoint ;
  rdfs:range p:Beginning .

p:notYetBecause a rdf:Property ;
  rdfs:label "not yet because" ;
  rdfs:comment "Why the platform cannot run a beginning yet, said to the person who sees it as not yet available." ;
  rdfs:domain p:Beginning ;
  rdfs:range xsd:string .

p:BeginWithForm a p:Beginning ;
  rdfs:label "the create form" ;
  rdfs:comment "Opens the type's create form (platform spec 5.3)." .

p:BeginFromTemplate a p:Beginning ;
  rdfs:label "a template" ;
  rdfs:comment "Copies an approved template of the type with its parts, for the person to complete." ;
  p:notYetBecause "Templates need a deep copy of an object with its parts, which the platform cannot make yet." .

p:BeginFromDocument a p:Beginning ;
  rdfs:label "a document" ;
  rdfs:comment "Reads a document into the type's structure, proposed for review." ;
  p:notYetBecause "Importing a document needs a connected model to read it into structure, and is not built yet." .
