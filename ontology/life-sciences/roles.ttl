@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix p:       <https://w3id.org/lsh-platform/platform#> .
@prefix ls:      <https://w3id.org/lsh-platform/life-sciences#> .
@prefix lst:     <https://w3id.org/lsh-platform/life-sciences/term#> .
@prefix lsh:     <https://w3id.org/lsh-platform/life-sciences/shape#> .
@prefix ncit:    <http://purl.obolibrary.org/obo/NCIT_> .
<https://w3id.org/lsh-platform/life-sciences/roles> a owl:Ontology ;
  dcterms:title "LS&H life sciences roles" ;
  rdfs:comment "The personas of domain spec section 6 and the external agent role." ;
  owl:versionInfo "0.1.0" ;
  owl:versionIRI <https://w3id.org/lsh-platform/life-sciences/roles/0.1.0> ;
  dcterms:created "2026-11-08"^^xsd:date .

ls:ComputationalChemist a p:Role ;
  rdfs:label "Computational Chemist" ;
  rdfs:comment "Finds a better compound." ;
  p:mayRun ls:RunSimulation, ls:GenerateAnalogs, ls:Register, ls:PromoteToCandidate ;
  p:mayNotRead ls:Patient, ls:Visit, ls:DataRecord, ls:DataQuery, ls:AdverseEvent .

ls:ClinicalDataManager a p:Role ;
  rdfs:label "Clinical Data Manager" ;
  rdfs:comment "Gets clean data to study lock." ;
  p:mayRun ls:RaiseQuery, ls:CloseQuery, ls:ReportToSafety, ls:LockStudy ;
  p:mayNotRead ls:assignedArm .

ls:DrugSafetyPhysician a p:Role ;
  rdfs:label "Drug Safety Physician" ;
  rdfs:comment "Protects patients and meets reporting deadlines." ;
  p:mayRun ls:Triage, ls:Assess, ls:FlagDuplicate, ls:MergeDuplicate, ls:GenerateNarrative, ls:PrepareExpeditedReport, ls:CloseCase,
    ls:SendForReview, ls:Submit, ls:RunSignalDetection, ls:EvaluateSignal, ls:ConfirmSignal, ls:RefuteSignal, ls:UnblindPatient .

ls:QualityLead a p:Role ;
  rdfs:label "Quality Lead" ;
  rdfs:comment "Keeps every batch compliant." ;
  p:mayRun ls:ReleaseBatch, ls:QuarantineBatch, ls:OpenQualityEvent, ls:StartInvestigation, ls:AssignCAPA, ls:RecordCAPAOutcome, ls:CloseQualityEvent .

ls:ExternalCROAgent a p:Role ;
  rdfs:label "External CRO agent" ;
  rdfs:comment "A contract research organization's agent. Answers and closes data queries at its own sites, through the gateway, under the same policy as people." ;
  p:mayRun ls:AnswerQuery, ls:CloseQuery ;
  p:mayNotRead ls:assignedArm .
