lsh:AdverseEvent-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:AdverseEvent-entry a sh:PropertyShape ;
  sh:path ls:adverseEventEntry ;
  sh:in ( lst:AdverseEventEntry-entered lst:AdverseEventEntry-verified ) ;
  sh:maxCount 1 ;
  sh:name "Entry" .

lsh:AdverseEvent-seriousness a sh:PropertyShape ;
  sh:path ls:adverseEventSeriousness ;
  sh:in ( lst:AdverseEventSeriousness-nonSerious lst:AdverseEventSeriousness-serious ) ;
