lsh:SafetyCase-causality a sh:PropertyShape ;
  sh:path ls:safetyCaseCausality ;
  sh:in ( lst:SafetyCaseCausality-unassessed lst:SafetyCaseCausality-unrelated lst:SafetyCaseCausality-possible lst:SafetyCaseCausality-probable ) ;
  sh:maxCount 1 ;
  sh:name "Causality" .

lsh:SafetyCase-originatesFrom a sh:PropertyShape ;
  sh:path ls:originatesFrom ;
  sh:or ( lsh:IsAdverseEvent lsh:IsMedicalInquiry ) ;
  sh:maxCount 1 ;
  sh:name "originates from" .

lsh:SafetyCase-concerns a sh:PropertyShape ;
  sh:path ls:concerns ;
  sh:class ls:Product ;
  sh:name "concerns" .

lsh:SafetyCase-mayInvolve a sh:PropertyShape ;
  sh:path ls:mayInvolve ;
  sh:class ls:Batch ;
  sh:name "may involve" .

lsh:SafetyCase-duplicateOf a sh:PropertyShape ;
  sh:path ls:duplicateOf ;
  sh:class ls:SafetyCase ;
  sh:maxCount 1 ;
  sh:name "duplicate of" .

lsh:SafetyCase-reaction a sh:PropertyShape ;
  sh:path ls:reaction ;
  sh:in ( lst:Reaction-drugInducedLiverInjury lst:Reaction-skinRash lst:Reaction-nausea lst:Reaction-headache lst:Reaction-fatigue lst:Reaction-dizziness lst:Reaction-diarrhea ) ;
  sh:name "reaction" .

lsh:SafetyCase-receivedOn a sh:PropertyShape ;
  sh:path ls:receivedOn ;
  sh:datatype xsd:date ;
  sh:maxCount 1 ;
  sh:name "received on" .

lsh:SafetyCase-narrative a sh:PropertyShape ;
  sh:path ls:narrative ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "narrative" .

lsh:SafetyCase a sh:NodeShape ;
  sh:targetClass ls:SafetyCase ;
  sh:property lsh:SafetyCase-identifier, lsh:SafetyCase-workflow, lsh:SafetyCase-seriousness, lsh:SafetyCase-expectedness, lsh:SafetyCase-causality, lsh:SafetyCase-originatesFrom, lsh:SafetyCase-concerns, lsh:SafetyCase-mayInvolve, lsh:SafetyCase-duplicateOf, lsh:SafetyCase-reaction, lsh:SafetyCase-receivedOn, lsh:SafetyCase-narrative .

lsh:Product-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:Product-status a sh:PropertyShape ;
  sh:path ls:productStatus ;
  sh:in ( lst:ProductStatus-investigational lst:ProductStatus-approved lst:ProductStatus-withdrawn ) ;
  sh:maxCount 1 ;
  sh:name "Status" .

lsh:Product-isFormulation a sh:PropertyShape ;
  sh:path ls:isFormulation ;
  sh:class ls:Formulation ;
  sh:maxCount 1 ;
  sh:name "is" .

lsh:Product-productName a sh:PropertyShape ;
  sh:path ls:productName ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "name" .

lsh:Product a sh:NodeShape ;
  sh:targetClass ls:Product ;
  sh:property lsh:Product-identifier, lsh:Product-status, lsh:Product-isFormulation, lsh:Product-productName .

lsh:Signal-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:Signal-status a sh:PropertyShape ;
  sh:path ls:signalStatus ;
  sh:in ( lst:SignalStatus-detected lst:SignalStatus-underEvaluation lst:SignalStatus-confirmed lst:SignalStatus-refuted ) ;
  sh:maxCount 1 ;
  sh:name "Status" .

lsh:Signal-concerns a sh:PropertyShape ;
  sh:path ls:concerns ;
  sh:class ls:Product ;
  sh:maxCount 1 ;
  sh:name "concerns" .

lsh:Signal-aggregates a sh:PropertyShape ;
  sh:path ls:aggregates ;
  sh:class ls:SafetyCase ;
  sh:name "aggregates" .

lsh:Signal-reaction a sh:PropertyShape ;
  sh:path ls:reaction ;
  sh:in ( lst:Reaction-drugInducedLiverInjury lst:Reaction-skinRash lst:Reaction-nausea lst:Reaction-headache lst:Reaction-fatigue lst:Reaction-dizziness lst:Reaction-diarrhea ) ;
  sh:maxCount 1 ;
  sh:name "reaction" .

lsh:Signal a sh:NodeShape ;
  sh:targetClass ls:Signal ;
  sh:property lsh:Signal-identifier, lsh:Signal-status, lsh:Signal-concerns, lsh:Signal-aggregates, lsh:Signal-reaction .

lsh:Submission-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:Submission-status a sh:PropertyShape ;
  sh:path ls:submissionStatus ;
  sh:in ( lst:SubmissionStatus-draft lst:SubmissionStatus-inReview lst:SubmissionStatus-submitted lst:SubmissionStatus-acknowledged ) ;
  sh:maxCount 1 ;
  sh:name "Status" .

lsh:Submission-deadline a sh:PropertyShape ;
  sh:path ls:submissionDeadline ;
  sh:in ( lst:SubmissionDeadline-onTrack lst:SubmissionDeadline-dueSoon lst:SubmissionDeadline-overdue ) ;
  sh:maxCount 1 ;
  sh:name "Deadline" .

lsh:Submission-reports a sh:PropertyShape ;
  sh:path ls:reports ;
  sh:or ( lsh:IsSafetyCase lsh:IsSignal ) ;
  sh:name "reports" .

lsh:Submission-dueOn a sh:PropertyShape ;
  sh:path ls:dueOn ;
  sh:datatype xsd:date ;
  sh:maxCount 1 ;
  sh:name "due on" .

lsh:Submission-preparedBy a sh:PropertyShape ;
  sh:path ls:preparedBy ;
  sh:nodeKind sh:IRI ;
  sh:maxCount 1 ;
  sh:name "prepared by" .

lsh:Submission a sh:NodeShape ;
  sh:targetClass ls:Submission ;
  sh:property lsh:Submission-identifier, lsh:Submission-status, lsh:Submission-deadline, lsh:Submission-reports, lsh:Submission-dueOn, lsh:Submission-preparedBy .

lsh:QualityEvent-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:QualityEvent-status a sh:PropertyShape ;
  sh:path ls:qualityEventStatus ;
  sh:in ( lst:QualityEventStatus-open lst:QualityEventStatus-investigating lst:QualityEventStatus-capaAssigned lst:QualityEventStatus-closed ) ;
  sh:maxCount 1 ;
  sh:name "Status" .

lsh:QualityEvent-severity a sh:PropertyShape ;
  sh:path ls:qualityEventSeverity ;
  sh:in ( lst:QualityEventSeverity-minor lst:QualityEventSeverity-major lst:QualityEventSeverity-critical ) ;
  sh:maxCount 1 ;
  sh:name "Severity" .

lsh:QualityEvent-raisedOn a sh:PropertyShape ;
  sh:path ls:raisedOn ;
  sh:class ls:Batch ;
  sh:maxCount 1 ;
  sh:name "raised on" .

lsh:QualityEvent-eventDescription a sh:PropertyShape ;
  sh:path ls:eventDescription ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "description" .

lsh:QualityEvent a sh:NodeShape ;
  sh:targetClass ls:QualityEvent ;
  sh:property lsh:QualityEvent-identifier, lsh:QualityEvent-status, lsh:QualityEvent-severity, lsh:QualityEvent-raisedOn, lsh:QualityEvent-eventDescription .

lsh:CAPA-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:CAPA-status a sh:PropertyShape ;
  sh:path ls:capaStatus ;
  sh:in ( lst:CAPAStatus-planned lst:CAPAStatus-inProgress lst:CAPAStatus-effective lst:CAPAStatus-ineffective ) ;
  sh:maxCount 1 ;
  sh:name "Status" .

lsh:CAPA-resolves a sh:PropertyShape ;
  sh:path ls:resolves ;
  sh:class ls:QualityEvent ;
  sh:maxCount 1 ;
  sh:name "resolves" .

lsh:CAPA-capaAction a sh:PropertyShape ;
  sh:path ls:capaAction ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "action" .

lsh:CAPA a sh:NodeShape ;
  sh:targetClass ls:CAPA ;
  sh:property lsh:CAPA-identifier, lsh:CAPA-status, lsh:CAPA-resolves, lsh:CAPA-capaAction .

lsh:MedicalInquiry-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:MedicalInquiry-status a sh:PropertyShape ;
  sh:path ls:medicalInquiryStatus ;
  sh:in ( lst:MedicalInquiryStatus-received lst:MedicalInquiryStatus-answered lst:MedicalInquiryStatus-closed ) ;
  sh:maxCount 1 ;
  sh:name "Status" .

lsh:MedicalInquiry-inquiryText a sh:PropertyShape ;
  sh:path ls:inquiryText ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "question" .

lsh:MedicalInquiry a sh:NodeShape ;
  sh:targetClass ls:MedicalInquiry ;
  sh:property lsh:MedicalInquiry-identifier, lsh:MedicalInquiry-status, lsh:MedicalInquiry-inquiryText .

lsh:IsAdverseEvent a sh:NodeShape ;
  sh:class ls:AdverseEvent .

lsh:IsMedicalInquiry a sh:NodeShape ;
  sh:class ls:MedicalInquiry .

lsh:IsSafetyCase a sh:NodeShape ;
  sh:class ls:SafetyCase .

lsh:IsSignal a sh:NodeShape ;
  sh:class ls:Signal .
