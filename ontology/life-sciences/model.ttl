  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:DataRecord-entry a sh:PropertyShape ;
  sh:path ls:dataRecordEntry ;
  sh:in ( lst:DataRecordEntry-entered lst:DataRecordEntry-verified ) ;
  sh:maxCount 1 ;
  sh:name "Entry" .

lsh:DataRecord-source a sh:PropertyShape ;
  sh:path ls:dataRecordSource ;
  sh:in ( lst:DataRecordSource-site lst:DataRecordSource-patient lst:DataRecordSource-device lst:DataRecordSource-healthRecord ) ;
