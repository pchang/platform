@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix p:       <https://w3id.org/lsh-platform/platform#> .
@prefix ls:      <https://w3id.org/lsh-platform/life-sciences#> .
@prefix lst:     <https://w3id.org/lsh-platform/life-sciences/term#> .
@prefix lsh:     <https://w3id.org/lsh-platform/life-sciences/shape#> .
@prefix ncit:    <http://purl.obolibrary.org/obo/NCIT_> .
<https://w3id.org/lsh-platform/life-sciences> a owl:Ontology ;
  dcterms:title "LS&H life sciences model" ;
  rdfs:comment "Object types, state dimensions, relationships and their SHACL shapes for the life sciences thread (domain spec sections 2 to 5, and Design and Plan in section 3.4)." ;
  owl:versionInfo "0.2.0" ;
  owl:versionIRI <https://w3id.org/lsh-platform/life-sciences/0.2.0> ;
  dcterms:created "2026-11-08"^^xsd:date .

ls:ScientificInnovation a p:Domain ;
  rdfs:label "Scientific Innovation" .

ls:ClinicalDevelopment a p:Domain ;
  rdfs:label "Clinical Development" .

ls:SafetyAndRegulatory a p:Domain ;
  rdfs:label "Safety and Regulatory" .

ls:identifier a owl:DatatypeProperty ;
  rdfs:label "identifier" ;
  rdfs:comment "The identifier people use for an object, such as SC-0007." .

ls:Compound a p:ObjectType, rdfs:Class ;
  rdfs:label "Compound" ;
  p:pluralLabel "Compounds" ;
  rdfs:comment "A molecule under research." ;
  p:inDomain ls:ScientificInnovation ;
  p:titleTemplate "{ls:compoundName} | Analog of {ls:derivedFrom}" .

ls:compoundStage a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Stage" ;
  rdfs:comment "The stage of a compound." ;
  p:dimensionOf ls:Compound ;
  p:valuesFrom lst:CompoundStage ;
  p:order 1 .

ls:compoundRegistration a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Registration" ;
  rdfs:comment "The registration of a compound." ;
  p:dimensionOf ls:Compound ;
  p:valuesFrom lst:CompoundRegistration ;
  p:order 2 .

ls:Simulation a p:ObjectType, rdfs:Class ;
  rdfs:label "Simulation" ;
  p:pluralLabel "Simulations" ;
  rdfs:comment "An in silico run predicting a compound's properties." ;
  p:inDomain ls:ScientificInnovation ;
  p:titleTemplate "{ls:modelType} prediction for {ls:predicts}" .

ls:simulationRun a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Run" ;
  rdfs:comment "The run of a simulation." ;
  p:dimensionOf ls:Simulation ;
  p:valuesFrom lst:SimulationRun ;
  p:order 1 .

ls:simulationReview a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Review" ;
  rdfs:comment "The review of a simulation." ;
  p:dimensionOf ls:Simulation ;
  p:valuesFrom lst:SimulationReview ;
  p:order 2 .

ls:Experiment a p:ObjectType, rdfs:Class ;
  rdfs:label "Experiment" ;
  p:pluralLabel "Experiments" ;
  rdfs:comment "A lab experiment recorded in an electronic notebook." ;
  p:inDomain ls:ScientificInnovation ;
  skos:closeMatch ncit:C42790 ;
  p:titleTemplate "{ls:aim}, {ls:tests}" .

ls:experimentRecord a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Record" ;
  rdfs:comment "The record of a experiment." ;
  p:dimensionOf ls:Experiment ;
  p:valuesFrom lst:ExperimentRecord ;
  p:order 1 .

ls:experimentSignOff a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Sign-off" ;
  rdfs:comment "The sign-off of a experiment." ;
  p:dimensionOf ls:Experiment ;
  p:valuesFrom lst:ExperimentSignOff ;
  p:order 2 .

ls:AssayResult a p:ObjectType, rdfs:Class ;
  rdfs:label "Assay Result" ;
  p:pluralLabel "Assay Results" ;
  rdfs:comment "A measured property from an experiment." ;
  p:inDomain ls:ScientificInnovation ;
  p:titleTemplate "{ls:resultValue}" .

ls:assayResultValidity a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Validity" ;
  rdfs:comment "The validity of a assay result." ;
  p:dimensionOf ls:AssayResult ;
  p:valuesFrom lst:AssayResultValidity ;
  p:order 1 .

ls:Formulation a p:ObjectType, rdfs:Class ;
  rdfs:label "Formulation" ;
  p:pluralLabel "Formulations" ;
  rdfs:comment "A compound combined with other ingredients into a product." ;
  p:inDomain ls:ScientificInnovation ;
  p:titleTemplate "{ls:formulationName}" .

ls:formulationStage a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Stage" ;
  rdfs:comment "The stage of a formulation." ;
  p:dimensionOf ls:Formulation ;
  p:valuesFrom lst:FormulationStage ;
  p:order 1 .

ls:Process a p:ObjectType, rdfs:Class ;
  rdfs:label "Process" ;
  p:pluralLabel "Processes" ;
  rdfs:comment "The approved way a formulation is manufactured." ;
  p:inDomain ls:ScientificInnovation ;
  p:titleTemplate "Manufacturing process for {ls:manufactures}" .

ls:processStatus a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Status" ;
  rdfs:comment "The status of a process." ;
  p:dimensionOf ls:Process ;
  p:valuesFrom lst:ProcessStatus ;
  p:order 1 .

ls:Batch a p:ObjectType, rdfs:Class ;
  rdfs:label "Batch" ;
  p:pluralLabel "Batches" ;
  rdfs:comment "One manufactured lot of a formulation." ;
  p:inDomain ls:ScientificInnovation ;
  skos:exactMatch ncit:C41396 ;
  p:titleTemplate "Lot {ls:lotNumber}" .

ls:batchProduction a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Production" ;
  rdfs:comment "The production of a batch." ;
  p:dimensionOf ls:Batch ;
  p:valuesFrom lst:BatchProduction ;
  p:order 1 .

ls:batchQuality a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Quality" ;
  rdfs:comment "The quality of a batch." ;
  p:dimensionOf ls:Batch ;
  p:valuesFrom lst:BatchQuality ;
  p:order 2 .

ls:batchDeviationRisk a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Deviation risk" ;
  rdfs:comment "The deviation risk of a batch." ;
  p:dimensionOf ls:Batch ;
  p:valuesFrom lst:BatchDeviationRisk ;
  p:order 3 .

ls:Study a p:ObjectType, rdfs:Class ;
  rdfs:label "Study" ;
  p:pluralLabel "Studies" ;
  rdfs:comment "A clinical trial of one or more formulations, in patients or in people without the disease." ;
  p:inDomain ls:ClinicalDevelopment ;
  skos:closeMatch ncit:C15206 ;
  p:titleTemplate "{ls:studyTitle}" .

ls:studyPhase a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Phase" ;
  rdfs:comment "The phase of a study." ;
  p:dimensionOf ls:Study ;
  p:valuesFrom lst:StudyPhase ;
  p:order 1 .

ls:studyStatus a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Status" ;
  rdfs:comment "The status of a study." ;
  p:dimensionOf ls:Study ;
  p:valuesFrom lst:StudyStatus ;
  p:order 2 .

ls:studyBlinding a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Blinding" ;
  rdfs:comment "The blinding of a study." ;
  p:dimensionOf ls:Study ;
  p:valuesFrom lst:StudyBlinding ;
  p:order 3 .

ls:Protocol a p:ObjectType, rdfs:Class ;
  rdfs:label "Protocol" ;
  p:pluralLabel "Protocols" ;
  rdfs:comment "The plan a study is conducted under: its objectives, design, eligibility and schedule of assessments. Each version is its own protocol; an amendment is a new version that amends the one before it." ;
  p:inDomain ls:ClinicalDevelopment ;
  skos:exactMatch ncit:C70817 ;
  p:titleTemplate "{ls:protocolName}, version {ls:protocolVersion} | Amendment to {ls:amends:id}" .

ls:protocolStatus a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Status" ;
  rdfs:comment "The status of a protocol." ;
  p:dimensionOf ls:Protocol ;
  p:valuesFrom lst:ProtocolStatus ;
  p:order 1 .

ls:Site a p:ObjectType, rdfs:Class ;
  rdfs:label "Site" ;
  p:pluralLabel "Sites" ;
  rdfs:comment "A hospital or clinic running the study." ;
  p:inDomain ls:ClinicalDevelopment ;
  skos:exactMatch ncit:C85838 ;
  p:titleTemplate "{ls:siteName}" .

ls:siteStatus a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Status" ;
  rdfs:comment "The status of a site." ;
  p:dimensionOf ls:Site ;
  p:valuesFrom lst:SiteStatus ;
  p:order 1 .

ls:sitePayment a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Payment" ;
  rdfs:comment "The payment of a site." ;
  p:dimensionOf ls:Site ;
  p:valuesFrom lst:SitePayment ;
  p:order 2 .

ls:Patient a p:ObjectType, rdfs:Class ;
  rdfs:label "Patient" ;
  p:pluralLabel "Patients" ;
  rdfs:comment "A person enrolled in a study. Labeled participant in studies without a disease state." ;
  p:inDomain ls:ClinicalDevelopment ;
  skos:closeMatch ncit:C16960 ;
  p:holdsPersonalData true ;
  p:titleTemplate "Patient at {ls:enrolledAt}" .

ls:patientEnrollment a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Enrollment" ;
  rdfs:comment "The enrollment of a patient." ;
  p:dimensionOf ls:Patient ;
  p:valuesFrom lst:PatientEnrollment ;
  p:order 1 .

ls:patientArm a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Arm" ;
  rdfs:comment "The arm of a patient." ;
  p:dimensionOf ls:Patient ;
  p:valuesFrom lst:PatientArm ;
  p:order 2 .

ls:patientArmVisibility a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Arm visibility" ;
  rdfs:comment "The arm visibility of a patient." ;
  p:dimensionOf ls:Patient ;
  p:valuesFrom lst:PatientArmVisibility ;
  p:order 3 .

ls:Visit a p:ObjectType, rdfs:Class ;
  rdfs:label "Visit" ;
  p:pluralLabel "Visits" ;
  rdfs:comment "A scheduled encounter with a patient." ;
  p:inDomain ls:ClinicalDevelopment ;
  skos:exactMatch ncit:C191214 ;
  p:holdsPersonalData true ;
  p:titleTemplate "{ls:visitName} for {ls:visitFor:id} | Visit for {ls:visitFor:id}" .

ls:visitStatus a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Status" ;
  rdfs:comment "The status of a visit." ;
  p:dimensionOf ls:Visit ;
  p:valuesFrom lst:VisitStatus ;
  p:order 1 .

ls:DataRecord a p:ObjectType, rdfs:Class ;
  rdfs:label "Data Record" ;
  p:pluralLabel "Data Records" ;
  rdfs:comment "A captured data point: a lab value, vital sign, diary entry or device reading." ;
  p:inDomain ls:ClinicalDevelopment ;
  p:holdsPersonalData true ;
  p:titleTemplate "{ls:recordedValue} | Data point at {ls:capturedAt:id}" .

ls:dataRecordEntry a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Entry" ;
  rdfs:comment "The entry of a data record." ;
  p:dimensionOf ls:DataRecord ;
  p:valuesFrom lst:DataRecordEntry ;
  p:order 1 .

ls:dataRecordSource a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Source" ;
  rdfs:comment "The source of a data record." ;
  p:dimensionOf ls:DataRecord ;
  p:valuesFrom lst:DataRecordSource ;
  p:order 2 .

ls:DataQuery a p:ObjectType, rdfs:Class ;
  rdfs:label "Data Query" ;
  p:pluralLabel "Data Queries" ;
  rdfs:comment "A question raised about a data record." ;
  p:inDomain ls:ClinicalDevelopment ;
  p:titleTemplate "{ls:queryText} | Query on {ls:raisedOn:id}" .

ls:dataQueryStatus a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Status" ;
  rdfs:comment "The status of a data query." ;
  p:dimensionOf ls:DataQuery ;
  p:valuesFrom lst:DataQueryStatus ;
  p:order 1 .

ls:AdverseEvent a p:ObjectType, rdfs:Class ;
  rdfs:label "Adverse Event" ;
  p:pluralLabel "Adverse Events" ;
  rdfs:comment "Something harmful that happened to a patient during the study." ;
  p:inDomain ls:ClinicalDevelopment ;
  skos:exactMatch ncit:C41331 ;
  p:holdsPersonalData true ;
  p:titleTemplate "{ls:verbatimTerm} | Adverse event for {ls:experiencedBy:id}" .

ls:adverseEventEntry a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Entry" ;
  rdfs:comment "The entry of a adverse event." ;
  p:dimensionOf ls:AdverseEvent ;
  p:valuesFrom lst:AdverseEventEntry ;
  p:order 1 .

ls:adverseEventSeriousness a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Seriousness" ;
  rdfs:comment "The seriousness of a adverse event." ;
  p:dimensionOf ls:AdverseEvent ;
  p:valuesFrom lst:AdverseEventSeriousness ;
  p:order 2 .

ls:adverseEventOutcome a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Outcome" ;
  rdfs:comment "The outcome of a adverse event." ;
  p:dimensionOf ls:AdverseEvent ;
  p:valuesFrom lst:AdverseEventOutcome ;
  p:order 3 .

ls:adverseEventReporting a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Reporting" ;
  rdfs:comment "The reporting of a adverse event." ;
  p:dimensionOf ls:AdverseEvent ;
  p:valuesFrom lst:AdverseEventReporting ;
  p:order 4 .

ls:SafetyCase a p:ObjectType, rdfs:Class ;
  rdfs:label "Safety Case" ;
  p:pluralLabel "Safety Cases" ;
  rdfs:comment "One report of an adverse reaction in one patient." ;
  p:inDomain ls:SafetyAndRegulatory ;
  p:holdsPersonalData true ;
  p:titleTemplate "{ls:reaction} with {ls:concerns} | Case from {ls:originatesFrom:id} | Case for {ls:concerns}" .

ls:safetyCaseWorkflow a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Workflow" ;
  rdfs:comment "The workflow of a safety case." ;
  p:dimensionOf ls:SafetyCase ;
  p:valuesFrom lst:SafetyCaseWorkflow ;
  p:order 1 .

ls:safetyCaseSeriousness a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Seriousness" ;
  rdfs:comment "The seriousness of a safety case." ;
  p:dimensionOf ls:SafetyCase ;
  p:valuesFrom lst:SafetyCaseSeriousness ;
  p:order 2 .

ls:safetyCaseExpectedness a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Expectedness" ;
  rdfs:comment "The expectedness of a safety case." ;
  p:dimensionOf ls:SafetyCase ;
  p:valuesFrom lst:SafetyCaseExpectedness ;
  p:order 3 .

ls:safetyCaseCausality a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Causality" ;
  rdfs:comment "The causality of a safety case." ;
  p:dimensionOf ls:SafetyCase ;
  p:valuesFrom lst:SafetyCaseCausality ;
  p:order 4 .

ls:Product a p:ObjectType, rdfs:Class ;
  rdfs:label "Product" ;
  p:pluralLabel "Products" ;
  rdfs:comment "A marketed or investigational product." ;
  p:inDomain ls:SafetyAndRegulatory ;
  skos:closeMatch ncit:C221818 ;
  p:titleTemplate "{ls:productName}" .

ls:productStatus a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Status" ;
  rdfs:comment "The status of a product." ;
  p:dimensionOf ls:Product ;
  p:valuesFrom lst:ProductStatus ;
  p:order 1 .

ls:Signal a p:ObjectType, rdfs:Class ;
  rdfs:label "Signal" ;
  p:pluralLabel "Signals" ;
  rdfs:comment "A possible new risk detected across many cases." ;
  p:inDomain ls:SafetyAndRegulatory ;
  p:titleTemplate "{ls:reaction} with {ls:concerns} | Signal for {ls:concerns}" .

ls:signalStatus a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Status" ;
  rdfs:comment "The status of a signal." ;
  p:dimensionOf ls:Signal ;
  p:valuesFrom lst:SignalStatus ;
  p:order 1 .

ls:Submission a p:ObjectType, rdfs:Class ;
  rdfs:label "Submission" ;
  p:pluralLabel "Submissions" ;
  rdfs:comment "A regulatory filing to an authority." ;
  p:inDomain ls:SafetyAndRegulatory ;
  skos:exactMatch ncit:C70885 ;
  p:titleTemplate "Expedited report for {ls:reports:id}" .

ls:submissionStatus a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Status" ;
  rdfs:comment "The status of a submission." ;
  p:dimensionOf ls:Submission ;
  p:valuesFrom lst:SubmissionStatus ;
  p:order 1 .

ls:submissionDeadline a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Deadline" ;
  rdfs:comment "The deadline of a submission." ;
  p:dimensionOf ls:Submission ;
  p:valuesFrom lst:SubmissionDeadline ;
  p:order 2 .

ls:QualityEvent a p:ObjectType, rdfs:Class ;
  rdfs:label "Quality Event" ;
  p:pluralLabel "Quality Events" ;
  rdfs:comment "A deviation, complaint or audit finding." ;
  p:inDomain ls:SafetyAndRegulatory ;
  p:titleTemplate "{ls:eventDescription} | Quality event on {ls:raisedOn:id}" .

ls:qualityEventStatus a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Status" ;
  rdfs:comment "The status of a quality event." ;
  p:dimensionOf ls:QualityEvent ;
  p:valuesFrom lst:QualityEventStatus ;
  p:order 1 .

ls:qualityEventSeverity a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Severity" ;
  rdfs:comment "The severity of a quality event." ;
  p:dimensionOf ls:QualityEvent ;
  p:valuesFrom lst:QualityEventSeverity ;
  p:order 2 .

ls:CAPA a p:ObjectType, rdfs:Class ;
  rdfs:label "CAPA" ;
  p:pluralLabel "CAPAs" ;
  rdfs:comment "A corrective and preventive action." ;
  p:inDomain ls:SafetyAndRegulatory ;
  p:titleTemplate "{ls:capaAction} | CAPA for {ls:resolves:id}" .

ls:capaStatus a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Status" ;
  rdfs:comment "The status of a capa." ;
  p:dimensionOf ls:CAPA ;
  p:valuesFrom lst:CAPAStatus ;
  p:order 1 .

ls:MedicalInquiry a p:ObjectType, rdfs:Class ;
  rdfs:label "Medical Inquiry" ;
  p:pluralLabel "Medical Inquiries" ;
  rdfs:comment "A question from a clinician or patient about a product." ;
  p:inDomain ls:SafetyAndRegulatory ;
  p:holdsPersonalData true ;
  p:titleTemplate "{ls:inquiryText}" .

ls:medicalInquiryStatus a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Status" ;
  rdfs:comment "The status of a medical inquiry." ;
  p:dimensionOf ls:MedicalInquiry ;
  p:valuesFrom lst:MedicalInquiryStatus ;
  p:order 1 .

ls:predicts a p:Relationship, owl:ObjectProperty ;
  rdfs:label "predicts" ;
  p:inverseLabel "is predicted by" ;
  p:order 1 ;
  rdfs:comment "A simulation predicts properties of a compound." .

ls:tests a p:Relationship, owl:ObjectProperty ;
  rdfs:label "tests" ;
  p:inverseLabel "is tested in" ;
  p:order 2 ;
  rdfs:comment "An experiment tests a compound; a study tests a formulation." .

ls:produces a p:Relationship, owl:ObjectProperty ;
  rdfs:label "produces" ;
  p:inverseLabel "is produced by" ;
  p:order 3 ;
  p:hasPart true ;
  rdfs:comment "An experiment produces an assay result." .

ls:contains a p:Relationship, owl:ObjectProperty ;
  rdfs:label "contains" ;
  p:inverseLabel "is contained in" ;
  p:order 4 ;
  rdfs:comment "A formulation contains a compound." .

ls:manufactures a p:Relationship, owl:ObjectProperty ;
  rdfs:label "manufactures" ;
  p:inverseLabel "is manufactured by" ;
  p:order 5 ;
  rdfs:comment "A process manufactures a formulation." .

ls:follows a p:Relationship, owl:ObjectProperty ;
  rdfs:label "follows" ;
  p:inverseLabel "is followed by" ;
  p:order 6 ;
  rdfs:comment "A batch is made by following a process." .

ls:derivedFrom a p:Relationship, owl:ObjectProperty ;
  rdfs:label "derived from" ;
  p:inverseLabel "is the source of" ;
  p:order 7 ;
  rdfs:comment "A compound is an analog derived from another." .

ls:runsAt a p:Relationship, owl:ObjectProperty ;
  rdfs:label "runs at" ;
  p:inverseLabel "hosts" ;
  p:order 8 ;
  rdfs:comment "A study runs at a site." .

ls:conductedUnder a p:Relationship, owl:ObjectProperty ;
  rdfs:label "conducted under" ;
  p:inverseLabel "governs" ;
  p:order 9 ;
  rdfs:comment "A study is conducted under the protocol version in force." .

ls:amends a p:Relationship, owl:ObjectProperty ;
  rdfs:label "amends" ;
  p:inverseLabel "is amended by" ;
  p:order 10 ;
  rdfs:comment "A protocol version amends the version before it." .

ls:enrolledIn a p:Relationship, owl:ObjectProperty ;
  rdfs:label "enrolled in" ;
  p:inverseLabel "enrolls" ;
  p:order 11 ;
  p:partOf true ;
  rdfs:comment "A patient is enrolled in a study." .

ls:enrolledAt a p:Relationship, owl:ObjectProperty ;
  rdfs:label "enrolled at" ;
  p:inverseLabel "enrolls" ;
  p:order 12 ;
  rdfs:comment "A patient is enrolled at a site." .

ls:receives a p:Relationship, owl:ObjectProperty ;
  rdfs:label "receives" ;
  p:inverseLabel "is received by" ;
  p:order 13 ;
  rdfs:comment "A patient receives study drug from a batch." .

ls:visitFor a p:Relationship, owl:ObjectProperty ;
  rdfs:label "for" ;
  p:inverseLabel "has" ;
  p:order 14 ;
  p:partOf true ;
  rdfs:comment "A visit is for a patient." .

ls:capturedAt a p:Relationship, owl:ObjectProperty ;
  rdfs:label "captured at" ;
  p:inverseLabel "captures" ;
  p:order 15 ;
  p:partOf true ;
  rdfs:comment "A data record is captured at a visit." .

ls:raisedOn a p:Relationship, owl:ObjectProperty ;
  rdfs:label "raised on" ;
  p:inverseLabel "has" ;
  p:order 16 ;
  p:partOf true ;
  rdfs:comment "A data query is raised on a data record; a quality event on a batch." .

ls:experiencedBy a p:Relationship, owl:ObjectProperty ;
  rdfs:label "experienced by" ;
  p:inverseLabel "experienced" ;
  p:order 17 ;
  p:partOf true ;
  rdfs:comment "An adverse event is experienced by a patient." .

ls:originatesFrom a p:Relationship, owl:ObjectProperty ;
  rdfs:label "originates from" ;
  p:inverseLabel "is the source of" ;
  p:order 18 ;
  rdfs:comment "A safety case originates from an adverse event or a medical inquiry." .

ls:concerns a p:Relationship, owl:ObjectProperty ;
  rdfs:label "concerns" ;
  p:inverseLabel "is named in" ;
  p:order 19 ;
  rdfs:comment "A safety case or signal concerns a product." .

ls:isFormulation a p:Relationship, owl:ObjectProperty ;
  rdfs:label "is" ;
  p:inverseLabel "is marketed as" ;
  p:order 20 ;
  rdfs:comment "A product is a formulation." .

ls:mayInvolve a p:Relationship, owl:ObjectProperty ;
  rdfs:label "may involve" ;
  p:inverseLabel "may be involved in" ;
  p:order 21 ;
  rdfs:comment "A safety case may involve a batch." .

ls:aggregates a p:Relationship, owl:ObjectProperty ;
  rdfs:label "aggregates" ;
  p:inverseLabel "is aggregated in" ;
  p:order 22 ;
  rdfs:comment "A signal aggregates safety cases." .

ls:reports a p:Relationship, owl:ObjectProperty ;
  rdfs:label "reports" ;
  p:inverseLabel "is reported in" ;
  p:order 23 ;
  rdfs:comment "A submission reports a safety case or a signal." .

ls:resolves a p:Relationship, owl:ObjectProperty ;
  rdfs:label "resolves" ;
  p:inverseLabel "is resolved by" ;
  p:order 24 ;
  p:partOf true ;
  rdfs:comment "A CAPA resolves a quality event." .

ls:duplicateOf a p:Relationship, owl:ObjectProperty ;
  rdfs:label "duplicate of" ;
  p:inverseLabel "is duplicated by" ;
  p:order 25 ;
  rdfs:comment "A safety case duplicates another." .

ls:reaction a owl:ObjectProperty ;
  rdfs:label "reaction" ;
  rdfs:comment "An adverse reaction, coded. A case may have several; a signal is for one." ;
  p:valuesFrom lst:Reaction .

ls:compoundName a owl:DatatypeProperty ;
  rdfs:label "name" ;
  rdfs:comment "The compound's code and what it is." .

ls:modelType a owl:DatatypeProperty ;
  rdfs:label "model type" ;
  rdfs:comment "The kind of model the simulation ran, such as ADMET." .

ls:aim a owl:DatatypeProperty ;
  rdfs:label "aim" ;
  rdfs:comment "What the experiment set out to measure." .

ls:resultValue a owl:DatatypeProperty ;
  rdfs:label "result" ;
  rdfs:comment "The measured result, with its units." .

ls:formulationName a owl:DatatypeProperty ;
  rdfs:label "name" ;
  rdfs:comment "The formulation's name: product, strength and dosage form." .

ls:lotNumber a owl:DatatypeProperty ;
  rdfs:label "lot number" ;
  rdfs:comment "The batch's lot number." .

ls:studyTitle a owl:DatatypeProperty ;
  rdfs:label "title" ;
  rdfs:comment "The study's short name and title." .

ls:siteName a owl:DatatypeProperty ;
  rdfs:label "name" ;
  rdfs:comment "The site's name." .

ls:protocolName a owl:DatatypeProperty ;
  rdfs:label "name" ;
  rdfs:comment "The protocol's short name, usually the study's." .

ls:protocolVersion a owl:DatatypeProperty ;
  rdfs:label "version" ;
  rdfs:comment "The protocol's version number, such as 2.0." .

ls:primaryObjective a owl:DatatypeProperty ;
  rdfs:label "primary objective" ;
  rdfs:comment "What the study must show, as the protocol states it." .

ls:plannedEnrollment a owl:DatatypeProperty ;
  rdfs:label "planned enrollment" ;
  rdfs:comment "How many patients the protocol plans to enroll." .

ls:effectiveOn a owl:DatatypeProperty ;
  rdfs:label "effective on" ;
  rdfs:comment "The date the version came into force." .

ls:reporterNote a owl:DatatypeProperty ;
  rdfs:label "note from the reporter" ;
  rdfs:comment "What the clinical team told safety when it reported the event." .

ls:amendmentSummary a owl:DatatypeProperty ;
  rdfs:label "amendment summary" ;
  rdfs:comment "What an amendment changes, and why." .

ls:visitName a owl:DatatypeProperty ;
  rdfs:label "visit" ;
  rdfs:comment "The visit's name in the schedule of assessments, such as Week 12 visit." .

ls:queryText a owl:DatatypeProperty ;
  rdfs:label "question" ;
  rdfs:comment "What the query asks the site." .

ls:productName a owl:DatatypeProperty ;
  rdfs:label "name" ;
  rdfs:comment "The product's name and strength." .

ls:eventDescription a owl:DatatypeProperty ;
  rdfs:label "description" ;
  rdfs:comment "What happened, as recorded when the event was opened." .

ls:capaAction a owl:DatatypeProperty ;
  rdfs:label "action" ;
  rdfs:comment "The corrective or preventive action to take." .

ls:inquiryText a owl:DatatypeProperty ;
  rdfs:label "question" ;
  rdfs:comment "What the clinician or patient asked." .

ls:receivedOn a owl:DatatypeProperty ;
  rdfs:label "received on" ;
  rdfs:comment "The date the safety case was received." .

ls:narrative a owl:DatatypeProperty ;
  rdfs:label "narrative" ;
  rdfs:comment "The case narrative, as a person accepted it." .

ls:dueOn a owl:DatatypeProperty ;
  rdfs:label "due on" ;
  rdfs:comment "The date the submission is due." ;
  p:isDeadline true .

ls:scheduledOn a owl:DatatypeProperty ;
  rdfs:label "scheduled on" ;
  rdfs:comment "The date the visit is scheduled for. A deadline until the visit is completed or missed." ;
  p:isDeadline true .

ls:recordedValue a owl:DatatypeProperty ;
  rdfs:label "value" ;
  rdfs:comment "The value captured, as recorded at the site." .

ls:verbatimTerm a owl:DatatypeProperty ;
  rdfs:label "verbatim term" ;
  rdfs:comment "The event as the site reported it, in its own words, before coding." .

ls:missedReason a owl:DatatypeProperty ;
  rdfs:label "reason missed" ;
  rdfs:comment "Why the visit did not take place." .

ls:preparedBy a owl:ObjectProperty ;
  rdfs:label "prepared by" ;
  rdfs:comment "The person who prepared the submission." .

ls:assignedArm a owl:DatatypeProperty ;
  rdfs:label "assigned arm" ;
  rdfs:comment "The study arm the patient was randomized to. Hidden while the study is blinded (rule 2)." .

# Shapes

lsh:Compound-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:Compound-stage a sh:PropertyShape ;
  sh:path ls:compoundStage ;
  sh:in ( lst:CompoundStage-designed lst:CompoundStage-synthesized lst:CompoundStage-tested lst:CompoundStage-candidate lst:CompoundStage-retired ) ;
  sh:maxCount 1 ;
  sh:name "Stage" .

lsh:Compound-registration a sh:PropertyShape ;
  sh:path ls:compoundRegistration ;
  sh:in ( lst:CompoundRegistration-unregistered lst:CompoundRegistration-registered ) ;
  sh:maxCount 1 ;
  sh:name "Registration" .

lsh:Compound-derivedFrom a sh:PropertyShape ;
  sh:path ls:derivedFrom ;
  sh:class ls:Compound ;
  sh:maxCount 1 ;
  sh:name "derived from" .

lsh:Compound-compoundName a sh:PropertyShape ;
  sh:path ls:compoundName ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "name" .

lsh:Compound a sh:NodeShape ;
  sh:targetClass ls:Compound ;
  sh:property lsh:Compound-identifier, lsh:Compound-stage, lsh:Compound-registration, lsh:Compound-derivedFrom, lsh:Compound-compoundName .

lsh:Simulation-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:Simulation-run a sh:PropertyShape ;
  sh:path ls:simulationRun ;
  sh:in ( lst:SimulationRun-queued lst:SimulationRun-running lst:SimulationRun-complete lst:SimulationRun-failed ) ;
  sh:maxCount 1 ;
  sh:name "Run" .

lsh:Simulation-review a sh:PropertyShape ;
  sh:path ls:simulationReview ;
  sh:in ( lst:SimulationReview-unreviewed lst:SimulationReview-accepted lst:SimulationReview-rejected ) ;
  sh:maxCount 1 ;
  sh:name "Review" .

lsh:Simulation-predicts a sh:PropertyShape ;
  sh:path ls:predicts ;
  sh:class ls:Compound ;
  sh:maxCount 1 ;
  sh:name "predicts" .

lsh:Simulation-modelType a sh:PropertyShape ;
  sh:path ls:modelType ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "model type" .

lsh:Simulation a sh:NodeShape ;
  sh:targetClass ls:Simulation ;
  sh:property lsh:Simulation-identifier, lsh:Simulation-run, lsh:Simulation-review, lsh:Simulation-predicts, lsh:Simulation-modelType .

lsh:Experiment-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:Experiment-record a sh:PropertyShape ;
  sh:path ls:experimentRecord ;
  sh:in ( lst:ExperimentRecord-planned lst:ExperimentRecord-inProgress lst:ExperimentRecord-complete ) ;
  sh:maxCount 1 ;
  sh:name "Record" .

lsh:Experiment-signOff a sh:PropertyShape ;
  sh:path ls:experimentSignOff ;
  sh:in ( lst:ExperimentSignOff-unsigned lst:ExperimentSignOff-signed lst:ExperimentSignOff-witnessed ) ;
  sh:maxCount 1 ;
  sh:name "Sign-off" .

lsh:Experiment-tests a sh:PropertyShape ;
  sh:path ls:tests ;
  sh:class ls:Compound ;
  sh:name "tests" .

lsh:Experiment-produces a sh:PropertyShape ;
  sh:path ls:produces ;
  sh:class ls:AssayResult ;
  sh:name "produces" .

lsh:Experiment-aim a sh:PropertyShape ;
  sh:path ls:aim ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "aim" .

lsh:Experiment a sh:NodeShape ;
  sh:targetClass ls:Experiment ;
  sh:property lsh:Experiment-identifier, lsh:Experiment-record, lsh:Experiment-signOff, lsh:Experiment-tests, lsh:Experiment-produces, lsh:Experiment-aim .

lsh:AssayResult-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:AssayResult-validity a sh:PropertyShape ;
  sh:path ls:assayResultValidity ;
  sh:in ( lst:AssayResultValidity-valid lst:AssayResultValidity-invalidated ) ;
  sh:maxCount 1 ;
  sh:name "Validity" .

lsh:AssayResult-resultValue a sh:PropertyShape ;
  sh:path ls:resultValue ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "result" .

lsh:AssayResult a sh:NodeShape ;
  sh:targetClass ls:AssayResult ;
  sh:property lsh:AssayResult-identifier, lsh:AssayResult-validity, lsh:AssayResult-resultValue .

lsh:Formulation-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:Formulation-stage a sh:PropertyShape ;
  sh:path ls:formulationStage ;
  sh:in ( lst:FormulationStage-draft lst:FormulationStage-underTest lst:FormulationStage-approved lst:FormulationStage-obsolete ) ;
  sh:maxCount 1 ;
  sh:name "Stage" .

lsh:Formulation-contains a sh:PropertyShape ;
  sh:path ls:contains ;
  sh:class ls:Compound ;
  sh:name "contains" .

lsh:Formulation-formulationName a sh:PropertyShape ;
  sh:path ls:formulationName ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "name" .

lsh:Formulation a sh:NodeShape ;
  sh:targetClass ls:Formulation ;
  sh:property lsh:Formulation-identifier, lsh:Formulation-stage, lsh:Formulation-contains, lsh:Formulation-formulationName .

lsh:Process-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:Process-status a sh:PropertyShape ;
  sh:path ls:processStatus ;
  sh:in ( lst:ProcessStatus-draft lst:ProcessStatus-validated lst:ProcessStatus-superseded ) ;
  sh:maxCount 1 ;
  sh:name "Status" .

lsh:Process-manufactures a sh:PropertyShape ;
  sh:path ls:manufactures ;
  sh:class ls:Formulation ;
  sh:maxCount 1 ;
  sh:name "manufactures" .

lsh:Process a sh:NodeShape ;
  sh:targetClass ls:Process ;
  sh:property lsh:Process-identifier, lsh:Process-status, lsh:Process-manufactures .

lsh:Batch-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:Batch-production a sh:PropertyShape ;
  sh:path ls:batchProduction ;
  sh:in ( lst:BatchProduction-planned lst:BatchProduction-inProduction lst:BatchProduction-complete ) ;
  sh:maxCount 1 ;
  sh:name "Production" .

lsh:Batch-quality a sh:PropertyShape ;
  sh:path ls:batchQuality ;
  sh:in ( lst:BatchQuality-pending lst:BatchQuality-released lst:BatchQuality-quarantined lst:BatchQuality-rejected ) ;
  sh:maxCount 1 ;
  sh:name "Quality" .

lsh:Batch-deviationRisk a sh:PropertyShape ;
  sh:path ls:batchDeviationRisk ;
  sh:in ( lst:BatchDeviationRisk-low lst:BatchDeviationRisk-elevated lst:BatchDeviationRisk-high ) ;
  sh:maxCount 1 ;
  sh:name "Deviation risk" .

lsh:Batch-follows a sh:PropertyShape ;
  sh:path ls:follows ;
  sh:class ls:Process ;
  sh:maxCount 1 ;
  sh:name "follows" .

lsh:Batch-lotNumber a sh:PropertyShape ;
  sh:path ls:lotNumber ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "lot number" .

lsh:Batch a sh:NodeShape ;
  sh:targetClass ls:Batch ;
  sh:property lsh:Batch-identifier, lsh:Batch-production, lsh:Batch-quality, lsh:Batch-deviationRisk, lsh:Batch-follows, lsh:Batch-lotNumber .

lsh:Study-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:Study-phase a sh:PropertyShape ;
  sh:path ls:studyPhase ;
  sh:in ( lst:StudyPhase-i lst:StudyPhase-ii lst:StudyPhase-iii ) ;
  sh:maxCount 1 ;
  sh:name "Phase" .

lsh:Study-status a sh:PropertyShape ;
  sh:path ls:studyStatus ;
  sh:in ( lst:StudyStatus-planned lst:StudyStatus-enrolling lst:StudyStatus-active lst:StudyStatus-closed lst:StudyStatus-locked ) ;
  sh:maxCount 1 ;
  sh:name "Status" .

lsh:Study-blinding a sh:PropertyShape ;
  sh:path ls:studyBlinding ;
  sh:in ( lst:StudyBlinding-blinded lst:StudyBlinding-unblinded ) ;
  sh:maxCount 1 ;
  sh:name "Blinding" .

lsh:Study-tests a sh:PropertyShape ;
  sh:path ls:tests ;
  sh:class ls:Formulation ;
  sh:name "tests" .

lsh:Study-runsAt a sh:PropertyShape ;
  sh:path ls:runsAt ;
  sh:class ls:Site ;
  sh:name "runs at" .

lsh:Study-conductedUnder a sh:PropertyShape ;
  sh:path ls:conductedUnder ;
  sh:class ls:Protocol ;
  sh:maxCount 1 ;
  sh:name "conducted under" .

lsh:Study-studyTitle a sh:PropertyShape ;
  sh:path ls:studyTitle ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "title" .

lsh:Study a sh:NodeShape ;
  sh:targetClass ls:Study ;
  sh:property lsh:Study-identifier, lsh:Study-phase, lsh:Study-status, lsh:Study-blinding, lsh:Study-tests, lsh:Study-runsAt, lsh:Study-conductedUnder, lsh:Study-studyTitle, lsh:Study-belongsTo, lsh:Study-baselineFrom .

lsh:Protocol-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:Protocol-status a sh:PropertyShape ;
  sh:path ls:protocolStatus ;
  sh:in ( lst:ProtocolStatus-draft lst:ProtocolStatus-inReview lst:ProtocolStatus-approved lst:ProtocolStatus-superseded ) ;
  sh:maxCount 1 ;
  sh:name "Status" .

lsh:Protocol-amends a sh:PropertyShape ;
  sh:path ls:amends ;
  sh:class ls:Protocol ;
  sh:maxCount 1 ;
  sh:name "amends" .

lsh:Protocol-protocolName a sh:PropertyShape ;
  sh:path ls:protocolName ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "name" .

lsh:Protocol-protocolVersion a sh:PropertyShape ;
  sh:path ls:protocolVersion ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "version" .

lsh:Protocol-primaryObjective a sh:PropertyShape ;
  sh:path ls:primaryObjective ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "primary objective" .

lsh:Protocol-plannedEnrollment a sh:PropertyShape ;
  sh:path ls:plannedEnrollment ;
  sh:datatype xsd:integer ;
  sh:maxCount 1 ;
  sh:name "planned enrollment" .

lsh:Protocol-effectiveOn a sh:PropertyShape ;
  sh:path ls:effectiveOn ;
  sh:datatype xsd:date ;
  sh:maxCount 1 ;
  sh:name "effective on" .

lsh:Protocol-amendmentSummary a sh:PropertyShape ;
  sh:path ls:amendmentSummary ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "amendment summary" .

lsh:Protocol a sh:NodeShape ;
  sh:targetClass ls:Protocol ;
  sh:property lsh:Protocol-identifier, lsh:Protocol-status, lsh:Protocol-amends, lsh:Protocol-protocolName, lsh:Protocol-protocolVersion, lsh:Protocol-primaryObjective, lsh:Protocol-plannedEnrollment, lsh:Protocol-effectiveOn, lsh:Protocol-amendmentSummary .

lsh:Site-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:Site-status a sh:PropertyShape ;
  sh:path ls:siteStatus ;
  sh:in ( lst:SiteStatus-selected lst:SiteStatus-activated lst:SiteStatus-closed ) ;
  sh:maxCount 1 ;
  sh:name "Status" .

lsh:Site-payment a sh:PropertyShape ;
  sh:path ls:sitePayment ;
  sh:in ( lst:SitePayment-current lst:SitePayment-overdue ) ;
  sh:maxCount 1 ;
  sh:name "Payment" .

lsh:Site-siteName a sh:PropertyShape ;
  sh:path ls:siteName ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "name" .

lsh:Site a sh:NodeShape ;
  sh:targetClass ls:Site ;
  sh:property lsh:Site-identifier, lsh:Site-status, lsh:Site-payment, lsh:Site-siteName .

lsh:Patient-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:Patient-enrollment a sh:PropertyShape ;
  sh:path ls:patientEnrollment ;
  sh:in ( lst:PatientEnrollment-screened lst:PatientEnrollment-consented lst:PatientEnrollment-randomized lst:PatientEnrollment-completed lst:PatientEnrollment-withdrawn ) ;
  sh:maxCount 1 ;
  sh:name "Enrollment" .

lsh:Patient-arm a sh:PropertyShape ;
  sh:path ls:patientArm ;
  sh:in ( lst:PatientArm-unassigned lst:PatientArm-assigned ) ;
  sh:maxCount 1 ;
  sh:name "Arm" .

lsh:Patient-armVisibility a sh:PropertyShape ;
  sh:path ls:patientArmVisibility ;
  sh:in ( lst:PatientArmVisibility-hidden lst:PatientArmVisibility-revealed ) ;
  sh:maxCount 1 ;
  sh:name "Arm visibility" .

lsh:Patient-enrolledIn a sh:PropertyShape ;
  sh:path ls:enrolledIn ;
  sh:class ls:Study ;
  sh:maxCount 1 ;
  sh:name "enrolled in" .

lsh:Patient-enrolledAt a sh:PropertyShape ;
  sh:path ls:enrolledAt ;
  sh:class ls:Site ;
  sh:maxCount 1 ;
  sh:name "enrolled at" .

lsh:Patient-receives a sh:PropertyShape ;
  sh:path ls:receives ;
  sh:class ls:Batch ;
  sh:name "receives" .

lsh:Patient-assignedArm a sh:PropertyShape ;
  sh:path ls:assignedArm ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "assigned arm" .

lsh:Patient a sh:NodeShape ;
  sh:targetClass ls:Patient ;
  sh:property lsh:Patient-identifier, lsh:Patient-enrollment, lsh:Patient-arm, lsh:Patient-armVisibility, lsh:Patient-enrolledIn, lsh:Patient-enrolledAt, lsh:Patient-receives, lsh:Patient-assignedArm .

lsh:Visit-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:Visit-status a sh:PropertyShape ;
  sh:path ls:visitStatus ;
  sh:in ( lst:VisitStatus-scheduled lst:VisitStatus-completed lst:VisitStatus-missed ) ;
  sh:maxCount 1 ;
  sh:name "Status" .

lsh:Visit-visitFor a sh:PropertyShape ;
  sh:path ls:visitFor ;
  sh:class ls:Patient ;
  sh:maxCount 1 ;
  sh:name "for" .

lsh:Visit-visitName a sh:PropertyShape ;
  sh:path ls:visitName ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "visit" .

lsh:Visit-scheduledOn a sh:PropertyShape ;
  sh:path ls:scheduledOn ;
  sh:datatype xsd:date ;
  sh:maxCount 1 ;
  sh:name "scheduled on" .

lsh:Visit-missedReason a sh:PropertyShape ;
  sh:path ls:missedReason ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "reason missed" .

lsh:Visit a sh:NodeShape ;
  sh:targetClass ls:Visit ;
  sh:property lsh:Visit-identifier, lsh:Visit-status, lsh:Visit-visitFor, lsh:Visit-visitName, lsh:Visit-scheduledOn, lsh:Visit-missedReason, lsh:Visit-scheduledFrom .

lsh:DataRecord-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:DataRecord-entry a sh:PropertyShape ;
  sh:path ls:dataRecordEntry ;
  sh:in ( lst:DataRecordEntry-entered lst:DataRecordEntry-verified ) ;
  sh:maxCount 1 ;
  sh:name "Entry" .

lsh:DataRecord-source a sh:PropertyShape ;
  sh:path ls:dataRecordSource ;
  sh:in ( lst:DataRecordSource-site lst:DataRecordSource-patient lst:DataRecordSource-device lst:DataRecordSource-healthRecord ) ;
  sh:maxCount 1 ;
  sh:name "Source" .

lsh:DataRecord-capturedAt a sh:PropertyShape ;
  sh:path ls:capturedAt ;
  sh:class ls:Visit ;
  sh:maxCount 1 ;
  sh:name "captured at" .

lsh:DataRecord-recordedValue a sh:PropertyShape ;
  sh:path ls:recordedValue ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "value" .

lsh:DataRecord a sh:NodeShape ;
  sh:targetClass ls:DataRecord ;
  sh:property lsh:DataRecord-identifier, lsh:DataRecord-entry, lsh:DataRecord-source, lsh:DataRecord-capturedAt, lsh:DataRecord-recordedValue .

lsh:DataQuery-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:DataQuery-status a sh:PropertyShape ;
  sh:path ls:dataQueryStatus ;
  sh:in ( lst:DataQueryStatus-open lst:DataQueryStatus-answered lst:DataQueryStatus-closed ) ;
  sh:maxCount 1 ;
  sh:name "Status" .

lsh:DataQuery-raisedOn a sh:PropertyShape ;
  sh:path ls:raisedOn ;
  sh:class ls:DataRecord ;
  sh:maxCount 1 ;
  sh:name "raised on" .

lsh:DataQuery-queryText a sh:PropertyShape ;
  sh:path ls:queryText ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "question" .

lsh:DataQuery a sh:NodeShape ;
  sh:targetClass ls:DataQuery ;
  sh:property lsh:DataQuery-identifier, lsh:DataQuery-status, lsh:DataQuery-raisedOn, lsh:DataQuery-queryText .

lsh:AdverseEvent-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:AdverseEvent-entry a sh:PropertyShape ;
  sh:path ls:adverseEventEntry ;
  sh:in ( lst:AdverseEventEntry-entered lst:AdverseEventEntry-verified ) ;
  sh:maxCount 1 ;
  sh:name "Entry" .

lsh:AdverseEvent-seriousness a sh:PropertyShape ;
  sh:path ls:adverseEventSeriousness ;
  sh:in ( lst:AdverseEventSeriousness-nonSerious lst:AdverseEventSeriousness-serious ) ;
  sh:maxCount 1 ;
  sh:name "Seriousness" .

lsh:AdverseEvent-outcome a sh:PropertyShape ;
  sh:path ls:adverseEventOutcome ;
  sh:in ( lst:AdverseEventOutcome-ongoing lst:AdverseEventOutcome-resolved ) ;
  sh:maxCount 1 ;
  sh:name "Outcome" .

lsh:AdverseEvent-reporting a sh:PropertyShape ;
  sh:path ls:adverseEventReporting ;
  sh:in ( lst:AdverseEventReporting-notReported lst:AdverseEventReporting-reportedToSafety lst:AdverseEventReporting-reconciled ) ;
  sh:maxCount 1 ;
  sh:name "Reporting" .

lsh:AdverseEvent-experiencedBy a sh:PropertyShape ;
  sh:path ls:experiencedBy ;
  sh:class ls:Patient ;
  sh:maxCount 1 ;
  sh:name "experienced by" .

lsh:AdverseEvent-verbatimTerm a sh:PropertyShape ;
  sh:path ls:verbatimTerm ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "verbatim term" .

lsh:AdverseEvent a sh:NodeShape ;
  sh:targetClass ls:AdverseEvent ;
  sh:property lsh:AdverseEvent-identifier, lsh:AdverseEvent-entry, lsh:AdverseEvent-seriousness, lsh:AdverseEvent-outcome, lsh:AdverseEvent-reporting, lsh:AdverseEvent-experiencedBy, lsh:AdverseEvent-verbatimTerm .

lsh:SafetyCase-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:SafetyCase-workflow a sh:PropertyShape ;
  sh:path ls:safetyCaseWorkflow ;
  sh:in ( lst:SafetyCaseWorkflow-received lst:SafetyCaseWorkflow-triaged lst:SafetyCaseWorkflow-assessed lst:SafetyCaseWorkflow-reported lst:SafetyCaseWorkflow-closed ) ;
  sh:maxCount 1 ;
  sh:name "Workflow" .

lsh:SafetyCase-seriousness a sh:PropertyShape ;
  sh:path ls:safetyCaseSeriousness ;
  sh:in ( lst:SafetyCaseSeriousness-nonSerious lst:SafetyCaseSeriousness-serious ) ;
  sh:maxCount 1 ;
  sh:name "Seriousness" .

lsh:SafetyCase-expectedness a sh:PropertyShape ;
  sh:path ls:safetyCaseExpectedness ;
  sh:in ( lst:SafetyCaseExpectedness-expected lst:SafetyCaseExpectedness-unexpected ) ;
  sh:maxCount 1 ;
  sh:name "Expectedness" .

lsh:SafetyCase-causality a sh:PropertyShape ;
  sh:path ls:safetyCaseCausality ;
  sh:in ( lst:SafetyCaseCausality-unassessed lst:SafetyCaseCausality-unrelated lst:SafetyCaseCausality-possible lst:SafetyCaseCausality-probable ) ;
  sh:maxCount 1 ;
  sh:name "Causality" .

lsh:SafetyCase-originatesFrom a sh:PropertyShape ;
  sh:path ls:originatesFrom ;
  sh:or ( lsh:IsAdverseEvent lsh:IsMedicalInquiry ) ;
  sh:maxCount 1 ;
  sh:name "originates from" .

lsh:SafetyCase-concerns a sh:PropertyShape ;
  sh:path ls:concerns ;
  sh:class ls:Product ;
  sh:name "concerns" .

lsh:SafetyCase-mayInvolve a sh:PropertyShape ;
  sh:path ls:mayInvolve ;
  sh:class ls:Batch ;
  sh:name "may involve" .

lsh:SafetyCase-duplicateOf a sh:PropertyShape ;
  sh:path ls:duplicateOf ;
  sh:class ls:SafetyCase ;
  sh:maxCount 1 ;
  sh:name "duplicate of" .

lsh:SafetyCase-reaction a sh:PropertyShape ;
  sh:path ls:reaction ;
  sh:in ( lst:Reaction-drugInducedLiverInjury lst:Reaction-skinRash lst:Reaction-nausea lst:Reaction-headache lst:Reaction-fatigue lst:Reaction-dizziness lst:Reaction-diarrhea ) ;
  sh:name "reaction" .

lsh:SafetyCase-reporterNote a sh:PropertyShape ;
  sh:path ls:reporterNote ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "note from the reporter" .

lsh:SafetyCase-receivedOn a sh:PropertyShape ;
  sh:path ls:receivedOn ;
  sh:datatype xsd:date ;
  sh:maxCount 1 ;
  sh:name "received on" .

lsh:SafetyCase-narrative a sh:PropertyShape ;
  sh:path ls:narrative ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "narrative" .

lsh:SafetyCase a sh:NodeShape ;
  sh:targetClass ls:SafetyCase ;
  sh:property lsh:SafetyCase-identifier, lsh:SafetyCase-workflow, lsh:SafetyCase-seriousness, lsh:SafetyCase-expectedness, lsh:SafetyCase-causality, lsh:SafetyCase-originatesFrom, lsh:SafetyCase-concerns, lsh:SafetyCase-mayInvolve, lsh:SafetyCase-duplicateOf, lsh:SafetyCase-reaction, lsh:SafetyCase-reporterNote, lsh:SafetyCase-receivedOn, lsh:SafetyCase-narrative .

lsh:Product-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:Product-status a sh:PropertyShape ;
  sh:path ls:productStatus ;
  sh:in ( lst:ProductStatus-investigational lst:ProductStatus-approved lst:ProductStatus-withdrawn ) ;
  sh:maxCount 1 ;
  sh:name "Status" .

lsh:Product-isFormulation a sh:PropertyShape ;
  sh:path ls:isFormulation ;
  sh:class ls:Formulation ;
  sh:maxCount 1 ;
  sh:name "is" .

lsh:Product-productName a sh:PropertyShape ;
  sh:path ls:productName ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "name" .

lsh:Product a sh:NodeShape ;
  sh:targetClass ls:Product ;
  sh:property lsh:Product-identifier, lsh:Product-status, lsh:Product-isFormulation, lsh:Product-productName .

lsh:Signal-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:Signal-status a sh:PropertyShape ;
  sh:path ls:signalStatus ;
  sh:in ( lst:SignalStatus-detected lst:SignalStatus-underEvaluation lst:SignalStatus-confirmed lst:SignalStatus-refuted ) ;
  sh:maxCount 1 ;
  sh:name "Status" .

lsh:Signal-concerns a sh:PropertyShape ;
  sh:path ls:concerns ;
  sh:class ls:Product ;
  sh:maxCount 1 ;
  sh:name "concerns" .

lsh:Signal-aggregates a sh:PropertyShape ;
  sh:path ls:aggregates ;
  sh:class ls:SafetyCase ;
  sh:name "aggregates" .

lsh:Signal-reaction a sh:PropertyShape ;
  sh:path ls:reaction ;
  sh:in ( lst:Reaction-drugInducedLiverInjury lst:Reaction-skinRash lst:Reaction-nausea lst:Reaction-headache lst:Reaction-fatigue lst:Reaction-dizziness lst:Reaction-diarrhea ) ;
  sh:maxCount 1 ;
  sh:name "reaction" .

lsh:Signal a sh:NodeShape ;
  sh:targetClass ls:Signal ;
  sh:property lsh:Signal-identifier, lsh:Signal-status, lsh:Signal-concerns, lsh:Signal-aggregates, lsh:Signal-reaction .

lsh:Submission-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:Submission-status a sh:PropertyShape ;
  sh:path ls:submissionStatus ;
  sh:in ( lst:SubmissionStatus-draft lst:SubmissionStatus-inReview lst:SubmissionStatus-submitted lst:SubmissionStatus-acknowledged ) ;
  sh:maxCount 1 ;
  sh:name "Status" .

lsh:Submission-deadline a sh:PropertyShape ;
  sh:path ls:submissionDeadline ;
  sh:in ( lst:SubmissionDeadline-onTrack lst:SubmissionDeadline-dueSoon lst:SubmissionDeadline-overdue ) ;
  sh:maxCount 1 ;
  sh:name "Deadline" .

lsh:Submission-reports a sh:PropertyShape ;
  sh:path ls:reports ;
  sh:or ( lsh:IsSafetyCase lsh:IsSignal ) ;
  sh:name "reports" .

lsh:Submission-dueOn a sh:PropertyShape ;
  sh:path ls:dueOn ;
  sh:datatype xsd:date ;
  sh:maxCount 1 ;
  sh:name "due on" .

lsh:Submission-preparedBy a sh:PropertyShape ;
  sh:path ls:preparedBy ;
  sh:nodeKind sh:IRI ;
  sh:maxCount 1 ;
  sh:name "prepared by" .

lsh:Submission a sh:NodeShape ;
  sh:targetClass ls:Submission ;
  sh:property lsh:Submission-identifier, lsh:Submission-status, lsh:Submission-deadline, lsh:Submission-reports, lsh:Submission-dueOn, lsh:Submission-preparedBy .

lsh:QualityEvent-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:QualityEvent-status a sh:PropertyShape ;
  sh:path ls:qualityEventStatus ;
  sh:in ( lst:QualityEventStatus-open lst:QualityEventStatus-investigating lst:QualityEventStatus-capaAssigned lst:QualityEventStatus-closed ) ;
  sh:maxCount 1 ;
  sh:name "Status" .

lsh:QualityEvent-severity a sh:PropertyShape ;
  sh:path ls:qualityEventSeverity ;
  sh:in ( lst:QualityEventSeverity-minor lst:QualityEventSeverity-major lst:QualityEventSeverity-critical ) ;
  sh:maxCount 1 ;
  sh:name "Severity" .

lsh:QualityEvent-raisedOn a sh:PropertyShape ;
  sh:path ls:raisedOn ;
  sh:class ls:Batch ;
  sh:maxCount 1 ;
  sh:name "raised on" .

lsh:QualityEvent-eventDescription a sh:PropertyShape ;
  sh:path ls:eventDescription ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "description" .

lsh:QualityEvent a sh:NodeShape ;
  sh:targetClass ls:QualityEvent ;
  sh:property lsh:QualityEvent-identifier, lsh:QualityEvent-status, lsh:QualityEvent-severity, lsh:QualityEvent-raisedOn, lsh:QualityEvent-eventDescription .

lsh:CAPA-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:CAPA-status a sh:PropertyShape ;
  sh:path ls:capaStatus ;
  sh:in ( lst:CAPAStatus-planned lst:CAPAStatus-inProgress lst:CAPAStatus-effective lst:CAPAStatus-ineffective ) ;
  sh:maxCount 1 ;
  sh:name "Status" .

lsh:CAPA-resolves a sh:PropertyShape ;
  sh:path ls:resolves ;
  sh:class ls:QualityEvent ;
  sh:maxCount 1 ;
  sh:name "resolves" .

lsh:CAPA-capaAction a sh:PropertyShape ;
  sh:path ls:capaAction ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "action" .

lsh:CAPA a sh:NodeShape ;
  sh:targetClass ls:CAPA ;
  sh:property lsh:CAPA-identifier, lsh:CAPA-status, lsh:CAPA-resolves, lsh:CAPA-capaAction .

lsh:MedicalInquiry-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:MedicalInquiry-status a sh:PropertyShape ;
  sh:path ls:medicalInquiryStatus ;
  sh:in ( lst:MedicalInquiryStatus-received lst:MedicalInquiryStatus-answered lst:MedicalInquiryStatus-closed ) ;
  sh:maxCount 1 ;
  sh:name "Status" .

lsh:MedicalInquiry-inquiryText a sh:PropertyShape ;
  sh:path ls:inquiryText ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "question" .

lsh:MedicalInquiry a sh:NodeShape ;
  sh:targetClass ls:MedicalInquiry ;
  sh:property lsh:MedicalInquiry-identifier, lsh:MedicalInquiry-status, lsh:MedicalInquiry-inquiryText .

lsh:IsAdverseEvent a sh:NodeShape ;
  sh:class ls:AdverseEvent .

lsh:IsMedicalInquiry a sh:NodeShape ;
  sh:class ls:MedicalInquiry .

lsh:IsSafetyCase a sh:NodeShape ;
  sh:class ls:SafetyCase .

lsh:IsSignal a sh:NodeShape ;
  sh:class ls:Signal .

# ---------------------------------------------------------------------------
# Design and Plan (domain spec section 3.4). Version 0.2.0.
# ---------------------------------------------------------------------------

ls:DesignAndPlan a p:Domain ;
  rdfs:label "Design and Plan" .

ls:Program a p:ObjectType, rdfs:Class ;
  rdfs:label "Program" ;
  p:pluralLabel "Programs" ;
  rdfs:comment "Groups research at the organizational level, such as the development of one candidate. Persists across concepts and studies." ;
  p:inDomain ls:DesignAndPlan ;
  p:titleTemplate "{ls:programName}" .

ls:programStatus a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Status" ;
  rdfs:comment "The status of a program." ;
  p:dimensionOf ls:Program ;
  p:valuesFrom lst:ProgramStatus ;
  p:order 1 .

ls:programName a owl:DatatypeProperty ;
  rdfs:label "name" ;
  rdfs:comment "The program's name." .

ls:TargetProductProfile a p:ObjectType, rdfs:Class ;
  rdfs:label "Target Product Profile" ;
  p:pluralLabel "Target Product Profiles" ;
  rdfs:comment "The labeling a program aims for: indication, population, dosing, and its target and minimum efficacy and safety claims." ;
  p:inDomain ls:DesignAndPlan ;
  p:titleTemplate "Target product profile: {ls:tppIndication}" .

ls:targetProductProfileStatus a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Status" ;
  rdfs:comment "The status of a target product profile." ;
  p:dimensionOf ls:TargetProductProfile ;
  p:valuesFrom lst:TargetProductProfileStatus ;
  p:order 1 .

ls:tppIndication a owl:DatatypeProperty ;
  rdfs:label "indication" ;
  rdfs:comment "The indication the program aims to have approved." .

ls:targetClaim a owl:DatatypeProperty ;
  rdfs:label "target claim" ;
  rdfs:comment "The efficacy and safety claims the program aims for." .

ls:minimumClaim a owl:DatatypeProperty ;
  rdfs:label "minimum claim" ;
  rdfs:comment "The least the product must show to be worth developing." .

ls:Concept a p:ObjectType, rdfs:Class ;
  rdfs:label "Concept" ;
  p:pluralLabel "Concepts" ;
  rdfs:comment "A research opportunity being explored: its rationale, intended direction and preliminary objectives. It can lead to one study, several or none." ;
  p:inDomain ls:DesignAndPlan ;
  p:titleTemplate "{ls:conceptName}" .

ls:conceptStatus a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Status" ;
  rdfs:comment "The status of a concept." ;
  p:dimensionOf ls:Concept ;
  p:valuesFrom lst:ConceptStatus ;
  p:order 1 .

ls:conceptName a owl:DatatypeProperty ;
  rdfs:label "name" ;
  rdfs:comment "The concept's name." .

ls:rationale a owl:DatatypeProperty ;
  rdfs:label "rationale" ;
  rdfs:comment "Why the opportunity is worth exploring." .

ls:StudyScenario a p:ObjectType, rdfs:Class ;
  rdfs:label "Study Scenario" ;
  p:pluralLabel "Study Scenarios" ;
  rdfs:comment "One possible approach to a concept or a study: a protocol, a study budget and a site selection, worked on together and simulated as one." ;
  p:inDomain ls:DesignAndPlan ;
  p:titleTemplate "{ls:scenarioName}" .

ls:studyScenarioStatus a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Status" ;
  rdfs:comment "The status of a study scenario." ;
  p:dimensionOf ls:StudyScenario ;
  p:valuesFrom lst:StudyScenarioStatus ;
  p:order 1 .

ls:scenarioName a owl:DatatypeProperty ;
  rdfs:label "name" ;
  rdfs:comment "The scenario's name." .

ls:scenarioChange a owl:DatatypeProperty ;
  rdfs:label "what it changes" ;
  rdfs:comment "How this scenario differs from the one it was copied from." .

ls:Population a p:ObjectType, rdfs:Class ;
  rdfs:label "Population" ;
  p:pluralLabel "Populations" ;
  rdfs:comment "Who a study is for, defined by its eligibility criteria." ;
  p:inDomain ls:DesignAndPlan ;
  skos:exactMatch ncit:C70833 ;
  p:titleTemplate "{ls:populationText}" .

ls:populationText a owl:DatatypeProperty ;
  rdfs:label "description" ;
  rdfs:comment "The population in words." .

ls:Objective a p:ObjectType, rdfs:Class ;
  rdfs:label "Objective" ;
  p:pluralLabel "Objectives" ;
  rdfs:comment "A question a study asks." ;
  p:inDomain ls:DesignAndPlan ;
  p:titleTemplate "{ls:objectiveText}" .

ls:objectiveLevel a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Level" ;
  rdfs:comment "The level of an objective." ;
  p:dimensionOf ls:Objective ;
  p:valuesFrom lst:ObjectiveLevel ;
  p:order 1 .

ls:objectiveText a owl:DatatypeProperty ;
  rdfs:label "statement" ;
  rdfs:comment "The objective as the protocol states it." .

ls:Estimand a p:ObjectType, rdfs:Class ;
  rdfs:label "Estimand" ;
  p:pluralLabel "Estimands" ;
  rdfs:comment "The precise treatment effect an objective targets, with its five ICH E9(R1) attributes." ;
  p:inDomain ls:DesignAndPlan ;
  skos:exactMatch ncit:C188813 ;
  p:titleTemplate "Estimand: {ls:estimandVariable}" .

ls:estimandCompleteness a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Completeness" ;
  rdfs:comment "The completeness of an estimand." ;
  p:dimensionOf ls:Estimand ;
  p:valuesFrom lst:EstimandCompleteness ;
  p:order 1 .

ls:estimandTreatment a owl:DatatypeProperty ;
  rdfs:label "treatment" ;
  rdfs:comment "The treatment condition and its comparator." .

ls:estimandPopulation a owl:DatatypeProperty ;
  rdfs:label "population" ;
  rdfs:comment "The patients the effect is estimated for." .

ls:estimandVariable a owl:DatatypeProperty ;
  rdfs:label "variable" ;
  rdfs:comment "The variable, or endpoint, that is measured." .

ls:intercurrentEvents a owl:DatatypeProperty ;
  rdfs:label "intercurrent events" ;
  rdfs:comment "Events after treatment starts that affect the variable, and the strategy for each." .

ls:populationSummary a owl:DatatypeProperty ;
  rdfs:label "population-level summary" ;
  rdfs:comment "How the variable is summarized to compare treatments." .

ls:Endpoint a p:ObjectType, rdfs:Class ;
  rdfs:label "Endpoint" ;
  p:pluralLabel "Endpoints" ;
  rdfs:comment "How an objective is measured: the variable and when it is measured." ;
  p:inDomain ls:DesignAndPlan ;
  skos:closeMatch ncit:C25212 ;
  p:titleTemplate "{ls:endpointText}" .

ls:endpointType a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Type" ;
  rdfs:comment "The type of an endpoint." ;
  p:dimensionOf ls:Endpoint ;
  p:valuesFrom lst:EndpointType ;
  p:order 1 .

ls:endpointText a owl:DatatypeProperty ;
  rdfs:label "statement" ;
  rdfs:comment "The endpoint as the protocol states it." .

ls:EligibilityCriterion a p:ObjectType, rdfs:Class ;
  rdfs:label "Eligibility Criterion" ;
  p:pluralLabel "Eligibility Criteria" ;
  rdfs:comment "One inclusion or exclusion rule, with the data that tests it at screening." ;
  p:inDomain ls:DesignAndPlan ;
  skos:closeMatch ncit:C16112 ;
  p:titleTemplate "{ls:criterionText}" .

ls:eligibilityCriterionKind a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Kind" ;
  rdfs:comment "The kind of an eligibility criterion." ;
  p:dimensionOf ls:EligibilityCriterion ;
  p:valuesFrom lst:EligibilityCriterionKind ;
  p:order 1 .

ls:eligibilityCriterionTestability a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Testability" ;
  rdfs:comment "The testability of an eligibility criterion." ;
  p:dimensionOf ls:EligibilityCriterion ;
  p:valuesFrom lst:EligibilityCriterionTestability ;
  p:order 2 .

ls:criterionText a owl:DatatypeProperty ;
  rdfs:label "criterion" ;
  rdfs:comment "The criterion as the protocol states it." .

ls:testedBy a owl:DatatypeProperty ;
  rdfs:label "tested by" ;
  rdfs:comment "The data that tests the criterion at screening." .

ls:Arm a p:ObjectType, rdfs:Class ;
  rdfs:label "Arm" ;
  p:pluralLabel "Arms" ;
  rdfs:comment "A planned treatment group." ;
  p:inDomain ls:DesignAndPlan ;
  skos:exactMatch ncit:C174447 ;
  p:titleTemplate "{ls:armName}" .

ls:armRole a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Role" ;
  rdfs:comment "The role of an arm." ;
  p:dimensionOf ls:Arm ;
  p:valuesFrom lst:ArmRole ;
  p:order 1 .

ls:armName a owl:DatatypeProperty ;
  rdfs:label "name" ;
  rdfs:comment "The arm's name." .

ls:allocationRatio a owl:DatatypeProperty ;
  rdfs:label "allocation" ;
  rdfs:comment "The arm's share of randomized patients, such as 1 in 1:1." .

ls:Intervention a p:ObjectType, rdfs:Class ;
  rdfs:label "Intervention" ;
  p:pluralLabel "Interventions" ;
  rdfs:comment "A drug, device or comparator given in an arm, with its dose and regimen." ;
  p:inDomain ls:DesignAndPlan ;
  skos:closeMatch ncit:C16197 ;
  p:titleTemplate "{ls:interventionName}" .

ls:interventionName a owl:DatatypeProperty ;
  rdfs:label "name" ;
  rdfs:comment "The intervention's name." .

ls:regimen a owl:DatatypeProperty ;
  rdfs:label "dose and regimen" ;
  rdfs:comment "How much is given, how and how often." .

ls:PlannedVisit a p:ObjectType, rdfs:Class ;
  rdfs:label "Planned Visit" ;
  p:pluralLabel "Planned Visits" ;
  rdfs:comment "A point in the study timeline, with its timing and window. Each patient's Visit is scheduled from one." ;
  p:inDomain ls:DesignAndPlan ;
  skos:closeMatch ncit:C191214 ;
  p:titleTemplate "{ls:plannedVisitName}" .

ls:plannedVisitName a owl:DatatypeProperty ;
  rdfs:label "name" ;
  rdfs:comment "The visit's name, such as Week 12." .

ls:studyDay a owl:DatatypeProperty ;
  rdfs:label "study day" ;
  rdfs:comment "The day of the study the visit falls on." .

ls:windowDays a owl:DatatypeProperty ;
  rdfs:label "window" ;
  rdfs:comment "How many days either side of the study day the visit may happen." .

ls:Assessment a p:ObjectType, rdfs:Class ;
  rdfs:label "Assessment" ;
  p:pluralLabel "Assessments" ;
  rdfs:comment "A procedure or measurement in the schedule of activities, with its burden and cost." ;
  p:inDomain ls:DesignAndPlan ;
  p:titleTemplate "{ls:assessmentName}" .

ls:assessmentPurpose a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Purpose" ;
  rdfs:comment "The purpose of an assessment." ;
  p:dimensionOf ls:Assessment ;
  p:valuesFrom lst:AssessmentPurpose ;
  p:order 1 .

ls:assessmentBurden a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Burden" ;
  rdfs:comment "The burden of an assessment." ;
  p:dimensionOf ls:Assessment ;
  p:valuesFrom lst:AssessmentBurden ;
  p:order 2 .

ls:assessmentName a owl:DatatypeProperty ;
  rdfs:label "name" ;
  rdfs:comment "The assessment's name." .

ls:costPerVisit a owl:DatatypeProperty ;
  rdfs:label "cost per visit" ;
  rdfs:comment "What one performance costs, in US dollars." .

ls:minutesOnSite a owl:DatatypeProperty ;
  rdfs:label "time on site" ;
  rdfs:comment "Minutes it adds to a visit." .

ls:StudyBudget a p:ObjectType, rdfs:Class ;
  rdfs:label "Study Budget" ;
  p:pluralLabel "Study Budgets" ;
  rdfs:comment "The cost of a study scenario, or a ceiling set first as a constraint the scenario must meet." ;
  p:inDomain ls:DesignAndPlan ;
  p:titleTemplate "{ls:budgetName}" .

ls:studyBudgetStatus a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Status" ;
  rdfs:comment "The status of a study budget." ;
  p:dimensionOf ls:StudyBudget ;
  p:valuesFrom lst:StudyBudgetStatus ;
  p:order 1 .

ls:studyBudgetFit a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Fit" ;
  rdfs:comment "The fit of a study budget." ;
  p:dimensionOf ls:StudyBudget ;
  p:valuesFrom lst:StudyBudgetFit ;
  p:order 2 .

ls:budgetName a owl:DatatypeProperty ;
  rdfs:label "name" ;
  rdfs:comment "The budget's name." .

ls:budgetTotal a owl:DatatypeProperty ;
  rdfs:label "total" ;
  rdfs:comment "The planned total cost, in millions of US dollars." .

ls:budgetCeiling a owl:DatatypeProperty ;
  rdfs:label "ceiling" ;
  rdfs:comment "The most the study may cost, in millions of US dollars." .

ls:SiteSelection a p:ObjectType, rdfs:Class ;
  rdfs:label "Site Selection" ;
  p:pluralLabel "Site Selections" ;
  rdfs:comment "The proposed sites for a study scenario, with the countries they are in." ;
  p:inDomain ls:DesignAndPlan ;
  p:titleTemplate "{ls:selectionName}" .

ls:siteSelectionStatus a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Status" ;
  rdfs:comment "The status of a site selection." ;
  p:dimensionOf ls:SiteSelection ;
  p:valuesFrom lst:SiteSelectionStatus ;
  p:order 1 .

ls:selectionName a owl:DatatypeProperty ;
  rdfs:label "name" ;
  rdfs:comment "The site selection's name." .

ls:ProposedSite a p:ObjectType, rdfs:Class ;
  rdfs:label "Proposed Site" ;
  p:pluralLabel "Proposed Sites" ;
  rdfs:comment "A site proposed in a site selection, with its expected enrollment and start-up time." ;
  p:inDomain ls:DesignAndPlan ;
  p:titleTemplate "{ls:candidateSite} | Proposed site in {ls:siteCountry}" .

ls:proposedSiteStatus a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Status" ;
  rdfs:comment "The status of a proposed site." ;
  p:dimensionOf ls:ProposedSite ;
  p:valuesFrom lst:ProposedSiteStatus ;
  p:order 1 .

ls:siteCountry a owl:DatatypeProperty ;
  rdfs:label "country" ;
  rdfs:comment "The country the site is in." .

ls:patientsPerMonth a owl:DatatypeProperty ;
  rdfs:label "patients per month" ;
  rdfs:comment "Patients the site is expected to enroll each month." .

ls:activationDays a owl:DatatypeProperty ;
  rdfs:label "activation" ;
  rdfs:comment "Days the site is expected to take to activate." .

ls:TrialSimulation a p:ObjectType, rdfs:Class ;
  rdfs:label "Trial Simulation" ;
  p:pluralLabel "Trial Simulations" ;
  rdfs:comment "A simulation of a study scenario as it stood at one moment, run many times under stated assumptions to predict the study's outcomes." ;
  p:inDomain ls:DesignAndPlan ;
  p:titleTemplate "Simulation of {ls:simulates}" .

ls:trialSimulationRun a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Run" ;
  rdfs:comment "The run of a trial simulation." ;
  p:dimensionOf ls:TrialSimulation ;
  p:valuesFrom lst:TrialSimulationRun ;
  p:order 1 .

ls:scenarioAsOf a owl:DatatypeProperty ;
  rdfs:label "scenario as of" ;
  rdfs:comment "The moment of the scenario the simulation ran on." .

ls:simulatedTrials a owl:DatatypeProperty ;
  rdfs:label "simulated trials" ;
  rdfs:comment "How many virtual trials the simulation ran." .

ls:recruitmentRate a owl:DatatypeProperty ;
  rdfs:label "recruitment rate" ;
  rdfs:comment "Assumed patients per site per month." .

ls:screenFailureRate a owl:DatatypeProperty ;
  rdfs:label "screen failure rate" ;
  rdfs:comment "Assumed share of screened patients who are not eligible, as a percentage." .

ls:dropoutRate a owl:DatatypeProperty ;
  rdfs:label "dropout rate" ;
  rdfs:comment "Assumed share of randomized patients who withdraw, as a percentage." .

ls:assumedEffect a owl:DatatypeProperty ;
  rdfs:label "assumed effect" ;
  rdfs:comment "The treatment effect assumed, with its source." .

ls:Forecast a p:ObjectType, rdfs:Class ;
  rdfs:label "Forecast" ;
  p:pluralLabel "Forecasts" ;
  rdfs:comment "One predicted outcome of a trial simulation, as a median with a range, such as the month the last patient is enrolled." ;
  p:inDomain ls:DesignAndPlan ;
  p:titleTemplate "{ls:forecastMeasure}: {ls:forecastMedian} {ls:forecastUnit}" .

ls:forecastCurrency a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Currency" ;
  rdfs:comment "The currency of a forecast." ;
  p:dimensionOf ls:Forecast ;
  p:valuesFrom lst:ForecastCurrency ;
  p:order 1 .

ls:forecastMeasure a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Measure" ;
  rdfs:comment "The measure of a forecast." ;
  p:dimensionOf ls:Forecast ;
  p:valuesFrom lst:OutcomeMeasure ;
  p:order 2 .

ls:forecastAgainstTarget a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Against target" ;
  rdfs:comment "The against target of a forecast." ;
  p:dimensionOf ls:Forecast ;
  p:valuesFrom lst:ForecastAgainstTarget ;
  p:order 3 .

ls:forecastMedian a owl:DatatypeProperty ;
  rdfs:label "median" ;
  rdfs:comment "The median of the simulated outcomes." .

ls:forecastLow a owl:DatatypeProperty ;
  rdfs:label "low" ;
  rdfs:comment "The 10th percentile of the simulated outcomes." .

ls:forecastHigh a owl:DatatypeProperty ;
  rdfs:label "high" ;
  rdfs:comment "The 90th percentile of the simulated outcomes." .

ls:forecastUnit a owl:DatatypeProperty ;
  rdfs:label "unit" ;
  rdfs:comment "The unit of the forecast." .

ls:OutcomeTarget a p:ObjectType, rdfs:Class ;
  rdfs:label "Outcome Target" ;
  p:pluralLabel "Outcome Targets" ;
  rdfs:comment "What success means for a concept or a study, on one measure, such as the last patient in within 20 months." ;
  p:inDomain ls:DesignAndPlan ;
  p:titleTemplate "{ls:targetMeasure} {ls:targetComparison} {ls:targetThreshold} {ls:targetUnit}" .

ls:outcomeTargetStatus a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Status" ;
  rdfs:comment "The status of an outcome target." ;
  p:dimensionOf ls:OutcomeTarget ;
  p:valuesFrom lst:OutcomeTargetStatus ;
  p:order 1 .

ls:targetMeasure a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Measure" ;
  rdfs:comment "The measure of an outcome target." ;
  p:dimensionOf ls:OutcomeTarget ;
  p:valuesFrom lst:OutcomeMeasure ;
  p:order 2 .

ls:targetComparison a owl:DatatypeProperty ;
  rdfs:label "comparison" ;
  rdfs:comment "Whether the forecast must be at most or at least the threshold." .

ls:targetThreshold a owl:DatatypeProperty ;
  rdfs:label "threshold" ;
  rdfs:comment "The value a forecast must reach." .

ls:targetUnit a owl:DatatypeProperty ;
  rdfs:label "unit" ;
  rdfs:comment "The unit of the threshold." .

ls:Contribution a p:ObjectType, rdfs:Class ;
  rdfs:label "Contribution" ;
  p:pluralLabel "Contributions" ;
  rdfs:comment "Protocol content a contributor authored or imported, mapped to protocol objects." ;
  p:inDomain ls:DesignAndPlan ;
  p:titleTemplate "{ls:contributionName}" .

ls:contributionMapping a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Mapping" ;
  rdfs:comment "The mapping of a contribution." ;
  p:dimensionOf ls:Contribution ;
  p:valuesFrom lst:ContributionMapping ;
  p:order 1 .

ls:contributionName a owl:DatatypeProperty ;
  rdfs:label "name" ;
  rdfs:comment "What the contribution is, such as a section and where it came from." .

ls:sourceFormat a owl:DatatypeProperty ;
  rdfs:label "source" ;
  rdfs:comment "Where the content came from: authored, Word, Google Docs or text." .

ls:DesignSignal a p:ObjectType, rdfs:Class ;
  rdfs:label "Design Signal" ;
  p:pluralLabel "Design Signals" ;
  rdfs:comment "Feedback from historical study data on the design object it concerns, such as a criterion that slowed enrollment in similar studies." ;
  p:inDomain ls:DesignAndPlan ;
  p:titleTemplate "{ls:designSignalText}" .

ls:designSignalStatus a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Status" ;
  rdfs:comment "The status of a design signal." ;
  p:dimensionOf ls:DesignSignal ;
  p:valuesFrom lst:DesignSignalStatus ;
  p:order 1 .

ls:designSignalText a owl:DatatypeProperty ;
  rdfs:label "signal" ;
  rdfs:comment "What history shows about the object." .

ls:Decision a p:ObjectType, rdfs:Class ;
  rdfs:label "Decision" ;
  p:pluralLabel "Decisions" ;
  rdfs:comment "A recorded choice on a concept or a study: to pursue, park or stop a concept, to select a scenario, or to approve a study's baseline." ;
  p:inDomain ls:DesignAndPlan ;
  p:titleTemplate "{ls:decisionRationale}" .

ls:decisionKind a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Kind" ;
  rdfs:comment "The kind of a decision." ;
  p:dimensionOf ls:Decision ;
  p:valuesFrom lst:DecisionKind ;
  p:order 1 .

ls:decisionRationale a owl:DatatypeProperty ;
  rdfs:label "rationale" ;
  rdfs:comment "Why the choice was made." .

ls:decidedOn a owl:DatatypeProperty ;
  rdfs:label "decided on" ;
  rdfs:comment "The date of the decision." .

ls:informs a p:Relationship, owl:ObjectProperty ;
  rdfs:label "informs" ;
  p:inverseLabel "is informed by" ;
  p:order 26 ;
  rdfs:comment "A concept informs the programs and studies it bears on." .

ls:belongsTo a p:Relationship, owl:ObjectProperty ;
  rdfs:label "belongs to" ;
  p:inverseLabel "includes" ;
  p:order 27 ;
  rdfs:comment "A study belongs to a program." .

ls:aimsAt a p:Relationship, owl:ObjectProperty ;
  rdfs:label "aims at" ;
  p:inverseLabel "is the aim of" ;
  p:order 28 ;
  rdfs:comment "A program aims at a target product profile." .

ls:develops a p:Relationship, owl:ObjectProperty ;
  rdfs:label "develops" ;
  p:inverseLabel "is developed in" ;
  p:order 29 ;
  rdfs:comment "A program develops a compound." .

ls:explores a p:Relationship, owl:ObjectProperty ;
  rdfs:label "explores" ;
  p:inverseLabel "is explored by" ;
  p:order 30 ;
  p:partOf true ;
  rdfs:comment "A study scenario explores a concept or a study. It has one parent." .

ls:usesProtocol a p:Relationship, owl:ObjectProperty ;
  rdfs:label "uses" ;
  p:inverseLabel "is used in" ;
  p:order 31 ;
  rdfs:comment "A study scenario uses one protocol version." .

ls:usesBudget a p:Relationship, owl:ObjectProperty ;
  rdfs:label "uses" ;
  p:inverseLabel "is used in" ;
  p:order 32 ;
  rdfs:comment "A study scenario uses one study budget." .

ls:usesSiteSelection a p:Relationship, owl:ObjectProperty ;
  rdfs:label "uses" ;
  p:inverseLabel "is used in" ;
  p:order 33 ;
  rdfs:comment "A study scenario uses one site selection." .

ls:baselineFrom a p:Relationship, owl:ObjectProperty ;
  rdfs:label "began from" ;
  p:inverseLabel "seeded" ;
  p:order 34 ;
  rdfs:comment "A study began from a concept's selected scenario, copied as its baseline." .

ls:simulates a p:Relationship, owl:ObjectProperty ;
  rdfs:label "simulates" ;
  p:inverseLabel "is simulated by" ;
  p:order 35 ;
  p:partOf true ;
  rdfs:comment "A trial simulation simulates a study scenario as it stood at one moment." .

ls:forecastFrom a p:Relationship, owl:ObjectProperty ;
  rdfs:label "comes from" ;
  p:inverseLabel "forecasts" ;
  p:order 36 ;
  p:partOf true ;
  rdfs:comment "A forecast comes from a trial simulation." .

ls:measuredAgainst a p:Relationship, owl:ObjectProperty ;
  rdfs:label "is measured against" ;
  p:inverseLabel "measures" ;
  p:order 37 ;
  rdfs:comment "A forecast is measured against an outcome target on the same measure." .

ls:targetFor a p:Relationship, owl:ObjectProperty ;
  rdfs:label "sets success for" ;
  p:inverseLabel "has targets" ;
  p:order 38 ;
  p:partOf true ;
  rdfs:comment "An outcome target sets what success means for a concept or a study." .

ls:specifiedIn a p:Relationship, owl:ObjectProperty ;
  rdfs:label "specified in" ;
  p:inverseLabel "specifies" ;
  p:order 39 ;
  p:partOf true ;
  rdfs:comment "A protocol version specifies its population, objectives, arms and planned visits." .

ls:defines a p:Relationship, owl:ObjectProperty ;
  rdfs:label "defines" ;
  p:inverseLabel "is defined by" ;
  p:order 40 ;
  p:partOf true ;
  rdfs:comment "An eligibility criterion defines a population." .

ls:measures a p:Relationship, owl:ObjectProperty ;
  rdfs:label "measures" ;
  p:inverseLabel "is measured by" ;
  p:order 41 ;
  rdfs:comment "An endpoint measures an objective." .

ls:estimandOf a p:Relationship, owl:ObjectProperty ;
  rdfs:label "is the estimand of" ;
  p:inverseLabel "targets" ;
  p:order 42 ;
  p:partOf true ;
  rdfs:comment "An estimand is the precise effect an objective targets." .

ls:requires a p:Relationship, owl:ObjectProperty ;
  rdfs:label "requires" ;
  p:inverseLabel "produces data for" ;
  p:order 43 ;
  rdfs:comment "An endpoint requires the assessments that produce its data." .

ls:givenIn a p:Relationship, owl:ObjectProperty ;
  rdfs:label "given in" ;
  p:inverseLabel "gives" ;
  p:order 44 ;
  rdfs:comment "An intervention is given in an arm." .

ls:administers a p:Relationship, owl:ObjectProperty ;
  rdfs:label "administers" ;
  p:inverseLabel "is administered as" ;
  p:order 45 ;
  rdfs:comment "An intervention administers a formulation." .

ls:performedAt a p:Relationship, owl:ObjectProperty ;
  rdfs:label "performed at" ;
  p:inverseLabel "performs" ;
  p:order 46 ;
  rdfs:comment "An assessment is performed at planned visits." .

ls:scheduledFrom a p:Relationship, owl:ObjectProperty ;
  rdfs:label "scheduled from" ;
  p:inverseLabel "schedules" ;
  p:order 47 ;
  rdfs:comment "A patient's visit is scheduled from a planned visit." .

ls:proposedIn a p:Relationship, owl:ObjectProperty ;
  rdfs:label "proposed in" ;
  p:inverseLabel "proposes" ;
  p:order 48 ;
  p:partOf true ;
  rdfs:comment "A proposed site is proposed in a site selection." .

ls:candidateSite a p:Relationship, owl:ObjectProperty ;
  rdfs:label "proposes" ;
  p:inverseLabel "is proposed as" ;
  p:order 49 ;
  rdfs:comment "A proposed site names the site it proposes." .

ls:contributesTo a p:Relationship, owl:ObjectProperty ;
  rdfs:label "contributes to" ;
  p:inverseLabel "has contributions" ;
  p:order 50 ;
  rdfs:comment "A contribution contributes to a protocol version." .

ls:isAbout a p:Relationship, owl:ObjectProperty ;
  rdfs:label "is about" ;
  p:inverseLabel "has design signals" ;
  p:order 51 ;
  rdfs:comment "A design signal is about the design or plan object it concerns." .

ls:decidesOn a p:Relationship, owl:ObjectProperty ;
  rdfs:label "decides on" ;
  p:inverseLabel "is decided by" ;
  p:order 52 ;
  p:partOf true ;
  rdfs:comment "A decision is about a concept or a study." .

ls:chooses a p:Relationship, owl:ObjectProperty ;
  rdfs:label "chooses" ;
  p:inverseLabel "is chosen by" ;
  p:order 53 ;
  rdfs:comment "A decision chooses a study scenario." .

ls:justifiedBy a p:Relationship, owl:ObjectProperty ;
  rdfs:label "justified by" ;
  p:inverseLabel "justifies" ;
  p:order 54 ;
  rdfs:comment "An eligibility criterion is justified by a nonclinical result or a known risk." .

lsh:Program-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:Program-programStatus a sh:PropertyShape ;
  sh:path ls:programStatus ;
  sh:in ( lst:ProgramStatus-active lst:ProgramStatus-onHold lst:ProgramStatus-discontinued ) ;
  sh:maxCount 1 ;
  sh:name "Status" .

lsh:Program-programName a sh:PropertyShape ;
  sh:path ls:programName ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "name" .

