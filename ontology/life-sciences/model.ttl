@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix p:       <https://w3id.org/lsh-platform/platform#> .
@prefix ls:      <https://w3id.org/lsh-platform/life-sciences#> .
@prefix lst:     <https://w3id.org/lsh-platform/life-sciences/term#> .
@prefix lsh:     <https://w3id.org/lsh-platform/life-sciences/shape#> .
@prefix ncit:    <http://purl.obolibrary.org/obo/NCIT_> .
<https://w3id.org/lsh-platform/life-sciences> a owl:Ontology ;
  dcterms:title "LS&H life sciences model" ;
  rdfs:comment "Object types, state dimensions, relationships and their SHACL shapes for the life sciences thread (domain spec sections 2 to 5)." ;
  owl:versionInfo "0.1.0" ;
  owl:versionIRI <https://w3id.org/lsh-platform/life-sciences/0.1.0> ;
  dcterms:created "2026-11-08"^^xsd:date .

ls:ScientificInnovation a p:Domain ;
  rdfs:label "Scientific Innovation" .

ls:ClinicalDevelopment a p:Domain ;
  rdfs:label "Clinical Development" .

ls:SafetyAndRegulatory a p:Domain ;
  rdfs:label "Safety and Regulatory" .

ls:identifier a owl:DatatypeProperty ;
  rdfs:label "identifier" ;
  rdfs:comment "The identifier people use for an object, such as SC-0007." .

ls:Compound a p:ObjectType, rdfs:Class ;
  rdfs:label "Compound" ;
  p:pluralLabel "Compounds" ;
  rdfs:comment "A molecule under research." ;
  p:inDomain ls:ScientificInnovation ;
  p:titleTemplate "{ls:compoundName} | Analog of {ls:derivedFrom}" .

ls:compoundStage a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Stage" ;
  rdfs:comment "The stage of a compound." ;
  p:dimensionOf ls:Compound ;
  p:valuesFrom lst:CompoundStage ;
  p:order 1 .

ls:compoundRegistration a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Registration" ;
  rdfs:comment "The registration of a compound." ;
  p:dimensionOf ls:Compound ;
  p:valuesFrom lst:CompoundRegistration ;
  p:order 2 .

ls:Simulation a p:ObjectType, rdfs:Class ;
  rdfs:label "Simulation" ;
  p:pluralLabel "Simulations" ;
  rdfs:comment "An in silico run predicting a compound's properties." ;
  p:inDomain ls:ScientificInnovation ;
  p:titleTemplate "{ls:modelType} prediction for {ls:predicts}" .

ls:simulationRun a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Run" ;
  rdfs:comment "The run of a simulation." ;
  p:dimensionOf ls:Simulation ;
  p:valuesFrom lst:SimulationRun ;
  p:order 1 .

ls:simulationReview a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Review" ;
  rdfs:comment "The review of a simulation." ;
  p:dimensionOf ls:Simulation ;
  p:valuesFrom lst:SimulationReview ;
  p:order 2 .

ls:Experiment a p:ObjectType, rdfs:Class ;
  rdfs:label "Experiment" ;
  p:pluralLabel "Experiments" ;
  rdfs:comment "A lab experiment recorded in an electronic notebook." ;
  p:inDomain ls:ScientificInnovation ;
  skos:closeMatch ncit:C42790 ;
  p:titleTemplate "{ls:aim}, {ls:tests}" .

ls:experimentRecord a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Record" ;
  rdfs:comment "The record of a experiment." ;
  p:dimensionOf ls:Experiment ;
  p:valuesFrom lst:ExperimentRecord ;
  p:order 1 .

ls:experimentSignOff a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Sign-off" ;
  rdfs:comment "The sign-off of a experiment." ;
  p:dimensionOf ls:Experiment ;
  p:valuesFrom lst:ExperimentSignOff ;
  p:order 2 .

ls:AssayResult a p:ObjectType, rdfs:Class ;
  rdfs:label "Assay Result" ;
  p:pluralLabel "Assay Results" ;
  rdfs:comment "A measured property from an experiment." ;
  p:inDomain ls:ScientificInnovation ;
  p:titleTemplate "{ls:resultValue}" .

ls:assayResultValidity a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Validity" ;
  rdfs:comment "The validity of a assay result." ;
  p:dimensionOf ls:AssayResult ;
  p:valuesFrom lst:AssayResultValidity ;
  p:order 1 .

ls:Formulation a p:ObjectType, rdfs:Class ;
  rdfs:label "Formulation" ;
  p:pluralLabel "Formulations" ;
  rdfs:comment "A compound combined with other ingredients into a product." ;
  p:inDomain ls:ScientificInnovation ;
  p:titleTemplate "{ls:formulationName}" .

ls:formulationStage a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Stage" ;
  rdfs:comment "The stage of a formulation." ;
  p:dimensionOf ls:Formulation ;
  p:valuesFrom lst:FormulationStage ;
  p:order 1 .

ls:Process a p:ObjectType, rdfs:Class ;
  rdfs:label "Process" ;
  p:pluralLabel "Processes" ;
  rdfs:comment "The approved way a formulation is manufactured." ;
  p:inDomain ls:ScientificInnovation ;
  p:titleTemplate "Manufacturing process for {ls:manufactures}" .

ls:processStatus a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Status" ;
  rdfs:comment "The status of a process." ;
  p:dimensionOf ls:Process ;
  p:valuesFrom lst:ProcessStatus ;
  p:order 1 .

ls:Batch a p:ObjectType, rdfs:Class ;
  rdfs:label "Batch" ;
  p:pluralLabel "Batches" ;
  rdfs:comment "One manufactured lot of a formulation." ;
  p:inDomain ls:ScientificInnovation ;
  skos:exactMatch ncit:C41396 ;
  p:titleTemplate "Lot {ls:lotNumber}" .

ls:batchProduction a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Production" ;
  rdfs:comment "The production of a batch." ;
  p:dimensionOf ls:Batch ;
  p:valuesFrom lst:BatchProduction ;
  p:order 1 .

ls:batchQuality a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Quality" ;
  rdfs:comment "The quality of a batch." ;
  p:dimensionOf ls:Batch ;
  p:valuesFrom lst:BatchQuality ;
  p:order 2 .

ls:batchDeviationRisk a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Deviation risk" ;
  rdfs:comment "The deviation risk of a batch." ;
  p:dimensionOf ls:Batch ;
  p:valuesFrom lst:BatchDeviationRisk ;
  p:order 3 .

ls:Study a p:ObjectType, rdfs:Class ;
  rdfs:label "Study" ;
  p:pluralLabel "Studies" ;
  rdfs:comment "A clinical trial of one or more formulations, in patients or in people without the disease." ;
  p:inDomain ls:ClinicalDevelopment ;
  skos:closeMatch ncit:C15206 ;
  p:titleTemplate "{ls:studyTitle}" .

ls:studyPhase a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Phase" ;
  rdfs:comment "The phase of a study." ;
  p:dimensionOf ls:Study ;
  p:valuesFrom lst:StudyPhase ;
  p:order 1 .

ls:studyStatus a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Status" ;
  rdfs:comment "The status of a study." ;
  p:dimensionOf ls:Study ;
  p:valuesFrom lst:StudyStatus ;
  p:order 2 .

ls:studyBlinding a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Blinding" ;
  rdfs:comment "The blinding of a study." ;
  p:dimensionOf ls:Study ;
  p:valuesFrom lst:StudyBlinding ;
  p:order 3 .

ls:Protocol a p:ObjectType, rdfs:Class ;
  rdfs:label "Protocol" ;
  p:pluralLabel "Protocols" ;
  rdfs:comment "The plan a study is conducted under: its objectives, design, eligibility and schedule of assessments. Each version is its own protocol; an amendment is a new version that amends the one before it." ;
  p:inDomain ls:ClinicalDevelopment ;
  skos:exactMatch ncit:C70817 ;
  p:titleTemplate "{ls:protocolName}, version {ls:protocolVersion} | Amendment to {ls:amends:id}" .

ls:protocolStatus a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Status" ;
  rdfs:comment "The status of a protocol." ;
  p:dimensionOf ls:Protocol ;
  p:valuesFrom lst:ProtocolStatus ;
  p:order 1 .

ls:Site a p:ObjectType, rdfs:Class ;
  rdfs:label "Site" ;
  p:pluralLabel "Sites" ;
  rdfs:comment "A hospital or clinic running the study." ;
  p:inDomain ls:ClinicalDevelopment ;
  skos:exactMatch ncit:C85838 ;
  p:titleTemplate "{ls:siteName}" .

ls:siteStatus a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Status" ;
  rdfs:comment "The status of a site." ;
  p:dimensionOf ls:Site ;
  p:valuesFrom lst:SiteStatus ;
  p:order 1 .

ls:sitePayment a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Payment" ;
  rdfs:comment "The payment of a site." ;
  p:dimensionOf ls:Site ;
  p:valuesFrom lst:SitePayment ;
  p:order 2 .

ls:Patient a p:ObjectType, rdfs:Class ;
  rdfs:label "Patient" ;
  p:pluralLabel "Patients" ;
  rdfs:comment "A person enrolled in a study. Labeled participant in studies without a disease state." ;
  p:inDomain ls:ClinicalDevelopment ;
  skos:closeMatch ncit:C16960 ;
  p:holdsPersonalData true ;
  p:titleTemplate "Patient at {ls:enrolledAt}" .

ls:patientEnrollment a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Enrollment" ;
  rdfs:comment "The enrollment of a patient." ;
  p:dimensionOf ls:Patient ;
  p:valuesFrom lst:PatientEnrollment ;
  p:order 1 .

ls:patientArm a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Arm" ;
  rdfs:comment "The arm of a patient." ;
  p:dimensionOf ls:Patient ;
  p:valuesFrom lst:PatientArm ;
  p:order 2 .

ls:patientArmVisibility a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Arm visibility" ;
  rdfs:comment "The arm visibility of a patient." ;
  p:dimensionOf ls:Patient ;
  p:valuesFrom lst:PatientArmVisibility ;
  p:order 3 .

ls:Visit a p:ObjectType, rdfs:Class ;
  rdfs:label "Visit" ;
  p:pluralLabel "Visits" ;
  rdfs:comment "A scheduled encounter with a patient." ;
  p:inDomain ls:ClinicalDevelopment ;
  skos:exactMatch ncit:C191214 ;
  p:holdsPersonalData true ;
  p:titleTemplate "{ls:visitName} for {ls:visitFor:id} | Visit for {ls:visitFor:id}" .

ls:visitStatus a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Status" ;
  rdfs:comment "The status of a visit." ;
  p:dimensionOf ls:Visit ;
  p:valuesFrom lst:VisitStatus ;
  p:order 1 .

ls:DataRecord a p:ObjectType, rdfs:Class ;
  rdfs:label "Data Record" ;
  p:pluralLabel "Data Records" ;
  rdfs:comment "A captured data point: a lab value, vital sign, diary entry or device reading." ;
  p:inDomain ls:ClinicalDevelopment ;
  p:holdsPersonalData true ;
  p:titleTemplate "{ls:recordedValue} | Data point at {ls:capturedAt:id}" .

ls:dataRecordEntry a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Entry" ;
  rdfs:comment "The entry of a data record." ;
  p:dimensionOf ls:DataRecord ;
  p:valuesFrom lst:DataRecordEntry ;
  p:order 1 .

ls:dataRecordSource a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Source" ;
  rdfs:comment "The source of a data record." ;
  p:dimensionOf ls:DataRecord ;
  p:valuesFrom lst:DataRecordSource ;
  p:order 2 .

ls:DataQuery a p:ObjectType, rdfs:Class ;
  rdfs:label "Data Query" ;
  p:pluralLabel "Data Queries" ;
  rdfs:comment "A question raised about a data record." ;
  p:inDomain ls:ClinicalDevelopment ;
  p:titleTemplate "{ls:queryText} | Query on {ls:raisedOn:id}" .

ls:dataQueryStatus a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Status" ;
  rdfs:comment "The status of a data query." ;
  p:dimensionOf ls:DataQuery ;
  p:valuesFrom lst:DataQueryStatus ;
  p:order 1 .

ls:AdverseEvent a p:ObjectType, rdfs:Class ;
  rdfs:label "Adverse Event" ;
  p:pluralLabel "Adverse Events" ;
  rdfs:comment "Something harmful that happened to a patient during the study." ;
  p:inDomain ls:ClinicalDevelopment ;
  skos:exactMatch ncit:C41331 ;
  p:holdsPersonalData true ;
  p:titleTemplate "{ls:verbatimTerm} | Adverse event for {ls:experiencedBy:id}" .

ls:adverseEventEntry a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Entry" ;
  rdfs:comment "The entry of a adverse event." ;
  p:dimensionOf ls:AdverseEvent ;
  p:valuesFrom lst:AdverseEventEntry ;
  p:order 1 .

ls:adverseEventSeriousness a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Seriousness" ;
  rdfs:comment "The seriousness of a adverse event." ;
  p:dimensionOf ls:AdverseEvent ;
  p:valuesFrom lst:AdverseEventSeriousness ;
  p:order 2 .

ls:adverseEventOutcome a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Outcome" ;
  rdfs:comment "The outcome of a adverse event." ;
  p:dimensionOf ls:AdverseEvent ;
  p:valuesFrom lst:AdverseEventOutcome ;
  p:order 3 .

ls:adverseEventReporting a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Reporting" ;
  rdfs:comment "The reporting of a adverse event." ;
  p:dimensionOf ls:AdverseEvent ;
  p:valuesFrom lst:AdverseEventReporting ;
  p:order 4 .

ls:SafetyCase a p:ObjectType, rdfs:Class ;
  rdfs:label "Safety Case" ;
  p:pluralLabel "Safety Cases" ;
  rdfs:comment "One report of an adverse reaction in one patient." ;
  p:inDomain ls:SafetyAndRegulatory ;
  p:holdsPersonalData true ;
  p:titleTemplate "{ls:reaction} with {ls:concerns} | Case from {ls:originatesFrom:id} | Case for {ls:concerns}" .

ls:safetyCaseWorkflow a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Workflow" ;
  rdfs:comment "The workflow of a safety case." ;
  p:dimensionOf ls:SafetyCase ;
  p:valuesFrom lst:SafetyCaseWorkflow ;
  p:order 1 .

ls:safetyCaseSeriousness a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Seriousness" ;
  rdfs:comment "The seriousness of a safety case." ;
  p:dimensionOf ls:SafetyCase ;
  p:valuesFrom lst:SafetyCaseSeriousness ;
  p:order 2 .

ls:safetyCaseExpectedness a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Expectedness" ;
  rdfs:comment "The expectedness of a safety case." ;
  p:dimensionOf ls:SafetyCase ;
  p:valuesFrom lst:SafetyCaseExpectedness ;
  p:order 3 .

ls:safetyCaseCausality a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Causality" ;
  rdfs:comment "The causality of a safety case." ;
  p:dimensionOf ls:SafetyCase ;
  p:valuesFrom lst:SafetyCaseCausality ;
  p:order 4 .

ls:Product a p:ObjectType, rdfs:Class ;
  rdfs:label "Product" ;
  p:pluralLabel "Products" ;
  rdfs:comment "A marketed or investigational product." ;
  p:inDomain ls:SafetyAndRegulatory ;
  skos:closeMatch ncit:C221818 ;
  p:titleTemplate "{ls:productName}" .

ls:productStatus a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Status" ;
  rdfs:comment "The status of a product." ;
  p:dimensionOf ls:Product ;
  p:valuesFrom lst:ProductStatus ;
  p:order 1 .

ls:Signal a p:ObjectType, rdfs:Class ;
  rdfs:label "Signal" ;
  p:pluralLabel "Signals" ;
  rdfs:comment "A possible new risk detected across many cases." ;
  p:inDomain ls:SafetyAndRegulatory ;
  p:titleTemplate "{ls:reaction} with {ls:concerns} | Signal for {ls:concerns}" .

ls:signalStatus a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Status" ;
  rdfs:comment "The status of a signal." ;
  p:dimensionOf ls:Signal ;
  p:valuesFrom lst:SignalStatus ;
  p:order 1 .

ls:Submission a p:ObjectType, rdfs:Class ;
  rdfs:label "Submission" ;
  p:pluralLabel "Submissions" ;
  rdfs:comment "A regulatory filing to an authority." ;
  p:inDomain ls:SafetyAndRegulatory ;
  skos:exactMatch ncit:C70885 ;
  p:titleTemplate "Expedited report for {ls:reports:id}" .

ls:submissionStatus a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Status" ;
  rdfs:comment "The status of a submission." ;
  p:dimensionOf ls:Submission ;
  p:valuesFrom lst:SubmissionStatus ;
  p:order 1 .

ls:submissionDeadline a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Deadline" ;
  rdfs:comment "The deadline of a submission." ;
  p:dimensionOf ls:Submission ;
  p:valuesFrom lst:SubmissionDeadline ;
  p:order 2 .

ls:QualityEvent a p:ObjectType, rdfs:Class ;
  rdfs:label "Quality Event" ;
  p:pluralLabel "Quality Events" ;
  rdfs:comment "A deviation, complaint or audit finding." ;
  p:inDomain ls:SafetyAndRegulatory ;
  p:titleTemplate "{ls:eventDescription} | Quality event on {ls:raisedOn:id}" .

ls:qualityEventStatus a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Status" ;
  rdfs:comment "The status of a quality event." ;
  p:dimensionOf ls:QualityEvent ;
  p:valuesFrom lst:QualityEventStatus ;
  p:order 1 .

ls:qualityEventSeverity a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Severity" ;
  rdfs:comment "The severity of a quality event." ;
  p:dimensionOf ls:QualityEvent ;
  p:valuesFrom lst:QualityEventSeverity ;
  p:order 2 .

ls:CAPA a p:ObjectType, rdfs:Class ;
  rdfs:label "CAPA" ;
  p:pluralLabel "CAPAs" ;
  rdfs:comment "A corrective and preventive action." ;
  p:inDomain ls:SafetyAndRegulatory ;
  p:titleTemplate "{ls:capaAction} | CAPA for {ls:resolves:id}" .

ls:capaStatus a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Status" ;
  rdfs:comment "The status of a capa." ;
  p:dimensionOf ls:CAPA ;
  p:valuesFrom lst:CAPAStatus ;
  p:order 1 .

ls:MedicalInquiry a p:ObjectType, rdfs:Class ;
  rdfs:label "Medical Inquiry" ;
  p:pluralLabel "Medical Inquiries" ;
  rdfs:comment "A question from a clinician or patient about a product." ;
  p:inDomain ls:SafetyAndRegulatory ;
  p:holdsPersonalData true ;
  p:titleTemplate "{ls:inquiryText}" .

ls:medicalInquiryStatus a p:StateDimension, owl:ObjectProperty ;
  rdfs:label "Status" ;
  rdfs:comment "The status of a medical inquiry." ;
  p:dimensionOf ls:MedicalInquiry ;
  p:valuesFrom lst:MedicalInquiryStatus ;
  p:order 1 .

ls:predicts a p:Relationship, owl:ObjectProperty ;
  rdfs:label "predicts" ;
  p:inverseLabel "is predicted by" ;
  p:order 1 ;
  rdfs:comment "A simulation predicts properties of a compound." .

ls:tests a p:Relationship, owl:ObjectProperty ;
  rdfs:label "tests" ;
  p:inverseLabel "is tested in" ;
  p:order 2 ;
  rdfs:comment "An experiment tests a compound; a study tests a formulation." .

ls:produces a p:Relationship, owl:ObjectProperty ;
  rdfs:label "produces" ;
  p:inverseLabel "is produced by" ;
  p:order 3 ;
  p:hasPart true ;
  rdfs:comment "An experiment produces an assay result." .

ls:contains a p:Relationship, owl:ObjectProperty ;
  rdfs:label "contains" ;
  p:inverseLabel "is contained in" ;
  p:order 4 ;
  rdfs:comment "A formulation contains a compound." .

ls:manufactures a p:Relationship, owl:ObjectProperty ;
  rdfs:label "manufactures" ;
  p:inverseLabel "is manufactured by" ;
  p:order 5 ;
  rdfs:comment "A process manufactures a formulation." .

ls:follows a p:Relationship, owl:ObjectProperty ;
  rdfs:label "follows" ;
  p:inverseLabel "is followed by" ;
  p:order 6 ;
  rdfs:comment "A batch is made by following a process." .

ls:derivedFrom a p:Relationship, owl:ObjectProperty ;
  rdfs:label "derived from" ;
  p:inverseLabel "is the source of" ;
  p:order 7 ;
  rdfs:comment "A compound is an analog derived from another." .

ls:runsAt a p:Relationship, owl:ObjectProperty ;
  rdfs:label "runs at" ;
  p:inverseLabel "hosts" ;
  p:order 8 ;
  rdfs:comment "A study runs at a site." .

ls:conductedUnder a p:Relationship, owl:ObjectProperty ;
  rdfs:label "conducted under" ;
  p:inverseLabel "governs" ;
  p:order 9 ;
  rdfs:comment "A study is conducted under the protocol version in force." .

ls:amends a p:Relationship, owl:ObjectProperty ;
  rdfs:label "amends" ;
  p:inverseLabel "is amended by" ;
  p:order 10 ;
  rdfs:comment "A protocol version amends the version before it." .

ls:enrolledIn a p:Relationship, owl:ObjectProperty ;
  rdfs:label "enrolled in" ;
  p:inverseLabel "enrolls" ;
  p:order 11 ;
  p:partOf true ;
  rdfs:comment "A patient is enrolled in a study." .

ls:enrolledAt a p:Relationship, owl:ObjectProperty ;
  rdfs:label "enrolled at" ;
  p:inverseLabel "enrolls" ;
  p:order 12 ;
  rdfs:comment "A patient is enrolled at a site." .

ls:receives a p:Relationship, owl:ObjectProperty ;
  rdfs:label "receives" ;
  p:inverseLabel "is received by" ;
  p:order 13 ;
  rdfs:comment "A patient receives study drug from a batch." .

ls:visitFor a p:Relationship, owl:ObjectProperty ;
  rdfs:label "for" ;
  p:inverseLabel "has" ;
  p:order 14 ;
  p:partOf true ;
  rdfs:comment "A visit is for a patient." .

ls:capturedAt a p:Relationship, owl:ObjectProperty ;
  rdfs:label "captured at" ;
  p:inverseLabel "captures" ;
  p:order 15 ;
  p:partOf true ;
  rdfs:comment "A data record is captured at a visit." .

ls:raisedOn a p:Relationship, owl:ObjectProperty ;
  rdfs:label "raised on" ;
  p:inverseLabel "has" ;
  p:order 16 ;
  p:partOf true ;
  rdfs:comment "A data query is raised on a data record; a quality event on a batch." .

ls:experiencedBy a p:Relationship, owl:ObjectProperty ;
  rdfs:label "experienced by" ;
  p:inverseLabel "experienced" ;
  p:order 17 ;
  p:partOf true ;
  rdfs:comment "An adverse event is experienced by a patient." .

ls:originatesFrom a p:Relationship, owl:ObjectProperty ;
  rdfs:label "originates from" ;
  p:inverseLabel "is the source of" ;
  p:order 18 ;
  rdfs:comment "A safety case originates from an adverse event or a medical inquiry." .

ls:concerns a p:Relationship, owl:ObjectProperty ;
  rdfs:label "concerns" ;
  p:inverseLabel "is named in" ;
  p:order 19 ;
  rdfs:comment "A safety case or signal concerns a product." .

ls:isFormulation a p:Relationship, owl:ObjectProperty ;
  rdfs:label "is" ;
  p:inverseLabel "is marketed as" ;
  p:order 20 ;
  rdfs:comment "A product is a formulation." .

ls:mayInvolve a p:Relationship, owl:ObjectProperty ;
  rdfs:label "may involve" ;
  p:inverseLabel "may be involved in" ;
  p:order 21 ;
  rdfs:comment "A safety case may involve a batch." .

ls:aggregates a p:Relationship, owl:ObjectProperty ;
  rdfs:label "aggregates" ;
  p:inverseLabel "is aggregated in" ;
  p:order 22 ;
  rdfs:comment "A signal aggregates safety cases." .

ls:reports a p:Relationship, owl:ObjectProperty ;
  rdfs:label "reports" ;
  p:inverseLabel "is reported in" ;
  p:order 23 ;
  rdfs:comment "A submission reports a safety case or a signal." .

ls:resolves a p:Relationship, owl:ObjectProperty ;
  rdfs:label "resolves" ;
  p:inverseLabel "is resolved by" ;
  p:order 24 ;
  p:partOf true ;
  rdfs:comment "A CAPA resolves a quality event." .

ls:duplicateOf a p:Relationship, owl:ObjectProperty ;
  rdfs:label "duplicate of" ;
  p:inverseLabel "is duplicated by" ;
  p:order 25 ;
  rdfs:comment "A safety case duplicates another." .

ls:reaction a owl:ObjectProperty ;
  rdfs:label "reaction" ;
  rdfs:comment "An adverse reaction, coded. A case may have several; a signal is for one." ;
  p:valuesFrom lst:Reaction .

ls:compoundName a owl:DatatypeProperty ;
  rdfs:label "name" ;
  rdfs:comment "The compound's code and what it is." .

ls:modelType a owl:DatatypeProperty ;
  rdfs:label "model type" ;
  rdfs:comment "The kind of model the simulation ran, such as ADMET." .

ls:aim a owl:DatatypeProperty ;
  rdfs:label "aim" ;
  rdfs:comment "What the experiment set out to measure." .

ls:resultValue a owl:DatatypeProperty ;
  rdfs:label "result" ;
  rdfs:comment "The measured result, with its units." .

ls:formulationName a owl:DatatypeProperty ;
  rdfs:label "name" ;
  rdfs:comment "The formulation's name: product, strength and dosage form." .

ls:lotNumber a owl:DatatypeProperty ;
  rdfs:label "lot number" ;
  rdfs:comment "The batch's lot number." .

ls:studyTitle a owl:DatatypeProperty ;
  rdfs:label "title" ;
  rdfs:comment "The study's short name and title." .

ls:siteName a owl:DatatypeProperty ;
  rdfs:label "name" ;
  rdfs:comment "The site's name." .

ls:protocolName a owl:DatatypeProperty ;
  rdfs:label "name" ;
  rdfs:comment "The protocol's short name, usually the study's." .

ls:protocolVersion a owl:DatatypeProperty ;
  rdfs:label "version" ;
  rdfs:comment "The protocol's version number, such as 2.0." .

ls:primaryObjective a owl:DatatypeProperty ;
  rdfs:label "primary objective" ;
  rdfs:comment "What the study must show, as the protocol states it." .

ls:plannedEnrollment a owl:DatatypeProperty ;
  rdfs:label "planned enrollment" ;
  rdfs:comment "How many patients the protocol plans to enroll." .

ls:effectiveOn a owl:DatatypeProperty ;
  rdfs:label "effective on" ;
  rdfs:comment "The date the version came into force." .

ls:amendmentSummary a owl:DatatypeProperty ;
  rdfs:label "amendment summary" ;
  rdfs:comment "What an amendment changes, and why." .

ls:visitName a owl:DatatypeProperty ;
  rdfs:label "visit" ;
  rdfs:comment "The visit's name in the schedule of assessments, such as Week 12 visit." .

ls:queryText a owl:DatatypeProperty ;
  rdfs:label "question" ;
  rdfs:comment "What the query asks the site." .

ls:productName a owl:DatatypeProperty ;
  rdfs:label "name" ;
  rdfs:comment "The product's name and strength." .

ls:eventDescription a owl:DatatypeProperty ;
  rdfs:label "description" ;
  rdfs:comment "What happened, as recorded when the event was opened." .

ls:capaAction a owl:DatatypeProperty ;
  rdfs:label "action" ;
  rdfs:comment "The corrective or preventive action to take." .

ls:inquiryText a owl:DatatypeProperty ;
  rdfs:label "question" ;
  rdfs:comment "What the clinician or patient asked." .

ls:receivedOn a owl:DatatypeProperty ;
  rdfs:label "received on" ;
  rdfs:comment "The date the safety case was received." .

ls:narrative a owl:DatatypeProperty ;
  rdfs:label "narrative" ;
  rdfs:comment "The case narrative, as a person accepted it." .

ls:dueOn a owl:DatatypeProperty ;
  rdfs:label "due on" ;
  rdfs:comment "The date the submission is due." ;
  p:isDeadline true .

ls:scheduledOn a owl:DatatypeProperty ;
  rdfs:label "scheduled on" ;
  rdfs:comment "The date the visit is scheduled for. A deadline until the visit is completed or missed." ;
  p:isDeadline true .

ls:recordedValue a owl:DatatypeProperty ;
  rdfs:label "value" ;
  rdfs:comment "The value captured, as recorded at the site." .

ls:verbatimTerm a owl:DatatypeProperty ;
  rdfs:label "verbatim term" ;
  rdfs:comment "The event as the site reported it, in its own words, before coding." .

ls:missedReason a owl:DatatypeProperty ;
  rdfs:label "reason missed" ;
  rdfs:comment "Why the visit did not take place." .

ls:preparedBy a owl:ObjectProperty ;
  rdfs:label "prepared by" ;
  rdfs:comment "The person who prepared the submission." .

ls:assignedArm a owl:DatatypeProperty ;
  rdfs:label "assigned arm" ;
  rdfs:comment "The study arm the patient was randomized to. Hidden while the study is blinded (rule 2)." .

# Shapes

lsh:Compound-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:Compound-stage a sh:PropertyShape ;
  sh:path ls:compoundStage ;
  sh:in ( lst:CompoundStage-designed lst:CompoundStage-synthesized lst:CompoundStage-tested lst:CompoundStage-candidate lst:CompoundStage-retired ) ;
  sh:maxCount 1 ;
  sh:name "Stage" .

lsh:Compound-registration a sh:PropertyShape ;
  sh:path ls:compoundRegistration ;
  sh:in ( lst:CompoundRegistration-unregistered lst:CompoundRegistration-registered ) ;
  sh:maxCount 1 ;
  sh:name "Registration" .

lsh:Compound-derivedFrom a sh:PropertyShape ;
  sh:path ls:derivedFrom ;
  sh:class ls:Compound ;
  sh:maxCount 1 ;
  sh:name "derived from" .

lsh:Compound-compoundName a sh:PropertyShape ;
  sh:path ls:compoundName ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "name" .

lsh:Compound a sh:NodeShape ;
  sh:targetClass ls:Compound ;
  sh:property lsh:Compound-identifier, lsh:Compound-stage, lsh:Compound-registration, lsh:Compound-derivedFrom, lsh:Compound-compoundName .

lsh:Simulation-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:Simulation-run a sh:PropertyShape ;
  sh:path ls:simulationRun ;
  sh:in ( lst:SimulationRun-queued lst:SimulationRun-running lst:SimulationRun-complete lst:SimulationRun-failed ) ;
  sh:maxCount 1 ;
  sh:name "Run" .

lsh:Simulation-review a sh:PropertyShape ;
  sh:path ls:simulationReview ;
  sh:in ( lst:SimulationReview-unreviewed lst:SimulationReview-accepted lst:SimulationReview-rejected ) ;
  sh:maxCount 1 ;
  sh:name "Review" .

lsh:Simulation-predicts a sh:PropertyShape ;
  sh:path ls:predicts ;
  sh:class ls:Compound ;
  sh:maxCount 1 ;
  sh:name "predicts" .

lsh:Simulation-modelType a sh:PropertyShape ;
  sh:path ls:modelType ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "model type" .

lsh:Simulation a sh:NodeShape ;
  sh:targetClass ls:Simulation ;
  sh:property lsh:Simulation-identifier, lsh:Simulation-run, lsh:Simulation-review, lsh:Simulation-predicts, lsh:Simulation-modelType .

lsh:Experiment-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:Experiment-record a sh:PropertyShape ;
  sh:path ls:experimentRecord ;
  sh:in ( lst:ExperimentRecord-planned lst:ExperimentRecord-inProgress lst:ExperimentRecord-complete ) ;
  sh:maxCount 1 ;
  sh:name "Record" .

lsh:Experiment-signOff a sh:PropertyShape ;
  sh:path ls:experimentSignOff ;
  sh:in ( lst:ExperimentSignOff-unsigned lst:ExperimentSignOff-signed lst:ExperimentSignOff-witnessed ) ;
  sh:maxCount 1 ;
  sh:name "Sign-off" .

lsh:Experiment-tests a sh:PropertyShape ;
  sh:path ls:tests ;
  sh:class ls:Compound ;
  sh:name "tests" .

lsh:Experiment-produces a sh:PropertyShape ;
  sh:path ls:produces ;
  sh:class ls:AssayResult ;
  sh:name "produces" .

lsh:Experiment-aim a sh:PropertyShape ;
  sh:path ls:aim ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "aim" .

lsh:Experiment a sh:NodeShape ;
  sh:targetClass ls:Experiment ;
  sh:property lsh:Experiment-identifier, lsh:Experiment-record, lsh:Experiment-signOff, lsh:Experiment-tests, lsh:Experiment-produces, lsh:Experiment-aim .

lsh:AssayResult-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:AssayResult-validity a sh:PropertyShape ;
  sh:path ls:assayResultValidity ;
  sh:in ( lst:AssayResultValidity-valid lst:AssayResultValidity-invalidated ) ;
  sh:maxCount 1 ;
  sh:name "Validity" .

lsh:AssayResult-resultValue a sh:PropertyShape ;
  sh:path ls:resultValue ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "result" .

lsh:AssayResult a sh:NodeShape ;
  sh:targetClass ls:AssayResult ;
  sh:property lsh:AssayResult-identifier, lsh:AssayResult-validity, lsh:AssayResult-resultValue .

lsh:Formulation-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:Formulation-stage a sh:PropertyShape ;
  sh:path ls:formulationStage ;
  sh:in ( lst:FormulationStage-draft lst:FormulationStage-underTest lst:FormulationStage-approved lst:FormulationStage-obsolete ) ;
  sh:maxCount 1 ;
  sh:name "Stage" .

lsh:Formulation-contains a sh:PropertyShape ;
  sh:path ls:contains ;
  sh:class ls:Compound ;
  sh:name "contains" .

lsh:Formulation-formulationName a sh:PropertyShape ;
  sh:path ls:formulationName ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "name" .

lsh:Formulation a sh:NodeShape ;
  sh:targetClass ls:Formulation ;
  sh:property lsh:Formulation-identifier, lsh:Formulation-stage, lsh:Formulation-contains, lsh:Formulation-formulationName .

lsh:Process-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:Process-status a sh:PropertyShape ;
  sh:path ls:processStatus ;
  sh:in ( lst:ProcessStatus-draft lst:ProcessStatus-validated lst:ProcessStatus-superseded ) ;
  sh:maxCount 1 ;
  sh:name "Status" .

lsh:Process-manufactures a sh:PropertyShape ;
  sh:path ls:manufactures ;
  sh:class ls:Formulation ;
  sh:maxCount 1 ;
  sh:name "manufactures" .

lsh:Process a sh:NodeShape ;
  sh:targetClass ls:Process ;
  sh:property lsh:Process-identifier, lsh:Process-status, lsh:Process-manufactures .

lsh:Batch-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:Batch-production a sh:PropertyShape ;
  sh:path ls:batchProduction ;
  sh:in ( lst:BatchProduction-planned lst:BatchProduction-inProduction lst:BatchProduction-complete ) ;
  sh:maxCount 1 ;
  sh:name "Production" .

lsh:Batch-quality a sh:PropertyShape ;
  sh:path ls:batchQuality ;
  sh:in ( lst:BatchQuality-pending lst:BatchQuality-released lst:BatchQuality-quarantined lst:BatchQuality-rejected ) ;
  sh:maxCount 1 ;
  sh:name "Quality" .

lsh:Batch-deviationRisk a sh:PropertyShape ;
  sh:path ls:batchDeviationRisk ;
  sh:in ( lst:BatchDeviationRisk-low lst:BatchDeviationRisk-elevated lst:BatchDeviationRisk-high ) ;
  sh:maxCount 1 ;
  sh:name "Deviation risk" .

lsh:Batch-follows a sh:PropertyShape ;
  sh:path ls:follows ;
  sh:class ls:Process ;
  sh:maxCount 1 ;
  sh:name "follows" .

lsh:Batch-lotNumber a sh:PropertyShape ;
  sh:path ls:lotNumber ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "lot number" .

lsh:Batch a sh:NodeShape ;
  sh:targetClass ls:Batch ;
  sh:property lsh:Batch-identifier, lsh:Batch-production, lsh:Batch-quality, lsh:Batch-deviationRisk, lsh:Batch-follows, lsh:Batch-lotNumber .

lsh:Study-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:Study-phase a sh:PropertyShape ;
  sh:path ls:studyPhase ;
  sh:in ( lst:StudyPhase-i lst:StudyPhase-ii lst:StudyPhase-iii ) ;
  sh:maxCount 1 ;
  sh:name "Phase" .

lsh:Study-status a sh:PropertyShape ;
  sh:path ls:studyStatus ;
  sh:in ( lst:StudyStatus-planned lst:StudyStatus-enrolling lst:StudyStatus-active lst:StudyStatus-closed lst:StudyStatus-locked ) ;
  sh:maxCount 1 ;
  sh:name "Status" .

lsh:Study-blinding a sh:PropertyShape ;
  sh:path ls:studyBlinding ;
  sh:in ( lst:StudyBlinding-blinded lst:StudyBlinding-unblinded ) ;
  sh:maxCount 1 ;
  sh:name "Blinding" .

lsh:Study-tests a sh:PropertyShape ;
  sh:path ls:tests ;
  sh:class ls:Formulation ;
  sh:name "tests" .

lsh:Study-runsAt a sh:PropertyShape ;
  sh:path ls:runsAt ;
  sh:class ls:Site ;
  sh:name "runs at" .

lsh:Study-conductedUnder a sh:PropertyShape ;
  sh:path ls:conductedUnder ;
  sh:class ls:Protocol ;
  sh:maxCount 1 ;
  sh:name "conducted under" .

lsh:Study-studyTitle a sh:PropertyShape ;
  sh:path ls:studyTitle ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "title" .

lsh:Study a sh:NodeShape ;
  sh:targetClass ls:Study ;
  sh:property lsh:Study-identifier, lsh:Study-phase, lsh:Study-status, lsh:Study-blinding, lsh:Study-tests, lsh:Study-runsAt, lsh:Study-conductedUnder, lsh:Study-studyTitle .

lsh:Protocol-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:Protocol-status a sh:PropertyShape ;
  sh:path ls:protocolStatus ;
  sh:in ( lst:ProtocolStatus-draft lst:ProtocolStatus-inReview lst:ProtocolStatus-approved lst:ProtocolStatus-superseded ) ;
  sh:maxCount 1 ;
  sh:name "Status" .

lsh:Protocol-amends a sh:PropertyShape ;
  sh:path ls:amends ;
  sh:class ls:Protocol ;
  sh:maxCount 1 ;
  sh:name "amends" .

lsh:Protocol-protocolName a sh:PropertyShape ;
  sh:path ls:protocolName ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "name" .

lsh:Protocol-protocolVersion a sh:PropertyShape ;
  sh:path ls:protocolVersion ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "version" .

lsh:Protocol-primaryObjective a sh:PropertyShape ;
  sh:path ls:primaryObjective ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "primary objective" .

lsh:Protocol-plannedEnrollment a sh:PropertyShape ;
  sh:path ls:plannedEnrollment ;
  sh:datatype xsd:integer ;
  sh:maxCount 1 ;
  sh:name "planned enrollment" .

lsh:Protocol-effectiveOn a sh:PropertyShape ;
  sh:path ls:effectiveOn ;
  sh:datatype xsd:date ;
  sh:maxCount 1 ;
  sh:name "effective on" .

lsh:Protocol-amendmentSummary a sh:PropertyShape ;
  sh:path ls:amendmentSummary ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "amendment summary" .

lsh:Protocol a sh:NodeShape ;
  sh:targetClass ls:Protocol ;
  sh:property lsh:Protocol-identifier, lsh:Protocol-status, lsh:Protocol-amends, lsh:Protocol-protocolName, lsh:Protocol-protocolVersion, lsh:Protocol-primaryObjective, lsh:Protocol-plannedEnrollment, lsh:Protocol-effectiveOn, lsh:Protocol-amendmentSummary .

lsh:Site-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:Site-status a sh:PropertyShape ;
  sh:path ls:siteStatus ;
  sh:in ( lst:SiteStatus-selected lst:SiteStatus-activated lst:SiteStatus-closed ) ;
  sh:maxCount 1 ;
  sh:name "Status" .

lsh:Site-payment a sh:PropertyShape ;
  sh:path ls:sitePayment ;
  sh:in ( lst:SitePayment-current lst:SitePayment-overdue ) ;
  sh:maxCount 1 ;
  sh:name "Payment" .

lsh:Site-siteName a sh:PropertyShape ;
  sh:path ls:siteName ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "name" .

lsh:Site a sh:NodeShape ;
  sh:targetClass ls:Site ;
  sh:property lsh:Site-identifier, lsh:Site-status, lsh:Site-payment, lsh:Site-siteName .

lsh:Patient-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:Patient-enrollment a sh:PropertyShape ;
  sh:path ls:patientEnrollment ;
  sh:in ( lst:PatientEnrollment-screened lst:PatientEnrollment-consented lst:PatientEnrollment-randomized lst:PatientEnrollment-completed lst:PatientEnrollment-withdrawn ) ;
  sh:maxCount 1 ;
  sh:name "Enrollment" .

lsh:Patient-arm a sh:PropertyShape ;
  sh:path ls:patientArm ;
  sh:in ( lst:PatientArm-unassigned lst:PatientArm-assigned ) ;
  sh:maxCount 1 ;
  sh:name "Arm" .

lsh:Patient-armVisibility a sh:PropertyShape ;
  sh:path ls:patientArmVisibility ;
  sh:in ( lst:PatientArmVisibility-hidden lst:PatientArmVisibility-revealed ) ;
  sh:maxCount 1 ;
  sh:name "Arm visibility" .

lsh:Patient-enrolledIn a sh:PropertyShape ;
  sh:path ls:enrolledIn ;
  sh:class ls:Study ;
  sh:maxCount 1 ;
  sh:name "enrolled in" .

lsh:Patient-enrolledAt a sh:PropertyShape ;
  sh:path ls:enrolledAt ;
  sh:class ls:Site ;
  sh:maxCount 1 ;
  sh:name "enrolled at" .

lsh:Patient-receives a sh:PropertyShape ;
  sh:path ls:receives ;
  sh:class ls:Batch ;
  sh:name "receives" .

lsh:Patient-assignedArm a sh:PropertyShape ;
  sh:path ls:assignedArm ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "assigned arm" .

lsh:Patient a sh:NodeShape ;
  sh:targetClass ls:Patient ;
  sh:property lsh:Patient-identifier, lsh:Patient-enrollment, lsh:Patient-arm, lsh:Patient-armVisibility, lsh:Patient-enrolledIn, lsh:Patient-enrolledAt, lsh:Patient-receives, lsh:Patient-assignedArm .

lsh:Visit-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
