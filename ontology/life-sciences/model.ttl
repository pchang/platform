  sh:name "for" .

lsh:Visit a sh:NodeShape ;
  sh:targetClass ls:Visit ;
  sh:property lsh:Visit-identifier, lsh:Visit-status, lsh:Visit-visitFor .

lsh:DataRecord-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:DataRecord-entry a sh:PropertyShape ;
  sh:path ls:dataRecordEntry ;
  sh:in ( lst:DataRecordEntry-entered lst:DataRecordEntry-verified ) ;
  sh:maxCount 1 ;
