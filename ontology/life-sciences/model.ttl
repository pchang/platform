lsh:Patient-armVisibility a sh:PropertyShape ;
  sh:path ls:patientArmVisibility ;
  sh:in ( lst:PatientArmVisibility-hidden lst:PatientArmVisibility-revealed ) ;
  sh:maxCount 1 ;
  sh:name "Arm visibility" .

lsh:Patient-enrolledIn a sh:PropertyShape ;
  sh:path ls:enrolledIn ;
  sh:class ls:Study ;
  sh:name "enrolled in" .

lsh:Patient-enrolledAt a sh:PropertyShape ;
  sh:path ls:enrolledAt ;
  sh:class ls:Site ;
  sh:name "enrolled at" .

lsh:Patient-receives a sh:PropertyShape ;
  sh:path ls:receives ;
  sh:class ls:Batch ;
  sh:name "receives" .

lsh:Patient-assignedArm a sh:PropertyShape ;
  sh:path ls:assignedArm ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
  sh:name "assigned arm" .

lsh:Patient a sh:NodeShape ;
  sh:targetClass ls:Patient ;
  sh:property lsh:Patient-identifier, lsh:Patient-enrollment, lsh:Patient-arm, lsh:Patient-armVisibility, lsh:Patient-enrolledIn, lsh:Patient-enrolledAt, lsh:Patient-receives, lsh:Patient-assignedArm .

lsh:Visit-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:Visit-status a sh:PropertyShape ;
  sh:path ls:visitStatus ;
  sh:in ( lst:VisitStatus-scheduled lst:VisitStatus-completed lst:VisitStatus-missed ) ;
