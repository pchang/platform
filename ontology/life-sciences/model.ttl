lsh:DataRecord-source a sh:PropertyShape ;
  sh:path ls:dataRecordSource ;
  sh:in ( lst:DataRecordSource-site lst:DataRecordSource-patient lst:DataRecordSource-device lst:DataRecordSource-healthRecord ) ;
  sh:maxCount 1 ;
  sh:name "Source" .

lsh:DataRecord-capturedAt a sh:PropertyShape ;
  sh:path ls:capturedAt ;
  sh:class ls:Visit ;
  sh:name "captured at" .

lsh:DataRecord a sh:NodeShape ;
  sh:targetClass ls:DataRecord ;
  sh:property lsh:DataRecord-identifier, lsh:DataRecord-entry, lsh:DataRecord-source, lsh:DataRecord-capturedAt .

lsh:DataQuery-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:DataQuery-status a sh:PropertyShape ;
  sh:path ls:dataQueryStatus ;
  sh:in ( lst:DataQueryStatus-open lst:DataQueryStatus-answered lst:DataQueryStatus-closed ) ;
