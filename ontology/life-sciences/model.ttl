lsh:AdverseEvent-seriousness a sh:PropertyShape ;
  sh:path ls:adverseEventSeriousness ;
  sh:in ( lst:AdverseEventSeriousness-nonSerious lst:AdverseEventSeriousness-serious ) ;
  sh:maxCount 1 ;
  sh:name "Seriousness" .

lsh:AdverseEvent-outcome a sh:PropertyShape ;
  sh:path ls:adverseEventOutcome ;
  sh:in ( lst:AdverseEventOutcome-ongoing lst:AdverseEventOutcome-resolved ) ;
  sh:maxCount 1 ;
  sh:name "Outcome" .

lsh:AdverseEvent-reporting a sh:PropertyShape ;
  sh:path ls:adverseEventReporting ;
  sh:in ( lst:AdverseEventReporting-notReported lst:AdverseEventReporting-reportedToSafety ) ;
  sh:maxCount 1 ;
  sh:name "Reporting" .

lsh:AdverseEvent-experiencedBy a sh:PropertyShape ;
  sh:path ls:experiencedBy ;
  sh:class ls:Patient ;
  sh:name "experienced by" .

lsh:AdverseEvent a sh:NodeShape ;
  sh:targetClass ls:AdverseEvent ;
  sh:property lsh:AdverseEvent-identifier, lsh:AdverseEvent-entry, lsh:AdverseEvent-seriousness, lsh:AdverseEvent-outcome, lsh:AdverseEvent-reporting, lsh:AdverseEvent-experiencedBy .

lsh:SafetyCase-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:SafetyCase-workflow a sh:PropertyShape ;
  sh:path ls:safetyCaseWorkflow ;
  sh:in ( lst:SafetyCaseWorkflow-received lst:SafetyCaseWorkflow-triaged lst:SafetyCaseWorkflow-assessed lst:SafetyCaseWorkflow-reported lst:SafetyCaseWorkflow-closed ) ;
  sh:maxCount 1 ;
  sh:name "Workflow" .

lsh:SafetyCase-seriousness a sh:PropertyShape ;
  sh:path ls:safetyCaseSeriousness ;
  sh:in ( lst:SafetyCaseSeriousness-nonSerious lst:SafetyCaseSeriousness-serious ) ;
  sh:maxCount 1 ;
  sh:name "Seriousness" .

lsh:SafetyCase-expectedness a sh:PropertyShape ;
  sh:path ls:safetyCaseExpectedness ;
  sh:in ( lst:SafetyCaseExpectedness-expected lst:SafetyCaseExpectedness-unexpected ) ;
  sh:maxCount 1 ;
  sh:name "Expectedness" .

lsh:SafetyCase-causality a sh:PropertyShape ;
  sh:path ls:safetyCaseCausality ;
  sh:in ( lst:SafetyCaseCausality-unassessed lst:SafetyCaseCausality-unrelated lst:SafetyCaseCausality-possible lst:SafetyCaseCausality-probable ) ;
  sh:maxCount 1 ;
  sh:name "Causality" .

lsh:SafetyCase-originatesFrom a sh:PropertyShape ;
  sh:path ls:originatesFrom ;
  sh:or ( lsh:IsAdverseEvent lsh:IsMedicalInquiry ) ;
  sh:name "originates from" .

lsh:SafetyCase-concerns a sh:PropertyShape ;
  sh:path ls:concerns ;
  sh:class ls:Product ;
  sh:name "concerns" .

lsh:SafetyCase-mayInvolve a sh:PropertyShape ;
  sh:path ls:mayInvolve ;
  sh:class ls:Batch ;
  sh:name "may involve" .

lsh:SafetyCase-duplicateOf a sh:PropertyShape ;
  sh:path ls:duplicateOf ;
  sh:class ls:SafetyCase ;
  sh:name "duplicate of" .

lsh:SafetyCase-receivedOn a sh:PropertyShape ;
  sh:path ls:receivedOn ;
  sh:datatype xsd:date ;
  sh:maxCount 1 ;
  sh:name "received on" .

lsh:SafetyCase a sh:NodeShape ;
  sh:targetClass ls:SafetyCase ;
  sh:property lsh:SafetyCase-identifier, lsh:SafetyCase-workflow, lsh:SafetyCase-seriousness, lsh:SafetyCase-expectedness, lsh:SafetyCase-causality, lsh:SafetyCase-originatesFrom, lsh:SafetyCase-concerns, lsh:SafetyCase-mayInvolve, lsh:SafetyCase-duplicateOf, lsh:SafetyCase-receivedOn .

lsh:Product-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:Product-status a sh:PropertyShape ;
  sh:path ls:productStatus ;
  sh:in ( lst:ProductStatus-investigational lst:ProductStatus-approved lst:ProductStatus-withdrawn ) ;
  sh:maxCount 1 ;
  sh:name "Status" .

lsh:Product-isFormulation a sh:PropertyShape ;
  sh:path ls:isFormulation ;
  sh:class ls:Formulation ;
  sh:name "is" .

lsh:Product a sh:NodeShape ;
  sh:targetClass ls:Product ;
  sh:property lsh:Product-identifier, lsh:Product-status, lsh:Product-isFormulation .

lsh:Signal-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:Signal-status a sh:PropertyShape ;
  sh:path ls:signalStatus ;
  sh:in ( lst:SignalStatus-detected lst:SignalStatus-underEvaluation lst:SignalStatus-confirmed lst:SignalStatus-refuted ) ;
  sh:maxCount 1 ;
  sh:name "Status" .

lsh:Signal-concerns a sh:PropertyShape ;
  sh:path ls:concerns ;
  sh:class ls:Product ;
  sh:name "concerns" .

lsh:Signal-aggregates a sh:PropertyShape ;
  sh:path ls:aggregates ;
  sh:class ls:SafetyCase ;
  sh:name "aggregates" .

lsh:Signal a sh:NodeShape ;
  sh:targetClass ls:Signal ;
  sh:property lsh:Signal-identifier, lsh:Signal-status, lsh:Signal-concerns, lsh:Signal-aggregates .

lsh:Submission-identifier a sh:PropertyShape ;
  sh:path ls:identifier ;
  sh:datatype xsd:string ;
  sh:maxCount 1 .

lsh:Submission-status a sh:PropertyShape ;
  sh:path ls:submissionStatus ;
  sh:in ( lst:SubmissionStatus-draft lst:SubmissionStatus-inReview lst:SubmissionStatus-submitted lst:SubmissionStatus-acknowledged ) ;
  sh:maxCount 1 ;
  sh:name "Status" .

lsh:Submission-deadline a sh:PropertyShape ;
  sh:path ls:submissionDeadline ;
  sh:in ( lst:SubmissionDeadline-onTrack lst:SubmissionDeadline-dueSoon lst:SubmissionDeadline-overdue ) ;
  sh:maxCount 1 ;
  sh:name "Deadline" .

lsh:Submission-reports a sh:PropertyShape ;
  sh:path ls:reports ;
  sh:or ( lsh:IsSafetyCase lsh:IsSignal ) ;
  sh:name "reports" .

lsh:Submission-dueOn a sh:PropertyShape ;
  sh:path ls:dueOn ;
  sh:datatype xsd:date ;
  sh:maxCount 1 ;
  sh:name "due on" .

lsh:Submission-preparedBy a sh:PropertyShape ;
  sh:path ls:preparedBy ;
  sh:nodeKind sh:IRI ;
  sh:maxCount 1 ;
  sh:name "prepared by" .

lsh:Submission a sh:NodeShape ;
  sh:targetClass ls:Submission ;
  sh:property lsh:Submission-identifier, lsh:Submission-status, lsh:Submission-deadline, lsh:Submission-reports, lsh:Submission-dueOn, lsh:Submission-preparedBy .

lsh:QualityEvent-identifier a sh:PropertyShape ;
