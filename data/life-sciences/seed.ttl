# 3 adverse events. AE-003 starts J1: serious, verified, not yet reported to safety.

d:AE-001 a ls:AdverseEvent ;
  ls:identifier "AE-001" ;
  ls:experiencedBy d:PT-02 ;
  ls:adverseEventEntry lst:AdverseEventEntry-verified ;
  ls:adverseEventSeriousness lst:AdverseEventSeriousness-nonSerious ;
  ls:adverseEventOutcome lst:AdverseEventOutcome-resolved ;
  ls:adverseEventReporting lst:AdverseEventReporting-reportedToSafety .

