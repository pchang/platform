# LS&H seed graph for the life sciences thread (domain spec section 11).
# Small and fictional: every name, compound, site, person and record is invented.
# Used for development and automated testing only. Never mix with real records.

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix p:    <https://w3id.org/lsh-platform/platform#> .
@prefix ls:   <https://w3id.org/lsh-platform/life-sciences#> .
@prefix lst:  <https://w3id.org/lsh-platform/life-sciences/term#> .
@prefix d:    <https://example.org/lsh-data/> .

# People: one per persona, a second Drug Safety Physician for separation of duties (rule 5), and an external CRO agent.

d:person-ada a p:Person ;
  rdfs:label "Ada Moreno" ;
  p:actsAs ls:ComputationalChemist .

d:person-ben a p:Person ;
  rdfs:label "Ben Okafor" ;
  p:actsAs ls:ClinicalDataManager .

d:person-chloe a p:Person ;
  rdfs:label "Chloé Martin" ;
  p:actsAs ls:DrugSafetyPhysician .

d:person-dev a p:Person ;
  rdfs:label "Dev Raman" ;
  p:actsAs ls:DrugSafetyPhysician .

d:person-elena a p:Person ;
  rdfs:label "Elena Kovacs" ;
  p:actsAs ls:QualityLead .

d:person-priya a p:Person ;
  rdfs:label "Priya Natarajan" ;
  p:actsAs ls:ClinicalResearchAssociate .

d:person-sam a p:Person ;
  rdfs:label "Sam Whitfield" ;
  p:actsAs ls:ClinicalResearchCoordinator .

d:agent-northbridge a p:Person ;
  rdfs:label "Northbridge CRO agent" ;
  p:actsAs ls:ExternalCROAgent ;
  p:isAgent true .

# Scientific Innovation: 5 compounds, including 1 candidate and 2 analogs

d:C-101 a ls:Compound ;
  ls:identifier "C-101" ;
  ls:compoundStage lst:CompoundStage-candidate ;
  ls:compoundRegistration lst:CompoundRegistration-registered ;
  ls:compoundName "LSH-4471, JAK1 inhibitor" .

d:C-102 a ls:Compound ;
  ls:identifier "C-102" ;
  ls:compoundStage lst:CompoundStage-tested ;
  ls:compoundRegistration lst:CompoundRegistration-registered ;
  ls:compoundName "LSH-4388, JAK1 inhibitor" .

d:C-103 a ls:Compound ;
  ls:identifier "C-103" ;
  ls:compoundStage lst:CompoundStage-synthesized ;
  ls:compoundRegistration lst:CompoundRegistration-unregistered ;
  ls:compoundName "LSH-4502, JAK1 inhibitor" .

d:C-104 a ls:Compound ;
  ls:identifier "C-104" ;
  ls:compoundStage lst:CompoundStage-designed ;
  ls:compoundRegistration lst:CompoundRegistration-unregistered ;
  ls:derivedFrom d:C-101 ;
  ls:compoundName "LSH-4471-F2, fluorinated analog" .

d:C-105 a ls:Compound ;
  ls:identifier "C-105" ;
  ls:compoundStage lst:CompoundStage-designed ;
  ls:compoundRegistration lst:CompoundRegistration-unregistered ;
  ls:derivedFrom d:C-101 ;
  ls:compoundName "LSH-4471-M1, methyl analog" .

d:SIM-1 a ls:Simulation ;
  ls:identifier "SIM-1" ;
  ls:predicts d:C-101 ;
  ls:simulationRun lst:SimulationRun-complete ;
  ls:simulationReview lst:SimulationReview-accepted ;
  ls:modelType "ADMET" .

d:SIM-2 a ls:Simulation ;
  ls:identifier "SIM-2" ;
  ls:predicts d:C-102 ;
  ls:simulationRun lst:SimulationRun-complete ;
  ls:simulationReview lst:SimulationReview-unreviewed ;
  ls:modelType "Aqueous solubility" .

d:EXP-1 a ls:Experiment ;
  ls:identifier "EXP-1" ;
  ls:tests d:C-101 ;
  ls:produces d:AR-1, d:AR-2 ;
  ls:experimentRecord lst:ExperimentRecord-complete ;
  ls:experimentSignOff lst:ExperimentSignOff-signed ;
  ls:aim "Kinase selectivity panel" .

d:EXP-2 a ls:Experiment ;
  ls:identifier "EXP-2" ;
  ls:tests d:C-102 ;
  ls:produces d:AR-3 ;
  ls:experimentRecord lst:ExperimentRecord-complete ;
  ls:experimentSignOff lst:ExperimentSignOff-unsigned ;
  ls:aim "Thermodynamic solubility study" .

d:AR-1 a ls:AssayResult ;
  ls:identifier "AR-1" ;
  ls:assayResultValidity lst:AssayResultValidity-valid ;
  ls:resultValue "JAK1 IC50 4.2 nM" .

d:AR-2 a ls:AssayResult ;
  ls:identifier "AR-2" ;
  ls:assayResultValidity lst:AssayResultValidity-valid ;
  ls:resultValue "JAK1 over JAK2 selectivity 38-fold" .

d:AR-3 a ls:AssayResult ;
  ls:identifier "AR-3" ;
  ls:assayResultValidity lst:AssayResultValidity-valid ;
  ls:resultValue "Aqueous solubility 42 µg/mL at pH 6.8" .

d:F-101 a ls:Formulation ;
  ls:identifier "F-101" ;
  ls:contains d:C-101 ;
  ls:formulationStage lst:FormulationStage-underTest ;
  ls:formulationName "Velcorin 25 mg film-coated tablet" .

d:PR-1 a ls:Process ;
  ls:identifier "PR-1" ;
  ls:manufactures d:F-101 ;
  ls:processStatus lst:ProcessStatus-validated .

# 3 batches. B-002 starts J3: complete, pending quality, high deviation risk, with an open quality event.

d:B-001 a ls:Batch ;
  ls:identifier "B-001" ;
  ls:follows d:PR-1 ;
  ls:batchProduction lst:BatchProduction-complete ;
  ls:batchQuality lst:BatchQuality-released ;
  ls:batchDeviationRisk lst:BatchDeviationRisk-low ;
  ls:lotNumber "VL25-2409-01" .

d:B-002 a ls:Batch ;
  ls:identifier "B-002" ;
  ls:follows d:PR-1 ;
  ls:batchProduction lst:BatchProduction-complete ;
  ls:batchQuality lst:BatchQuality-pending ;
  ls:batchDeviationRisk lst:BatchDeviationRisk-high ;
  ls:lotNumber "VL25-2410-02" .

d:B-003 a ls:Batch ;
  ls:identifier "B-003" ;
  ls:follows d:PR-1 ;
  ls:batchProduction lst:BatchProduction-inProduction ;
  ls:batchQuality lst:BatchQuality-pending ;
  ls:batchDeviationRisk lst:BatchDeviationRisk-low ;
  ls:lotNumber "VL25-2411-03" .

# Clinical Development: 1 blinded Phase II study at 3 sites, 12 patients, 2 arms

d:ST-01 a ls:Study ;
  ls:identifier "ST-01" ;
  ls:tests d:F-101 ;
  ls:runsAt d:SITE-1, d:SITE-2, d:SITE-3 ;
  ls:studyPhase lst:StudyPhase-ii ;
  ls:studyStatus lst:StudyStatus-enrolling ;
  ls:studyBlinding lst:StudyBlinding-blinded ;
  ls:studyTitle "VELOCITY-2: Velcorin in moderate to severe rheumatoid arthritis" .

d:SITE-1 a ls:Site ;
  ls:identifier "SITE-1" ;
  ls:siteStatus lst:SiteStatus-activated ;
  ls:sitePayment lst:SitePayment-current ;
  ls:siteName "Northfield General Hospital" .

d:SITE-2 a ls:Site ;
  ls:identifier "SITE-2" ;
  ls:siteStatus lst:SiteStatus-activated ;
  ls:sitePayment lst:SitePayment-current ;
  ls:siteName "Lakeside Clinical Research Center" .

d:SITE-3 a ls:Site ;
  ls:identifier "SITE-3" ;
  ls:siteStatus lst:SiteStatus-activated ;
  ls:sitePayment lst:SitePayment-overdue ;
  ls:siteName "St. Brendan's University Hospital" .

d:PT-01 a ls:Patient ;
  ls:identifier "PT-01" ;
  ls:enrolledIn d:ST-01 ;
  ls:enrolledAt d:SITE-1 ;
  ls:patientArmVisibility lst:PatientArmVisibility-hidden ;
  ls:patientEnrollment lst:PatientEnrollment-randomized ;
  ls:patientArm lst:PatientArm-assigned ;
  ls:assignedArm "A" ;
  ls:receives d:B-002 .

