  ls:identifier "SUB-1" ;
  ls:reports d:SC-003 ;
  ls:submissionStatus lst:SubmissionStatus-draft ;
  ls:submissionDeadline lst:SubmissionDeadline-onTrack ;
  ls:preparedBy d:person-chloe ;
  ls:dueOn "2026-11-17"^^xsd:date .

