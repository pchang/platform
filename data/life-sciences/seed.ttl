  ls:identifier "MI-4" ;
  ls:medicalInquiryStatus lst:MedicalInquiryStatus-received .

# SC-005 reports the same event as SC-002, from a medical inquiry instead of the trial: the duplicate pair, not yet flagged.

d:SC-001 a ls:SafetyCase ;
