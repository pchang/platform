# J2 starts with the detected signal, for drug-induced liver injury.

d:SIG-1 a ls:Signal ;
  ls:identifier "SIG-1" ;
  ls:concerns d:P-101 ;
  ls:reaction lst:Reaction-drugInducedLiverInjury ;
  ls:aggregates d:SC-001, d:SC-003, d:SC-004 ;
  ls:signalStatus lst:SignalStatus-detected .

