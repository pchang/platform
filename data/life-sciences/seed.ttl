  ls:rationale "SIG-1 raises the question of how often liver tests are needed. The answer would shape the schedule of every study in the class, in and beyond this program." .

# VELOCITY-2 runs a study scenario of its own, testing its draft amendment before it goes for review.

d:SSC-4 a ls:StudyScenario ;
  ls:identifier "SSC-4" ;
  ls:studyScenarioStatus lst:StudyScenarioStatus-draft ;
  ls:scenarioName "VELOCITY-2 with the Week 16 safety visit" ;
  ls:scenarioChange "Tests protocol version 3.0, which adds a Week 16 safety visit, before it is sent for review." ;
  ls:explores d:ST-01 ;
  ls:usesProtocol d:PROT-3 .

# Vital signs for the Phase II study (domain spec section 11; platform spec 3.2, Measures and observations): its protocol
# in force plans three visits, each with a vital signs assessment that measures blood pressure. One SDTM VS dataset with
# one version, a Dataset-JSON file read through the adapter: twenty completed visits' blood pressures, one diastolic
# pressure not sent (PT-04, week 8) and one systolic pressure of 310 mmHg (PT-07, week 4).

d:PV-W4 a ls:PlannedVisit ;
  ls:identifier "PV-W4" ;
  ls:plannedVisitName "Week 4 visit" ;
  ls:studyDay 28 ;
  ls:windowDays 3 ;
  ls:specifiedIn d:PROT-2 .

d:PV-W8 a ls:PlannedVisit ;
  ls:identifier "PV-W8" ;
  ls:plannedVisitName "Week 8 visit" ;
  ls:studyDay 56 ;
  ls:windowDays 3 ;
  ls:specifiedIn d:PROT-2 .

d:PV-W12 a ls:PlannedVisit ;
  ls:identifier "PV-W12" ;
  ls:plannedVisitName "Week 12 visit" ;
  ls:studyDay 84 ;
  ls:windowDays 3 ;
  ls:specifiedIn d:PROT-2 .

d:AS-VS a ls:Assessment ;
  ls:identifier "AS-VS" ;
  ls:assessmentPurpose lst:AssessmentPurpose-safety ;
  ls:assessmentBurden lst:AssessmentBurden-low ;
  ls:assessmentName "Vital signs" ;
  ls:costPerVisit 25.0 ;
  ls:minutesOnSite 10 ;
  ls:performedAt d:PV-W4, d:PV-W8, d:PV-W12 ;
  ls:specifiedIn d:PROT-2 ;
  p:measures ls:BloodPressure .

d:DS-1 a p:Dataset ;
  ls:identifier "DS-1" ;
  p:datasetName "VELOCITY-2 vital signs" ;
  p:standard "SDTM VS" ;
  p:datasetFor d:ST-01 ;
  p:observedColumn "USUBJID" ;
  p:observedType ls:Patient ;
  p:occasionColumn "VISIT" ;
  p:occasionType ls:Visit ;
  p:occasionMatch ls:visitName .

d:DSV-1 a p:DatasetVersion ;
  ls:identifier "DSV-1" ;
  p:versionOf d:DS-1 ;
  p:location "datasets/vs-velocity-2-2026-11-20.json" ;
  p:format "Dataset-JSON 1.1" ;
  p:cutOn "2026-11-20"^^xsd:date ;
  p:datasetVersionStatus p:DatasetVersionStatus-loaded .

d:MB-1 a p:MeasureBinding ;
  p:bindsComponent ls:BloodPressure-systolic ;
  p:inDataset d:DS-1 ;
  p:whereColumn "VSTESTCD" ;
  p:whereValue "SYSBP" ;
  p:valueColumn "VSSTRESN" ;
  p:unitColumn "VSSTRESU" .

d:MB-2 a p:MeasureBinding ;
  p:bindsComponent ls:BloodPressure-diastolic ;
  p:inDataset d:DS-1 ;
  p:whereColumn "VSTESTCD" ;
  p:whereValue "DIABP" ;
  p:valueColumn "VSSTRESN" ;
  p:unitColumn "VSSTRESU" .
