  ls:allocationRatio 1 ;
  ls:specifiedIn d:PROT-31 .

d:INT-1 a ls:Intervention ;
  ls:identifier "INT-1" ;
  ls:interventionName "Velcorin 25 mg film-coated tablet" ;
  ls:regimen "25 mg by mouth once daily for 52 weeks" ;
  ls:givenIn d:ARM-1 ;
