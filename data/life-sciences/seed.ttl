# ---------------------------------------------------------------------------
# Design and Plan (domain spec section 3.4)
# Portfolio: an opportunity for a follow-on asset from discovery's analogs, with two development options;
# a parked indication opportunity; and a scientific question outside any program.
# Program: one for LSH-4471. Under it, the VELOCITY-3 study concept is explored in three study scenarios.
# VELOCITY-2 belongs to the program and runs one study scenario of its own, testing its draft amendment.
# ---------------------------------------------------------------------------

d:person-nadia a p:Person ;
  rdfs:label "Nadia Haddad" ;
  p:actsAs ls:ClinicalScientist .

d:person-tomas a p:Person ;
  rdfs:label "Tomás Lindqvist" ;
  p:actsAs ls:Biostatistician .

d:person-grace a p:Person ;
  rdfs:label "Grace Oyelaran" ;
  p:actsAs ls:MedicalWriter .

d:person-marcus a p:Person ;
  rdfs:label "Marcus Bell" ;
  p:actsAs ls:ClinicalOperationsLead .

# The Structure Steward (platform spec 3.7; domain spec section 11). No change sets: the structure starts as the files publish it.
d:person-noor a p:Person ;
  rdfs:label "Noor Rahman" ;
  p:actsAs p:StructureSteward .

d:person-ingrid a p:Person ;
  rdfs:label "Ingrid Solberg" ;
  p:actsAs ls:PortfolioStrategist .

d:person-kwame a p:Person ;
  rdfs:label "Kwame Asante" ;
  p:actsAs ls:ProgramLeader .

d:PRG-1 a ls:Program ;
  ls:identifier "PRG-1" ;
  ls:programStatus lst:ProgramStatus-active ;
  ls:programName "Velcorin in immune-mediated inflammatory disease" ;
  ls:develops d:C-101 ;
  ls:aimsAt d:TPP-1 .

d:TPP-1 a ls:TargetProductProfile ;
  ls:identifier "TPP-1" ;
  ls:targetProductProfileStatus lst:TargetProductProfileStatus-endorsed ;
  ls:tppIndication "moderate to severe rheumatoid arthritis" ;
  ls:targetClaim "ACR20 response at Week 24 at least 20 points above placebo on background methotrexate, once-daily oral dosing, no routine liver monitoring after Week 12" ;
  ls:minimumClaim "ACR20 response at Week 24 at least 12 points above placebo, with a liver safety profile no worse than approved JAK inhibitors" .

d:ST-01 ls:belongsTo d:PRG-1 .

# The VELOCITY-3 study concept, proposed for the program and being explored.

d:STC-1 a ls:StudyConcept ;
  ls:identifier "STC-1" ;
  ls:studyConceptStatus lst:StudyConceptStatus-draft ;
  ls:studyConceptName "VELOCITY-3: Phase III of Velcorin in moderate to severe rheumatoid arthritis" ;
  ls:conceptRationale "VELOCITY-2 shows a dose response at 25 mg. A confirmatory study on background methotrexate is the next step to the target product profile." ;
  ls:proposedFor d:PRG-1 .

d:OT-1 a ls:OutcomeTarget ;
  ls:identifier "OT-1" ;
  ls:outcomeTargetStatus lst:OutcomeTargetStatus-agreed ;
  ls:targetMeasure lst:OutcomeMeasure-lastPatientIn ;
  ls:targetComparison "at most" ;
  ls:targetThreshold 18.0 ;
  ls:targetUnit "months" ;
  ls:targetFor d:STC-1 .

d:OT-2 a ls:OutcomeTarget ;
  ls:identifier "OT-2" ;
  ls:outcomeTargetStatus lst:OutcomeTargetStatus-agreed ;
  ls:targetMeasure lst:OutcomeMeasure-probabilityOfSuccess ;
  ls:targetComparison "at least" ;
  ls:targetThreshold 60.0 ;
  ls:targetUnit "percent" ;
  ls:targetFor d:STC-1 .

d:OT-3 a ls:OutcomeTarget ;
  ls:identifier "OT-3" ;
  ls:outcomeTargetStatus lst:OutcomeTargetStatus-proposed ;
  ls:targetMeasure lst:OutcomeMeasure-totalCost ;
  ls:targetComparison "at most" ;
  ls:targetThreshold 45.0 ;
  ls:targetUnit "million USD" ;
  ls:targetFor d:STC-1 .

d:SSC-1 a ls:StudyScenario ;
  ls:identifier "SSC-1" ;
  ls:studyScenarioStatus lst:StudyScenarioStatus-draft ;
  ls:scenarioName "VELOCITY-3 baseline: 640 patients, 9 countries" ;
  ls:explores d:STC-1 ;
  ls:usesProtocol d:PROT-31 ;
  ls:usesBudget d:SB-1 ;
  ls:usesSiteSelection d:SS-1 .

d:SSC-2 a ls:StudyScenario ;
  ls:identifier "SSC-2" ;
  ls:studyScenarioStatus lst:StudyScenarioStatus-draft ;
  ls:scenarioName "VELOCITY-3 with prior biologic use allowed" ;
  ls:scenarioChange "Copied from SSC-1. Allows patients who failed one prior biologic, instead of excluding them." ;
  ls:explores d:STC-1 ;
  ls:usesProtocol d:PROT-32 ;
  ls:usesBudget d:SB-2 ;
  ls:usesSiteSelection d:SS-2 .

d:SSC-3 a ls:StudyScenario ;
  ls:identifier "SSC-3" ;
  ls:studyScenarioStatus lst:StudyScenarioStatus-draft ;
  ls:scenarioName "VELOCITY-3 without hand MRI, broader country mix" ;
  ls:scenarioChange "Copied from SSC-1. Drops hand MRI at Weeks 12 and 24, and adds sites in Poland and Brazil." ;
  ls:explores d:STC-1 ;
  ls:usesProtocol d:PROT-33 ;
  ls:usesBudget d:SB-3 ;
  ls:usesSiteSelection d:SS-3 .

# The baseline protocol, structured. The two variant protocols record only what they change from it;
# their structured content is copied once Copy study scenario is built (domain spec section 12).

d:PROT-31 a ls:Protocol ;
  ls:identifier "PROT-31" ;
  ls:protocolStatus lst:ProtocolStatus-draft ;
  ls:protocolName "VELOCITY-3 protocol" ;
  ls:protocolVersion "0.1" ;
  ls:primaryObjective "Show that Velcorin 25 mg once daily improves ACR20 response at Week 24 compared with placebo, both on background methotrexate" ;
  ls:plannedEnrollment 640 .

d:PROT-32 a ls:Protocol ;
  ls:identifier "PROT-32" ;
  ls:protocolStatus lst:ProtocolStatus-draft ;
  ls:protocolName "VELOCITY-3 protocol, prior biologic variant" ;
  ls:protocolVersion "0.1" ;
  ls:primaryObjective "Show that Velcorin 25 mg once daily improves ACR20 response at Week 24 compared with placebo, both on background methotrexate" ;
  ls:plannedEnrollment 700 .

d:PROT-33 a ls:Protocol ;
  ls:identifier "PROT-33" ;
  ls:protocolStatus lst:ProtocolStatus-draft ;
  ls:protocolName "VELOCITY-3 protocol, reduced imaging variant" ;
  ls:protocolVersion "0.1" ;
  ls:primaryObjective "Show that Velcorin 25 mg once daily improves ACR20 response at Week 24 compared with placebo, both on background methotrexate" ;
  ls:plannedEnrollment 640 .

d:POP-1 a ls:Population ;
  ls:identifier "POP-1" ;
  ls:populationText "Adults with moderate to severe rheumatoid arthritis and an inadequate response to methotrexate" ;
  ls:specifiedIn d:PROT-31 .

d:EC-1 a ls:EligibilityCriterion ;
  ls:identifier "EC-1" ;
  ls:eligibilityCriterionKind lst:EligibilityCriterionKind-inclusion ;
  ls:eligibilityCriterionTestability lst:EligibilityCriterionTestability-testable ;
  ls:criterionText "Aged 18 or over, with rheumatoid arthritis by the 2010 ACR/EULAR criteria for at least 6 months" ;
  ls:testedBy "Date of birth; diagnosis date and classification score from the medical history" ;
  ls:defines d:POP-1 .

d:EC-2 a ls:EligibilityCriterion ;
  ls:identifier "EC-2" ;
  ls:eligibilityCriterionKind lst:EligibilityCriterionKind-inclusion ;
  ls:eligibilityCriterionTestability lst:EligibilityCriterionTestability-testable ;
  ls:criterionText "At least 6 swollen and 6 tender joints at screening and baseline" ;
  ls:testedBy "Joint count at the screening and baseline visits" ;
  ls:defines d:POP-1 .

d:EC-3 a ls:EligibilityCriterion ;
  ls:identifier "EC-3" ;
  ls:eligibilityCriterionKind lst:EligibilityCriterionKind-inclusion ;
  ls:eligibilityCriterionTestability lst:EligibilityCriterionTestability-testable ;
  ls:criterionText "Inadequate response to methotrexate at a stable dose of 15 to 25 mg weekly for at least 12 weeks" ;
  ls:testedBy "Methotrexate dose history from the concomitant medication record" ;
  ls:defines d:POP-1 .

d:EC-4 a ls:EligibilityCriterion ;
  ls:identifier "EC-4" ;
  ls:eligibilityCriterionKind lst:EligibilityCriterionKind-exclusion ;
  ls:eligibilityCriterionTestability lst:EligibilityCriterionTestability-testable ;
  ls:criterionText "Any prior biologic disease-modifying treatment" ;
  ls:testedBy "Prior medication history" ;
  ls:defines d:POP-1 .

d:EC-5 a ls:EligibilityCriterion ;
  ls:identifier "EC-5" ;
  ls:eligibilityCriterionKind lst:EligibilityCriterionKind-exclusion ;
  ls:eligibilityCriterionTestability lst:EligibilityCriterionTestability-testable ;
  ls:criterionText "Any prior JAK inhibitor" ;
  ls:testedBy "Prior medication history" ;
  ls:defines d:POP-1 .

d:EC-6 a ls:EligibilityCriterion ;
  ls:identifier "EC-6" ;
  ls:eligibilityCriterionKind lst:EligibilityCriterionKind-exclusion ;
  ls:eligibilityCriterionTestability lst:EligibilityCriterionTestability-testable ;
  ls:criterionText "ALT or AST above 1.5 times the upper limit of normal at screening" ;
  ls:testedBy "Liver function tests at the screening visit" ;
  ls:defines d:POP-1 ;
  ls:justifiedBy d:SC-001, d:SC-003 .

d:EC-7 a ls:EligibilityCriterion ;
  ls:identifier "EC-7" ;
  ls:eligibilityCriterionKind lst:EligibilityCriterionKind-exclusion ;
  ls:eligibilityCriterionTestability lst:EligibilityCriterionTestability-needsData ;
  ls:criterionText "Clinically significant cardiovascular disease" ;
  ls:defines d:POP-1 .

d:OBJ-1 a ls:Objective ;
  ls:identifier "OBJ-1" ;
  ls:objectiveLevel lst:ObjectiveLevel-primary ;
  ls:objectiveText "Compare ACR20 response at Week 24 between Velcorin 25 mg and placebo, both on background methotrexate" ;
  ls:specifiedIn d:PROT-31 .

d:OBJ-2 a ls:Objective ;
  ls:identifier "OBJ-2" ;
  ls:objectiveLevel lst:ObjectiveLevel-secondary ;
  ls:objectiveText "Compare disease activity and physical function at Week 24" ;
  ls:specifiedIn d:PROT-31 .

d:OBJ-3 a ls:Objective ;
  ls:identifier "OBJ-3" ;
  ls:objectiveLevel lst:ObjectiveLevel-secondary ;
  ls:objectiveText "Describe safety and tolerability over 52 weeks" ;
  ls:specifiedIn d:PROT-31 .

d:EST-1 a ls:Estimand ;
  ls:identifier "EST-1" ;
  ls:estimandCompleteness lst:EstimandCompleteness-complete ;
  ls:estimandTreatment "Velcorin 25 mg once daily with methotrexate, against placebo with methotrexate" ;
  ls:estimandPopulation "Randomized patients meeting the eligibility criteria" ;
  ls:estimandVariable "ACR20 response at Week 24" ;
  ls:intercurrentEvents "Rescue therapy or stopping study treatment before Week 24: counted as non-response (composite strategy)" ;
  ls:populationSummary "Difference in the proportion of responders" ;
  ls:estimandOf d:OBJ-1 .

d:EP-1 a ls:Endpoint ;
  ls:identifier "EP-1" ;
  ls:endpointType lst:EndpointType-efficacy ;
  ls:endpointText "ACR20 response at Week 24" ;
  ls:measures d:OBJ-1 ;
  ls:requires d:AS-1, d:AS-2, d:AS-3 .

d:EP-2 a ls:Endpoint ;
  ls:identifier "EP-2" ;
  ls:endpointType lst:EndpointType-efficacy ;
  ls:endpointText "Change from baseline in DAS28-CRP at Week 24" ;
  ls:measures d:OBJ-2 ;
  ls:requires d:AS-1, d:AS-2 .

d:EP-3 a ls:Endpoint ;
  ls:identifier "EP-3" ;
  ls:endpointType lst:EndpointType-patientReported ;
  ls:endpointText "Change from baseline in HAQ-DI at Week 24" ;
  ls:measures d:OBJ-2 ;
  ls:requires d:AS-3 .

d:EP-4 a ls:Endpoint ;
  ls:identifier "EP-4" ;
  ls:endpointType lst:EndpointType-safety ;
  ls:endpointText "Incidence of treatment-emergent adverse events through Week 52" ;
  ls:measures d:OBJ-3 ;
  ls:requires d:AS-4 .

d:ARM-1 a ls:Arm ;
  ls:identifier "ARM-1" ;
  ls:armRole lst:ArmRole-experimental ;
  ls:armName "Velcorin 25 mg with methotrexate" ;
  ls:allocationRatio 1 ;
  ls:specifiedIn d:PROT-31 .

d:ARM-2 a ls:Arm ;
  ls:identifier "ARM-2" ;
  ls:armRole lst:ArmRole-placeboControl ;
