# Portfolio opportunities.
d:OPP-1 a ls:Opportunity ;
  ls:identifier "OPP-1" ;
  ls:opportunityStatus lst:OpportunityStatus-exploring ;
  ls:opportunityKind lst:OpportunityKind-newAsset ;
  ls:opportunityName "A follow-on JAK1 inhibitor with lower liver risk" ;
  ls:rationale "SIG-1 suggests a liver risk with Velcorin. Two analogs designed from LSH-4471 aim to keep its potency with less liver exposure. Is a follow-on asset worth funding?" ;
  ls:evaluates d:C-104, d:C-105 ;
  ls:aimsAt d:TPP-2 .

d:TPP-2 a ls:TargetProductProfile ;
  ls:identifier "TPP-2" ;
  ls:targetProductProfileStatus lst:TargetProductProfileStatus-draft ;
  ls:tppIndication "moderate to severe rheumatoid arthritis, without routine liver monitoring" ;
  ls:targetClaim "ACR20 response at Week 24 matching Velcorin, with no more liver enzyme elevations than placebo" ;
  ls:minimumClaim "ACR20 response at Week 24 at least 12 points above placebo, with half Velcorin's rate of liver enzyme elevations" .

d:OT-4 a ls:OutcomeTarget ;
  ls:identifier "OT-4" ;
  ls:outcomeTargetStatus lst:OutcomeTargetStatus-agreed ;
  ls:targetMeasure lst:OutcomeMeasure-probabilityOfTechnicalAndRegulatorySuccess ;
  ls:targetComparison "at least" ;
  ls:targetThreshold 12.0 ;
  ls:targetUnit "percent" ;
  ls:targetFor d:OPP-1 .

d:OPT-1 a ls:DevelopmentOption ;
  ls:identifier "OPT-1" ;
  ls:developmentOptionStatus lst:DevelopmentOptionStatus-draft ;
  ls:optionName "Develop the lead analog in rheumatoid arthritis" ;
  ls:optionSummary "First-in-human study of the lead analog, then a Phase II dose-ranging study against Velcorin, then Phase III if liver safety holds." ;
  ls:optionFor d:OPP-1 ;
  ls:plans d:STC-2 .

d:OPT-2 a ls:DevelopmentOption ;
  ls:identifier "OPT-2" ;
  ls:developmentOptionStatus lst:DevelopmentOptionStatus-draft ;
  ls:optionName "No follow-on: manage Velcorin's liver risk with monitoring" ;
  ls:optionSummary "Keep the analogs in discovery and add liver monitoring to Velcorin's studies and label." ;
  ls:optionFor d:OPP-1 .

d:STC-2 a ls:StudyConcept ;
  ls:identifier "STC-2" ;
  ls:studyConceptStatus lst:StudyConceptStatus-draft ;
  ls:studyConceptName "First-in-human study of the lead analog in healthy participants" ;
  ls:conceptRationale "Single and multiple ascending doses to find a safe, tolerated dose and the analog's pharmacokinetics before patients." ;
  ls:proposedFor d:OPP-1 .

d:TS-4 a ls:TrialSimulation ;
  ls:identifier "TS-4" ;
  ls:trialSimulationRun lst:TrialSimulationRun-complete ;
  ls:simulates d:OPT-1 ;
  ls:scenarioAsOf "2026-11-18"^^xsd:date ;
  ls:simulatedTrials 10000 ;
  ls:assumedEffect "Efficacy as Velcorin, from matched JAK1 potency (AR-1); phase transition rates from historical immunology programs" .

