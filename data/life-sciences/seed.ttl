# 30 visits: 2 completed per randomized patient, and a third scheduled around 2026-11-12, some overdue.
# 40 data records from the completed visits: 14 entered and awaiting source data verification, the rest verified.
# Queries: 3 open (the site answers), 3 answered (data management closes or re-queries), 2 closed.

d:V-01-1 a ls:Visit ;
  ls:identifier "V-01-1" ;
  ls:visitFor d:PT-01 ;
  ls:visitStatus lst:VisitStatus-completed ;
  ls:scheduledOn "2026-09-08"^^xsd:date ;
  ls:visitName "Week 4 visit" .

