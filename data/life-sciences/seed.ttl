# Safety and Regulatory: 1 investigational product, 4 medical inquiries, 6 safety cases, each coded with its reactions

d:P-101 a ls:Product ;
  ls:identifier "P-101" ;
  ls:isFormulation d:F-101 ;
  ls:productStatus lst:ProductStatus-investigational ;
  ls:productName "Velcorin 25 mg tablets" .

d:MI-1 a ls:MedicalInquiry ;
  ls:identifier "MI-1" ;
  ls:medicalInquiryStatus lst:MedicalInquiryStatus-answered ;
  ls:inquiryText "Patient on Velcorin reports yellowing of the eyes; is this a known effect?" .

d:MI-2 a ls:MedicalInquiry ;
  ls:identifier "MI-2" ;
  ls:medicalInquiryStatus lst:MedicalInquiryStatus-answered ;
  ls:inquiryText "Liver enzymes doubled after starting Velcorin; should dosing continue?" .

d:MI-3 a ls:MedicalInquiry ;
  ls:identifier "MI-3" ;
  ls:medicalInquiryStatus lst:MedicalInquiryStatus-received ;
  ls:inquiryText "Rash and nausea in the first week of Velcorin: report or wait?" .

d:MI-4 a ls:MedicalInquiry ;
  ls:identifier "MI-4" ;
  ls:medicalInquiryStatus lst:MedicalInquiryStatus-received ;
  ls:inquiryText "Widespread rash with headache after the second Velcorin dose" .

# SC-005 reports the same event as SC-002, from a medical inquiry instead of the trial: the duplicate pair, not yet flagged.

